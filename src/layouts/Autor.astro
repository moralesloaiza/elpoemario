---
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';

import Base from './Base.astro';
import JsonLd from '../components/JsonLd.astro';
import IconoEditar from '../components/IconoEditar.astro';
import HeroInmersivo from '../components/HeroInmersivo.astro';
import PoemaCard from '../components/PoemaCard.astro';

import { buildAutorJsonLd, buildBreadcrumbJsonLd } from '../utils/jsonld';
import { paisASlug } from '../utils/taxonomia';

// Receives the author's frontmatter spread plus its id (slug). Same
// pattern as Poema.astro.
type Props = CollectionEntry<'autores'>['data'] & { id: string };

const props = Astro.props;
const {
  id,
  nombre,
  nacionalidad,
  nacimiento,
  muerte,
  lugar_nacimiento,
  imagen,
  tambien_en,
  lengua_original,
} = props;

// Immersive hero only when the author carries a portrait. Every author
// currently does, so the no-portrait branch is a robustness guard: it falls
// back to a plain (non-hero) header, mirroring Poema.astro's `!!ilustracion`.
const conHero = !!imagen;

// Life dates:
//   both years  → "1836–1870" (en dash range)
//   birth only  → "n. 1985"   (living author: director, collaborators)
//   neither     → suppressed  (e.g. Anónimo)
const anios =
  nacimiento && muerte
    ? `${nacimiento}–${muerte}`
    : nacimiento
      ? `n. ${nacimiento}`
      : null;

// Country link target. Authors carrying `lengua_original` live on
// /nacionalidades/otras-lenguas/, not on a per-country page; everyone else
// links to their country's slug. Null when no nacionalidad (e.g. Anonimo).
const nacionalidadHref = nacionalidad
  ? lengua_original
    ? '/nacionalidades/otras-lenguas/'
    : `/nacionalidades/${paisASlug(nacionalidad)}/`
  : null;

// Sibling-portal cross-link. Mapping is local: only two valid values.
// Falls back to the literal hostname if a typo lands in the CMS, so the
// link still resolves to *something* rather than rendering `undefined`.
const PORTAL_LABEL: Record<string, string> = {
  'elfabulario.com': 'El Fabulario',
  'elpoemario.com': 'El Poemario',
};
const tambienEnLabel = tambien_en ? (PORTAL_LABEL[tambien_en] ?? tambien_en) : null;
const tambienEnUrl = tambien_en ? `https://${tambien_en}/autores/${id}/` : null;

// JSON-LD: Person + Breadcrumb.
const site = Astro.site!;
const personLd = buildAutorJsonLd(props as Props, site);
const breadcrumbLd = buildBreadcrumbJsonLd(
  [
    { name: 'Inicio', path: '/' },
    { name: 'Autores', path: '/autores/' },
    { name: nombre, path: `/autores/${id}/` },
  ],
  site,
);

// Poems by this author, non-draft, newest first. Rendered as illustrated
// PoemaCards in a grid (handoff «diseño nocturno»); the author line is omitted
// (redundant on the author's own page). First 12 shown, rest via «cargar más».
const PASO = 12;
const todosLosPoemas = await getCollection('poemas', ({ data }) => !data.borrador);
const poemasDelAutor = todosLosPoemas
  .filter((p) => p.data.autor.id === id)
  .sort((a, b) => b.data.fecha.getTime() - a.data.fecha.getTime());

const headingPoemas =
  poemasDelAutor.length === 0
    ? 'Aún no hay poemas de este autor'
    : poemasDelAutor.length === 1
      ? '1 poema en El Poemario'
      : `${poemasDelAutor.length} poemas en El Poemario`;

const descripcionMeta = `Poemas de ${nombre}, en El Poemario.`;
---

<Base titulo={`${nombre} · El Poemario`} descripcion={descripcionMeta} heroInmersivo={conHero}>
  <JsonLd slot="head" data={personLd} />
  <JsonLd slot="head" data={breadcrumbLd} />

  {conHero && imagen && (
    <HeroInmersivo slot="hero" imagen={imagen} alt={`Retrato de ${nombre}`} align="left" objectPosition="center 25%" maxAncho="54rem">
      {lugar_nacimiento && <p class="autor-hero-lugar">{lugar_nacimiento}</p>}
      <h1 class="autor-hero-nombre">{nombre}</h1>
      {(anios || nacionalidad) && (
        <p class="autor-hero-meta">
          {anios}
          {anios && nacionalidad && ' · '}
          {nacionalidad && (
            nacionalidadHref ? (
              <a href={nacionalidadHref}>{nacionalidad}</a>
            ) : (
              nacionalidad
            )
          )}
        </p>
      )}
    </HeroInmersivo>
  )}

  <article class:list={['autor', { 'autor--con-hero': conHero }]} lang="es">
    <p class="autor-backlink">
      <a href="/autores/">← Autores</a>
    </p>

    {!conHero && (
      <header class="autor-cabecera">
        <h1 class="autor-nombre">{nombre}</h1>
        {(anios || nacionalidad) && (
          <p class="autor-meta">
            {anios}
            {anios && nacionalidad && ' · '}
            {nacionalidad && (
              nacionalidadHref ? (
                <a href={nacionalidadHref}>{nacionalidad}</a>
              ) : (
                nacionalidad
              )
            )}
          </p>
        )}
      </header>
    )}

    <div class="autor-bio prose">
      <slot />

      {tambienEnLabel && tambienEnUrl && (
        <p class="autor-tambien-en">
          También figura en <a href={tambienEnUrl}>{tambienEnLabel}</a>.
        </p>
      )}
    </div>

    <section class="autor-poemas" aria-labelledby="lista-titulo">
      <h2 id="lista-titulo">{headingPoemas}</h2>

      {poemasDelAutor.length > 0 && (
        <ul class="obras-grid">
          {poemasDelAutor.map((p, i) => (
            <li class="obra-item">
              <PoemaCard poema={p} oculto={i >= PASO} />
            </li>
          ))}
        </ul>
      )}

      {poemasDelAutor.length > PASO && (
        <button type="button" class="cargar-mas" data-cargar-mas>
          Mostrar más poemas
        </button>
      )}
    </section>
  </article>

  <IconoEditar slug={id} coleccion="autores" />
</Base>

<script>
  const PASO = 12;
  const boton = document.querySelector<HTMLButtonElement>('[data-cargar-mas]');
  const lista = document.querySelector<HTMLUListElement>('.autor-poemas .obras-grid');

  if (boton && lista) {
    const items = Array.from(lista.children) as HTMLElement[];

    boton.addEventListener('click', () => {
      // Each <li> wraps a PoemaCard whose article carries `hidden`; toggle it.
      const ocultos = items.filter((el) =>
        el.querySelector('[hidden]'),
      );
      const lote = ocultos.slice(0, PASO);

      lote.forEach((el) => {
        const card = el.querySelector('[hidden]');
        card?.removeAttribute('hidden');
      });

      // Move focus to the first revealed card's title link.
      const primera = lote[0]?.querySelector<HTMLElement>('.pcard-titulo a');
      if (primera) {
        primera.setAttribute('tabindex', '-1');
        primera.focus();
      }

      if (ocultos.length <= PASO) {
        boton.setAttribute('hidden', '');
      }
    });
  }
</script>

<style>
  .autor {
    max-width: var(--measure-wide);
    margin: 0 auto;
    padding-inline: var(--space-md);
    padding-block: var(--space-2xl);
  }
  /* Tras el hero inmersivo el cuerpo arranca pegado a la imagen. */
  .autor--con-hero {
    padding-block-start: var(--space-2xl);
  }

  /* ── Contenido del hero (retrato a sangre) ────────────────────────────
     Colores vía --hero-* (siguen al tema). El nombre va en Cinzel versalita
     —voz de nombre de autor del sitio (§25)—, no en el .hero-titulo Cormorant
     que usan los títulos de poema/entrada. */
  .autor-hero-lugar {
    font-family: var(--font-body);
    font-style: italic;
    font-size: var(--fs-lg);
    color: var(--hero-ink-soft);
    margin: 0 0 var(--space-sm);
  }
  .autor-hero-nombre {
    font-family: var(--font-display);
    font-weight: var(--fw-semibold);
    font-size: var(--fs-4xl);
    line-height: 1.02;
    letter-spacing: var(--ls-wide);
    text-transform: uppercase;
    color: var(--hero-title);
    text-shadow: 0 2px 24px rgba(0, 0, 0, 0.5);
    margin: 0;
    text-wrap: balance;
  }
  .autor-hero-meta {
    font-family: var(--font-display);
    font-size: var(--fs-sm);
    letter-spacing: var(--ls-widest);
    text-transform: uppercase;
    color: var(--hero-accent);
    margin: var(--space-md) 0 0;
  }
  .autor-hero-meta a {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color var(--dur-fast) var(--ease-standard);
  }
  .autor-hero-meta a:hover,
  .autor-hero-meta a:focus-visible {
    border-bottom-color: var(--hero-rule);
  }

  /* ── Back-link «← Autores» (bajo el hero, colores normales) ───────────── */
  .autor-backlink {
    margin: 0 0 var(--space-lg);
  }
  .autor-backlink a {
    font-family: var(--font-meta);
    font-size: var(--fs-3xs);
    letter-spacing: var(--ls-wider);
    text-transform: uppercase;
    color: var(--oro-texto);
    text-decoration: none;
    border-bottom: none;
    transition: color var(--dur-fast) var(--ease-standard);
  }
  .autor-backlink a:hover,
  .autor-backlink a:focus-visible {
    color: var(--oro);
  }

  /* ── Cabecera de respaldo (autor sin retrato, sin hero) ───────────────── */
  .autor-cabecera {
    margin-bottom: var(--space-xl);
  }
  .autor-nombre {
    font-family: var(--font-display);
    font-weight: var(--fw-semibold);
    font-size: var(--fs-3xl);
    line-height: 1.1;
    margin: 0 0 var(--space-xs);
    color: var(--text);
    letter-spacing: var(--ls-wider);
    text-transform: uppercase;
    text-wrap: balance;
  }
  .autor-meta {
    font-family: var(--font-meta);
    font-size: var(--fs-xs);
    letter-spacing: var(--ls-widest);
    text-transform: uppercase;
    color: var(--oro-texto);
    margin: 0;
  }
  .autor-meta a {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color var(--dur-fast) var(--ease-standard);
  }
  .autor-meta a:hover,
  .autor-meta a:focus-visible {
    border-bottom-color: var(--oro);
  }

  /* ── Biografía (medida de lectura) ────────────────────────────────────── */
  .autor-bio {
    max-width: var(--measure);
    font-family: var(--font-body);
    font-size: var(--fs-prosa);
    line-height: var(--lh-prosa);
    color: var(--text);
  }
  .autor-bio :global(p) {
    font-family: var(--font-prose);
    margin: 0 0 var(--space-lg);
  }
  .autor-bio :global(p:last-child) {
    margin-bottom: 0;
  }
  .autor-bio :global(em) {
    font-style: italic;
  }
  .autor-bio :global(strong) {
    font-weight: var(--fw-bold);
  }
  .autor-bio :global(a) {
    color: var(--link);
  }

  .autor-tambien-en {
    margin: var(--space-lg) 0 0;
    font-family: var(--font-body);
    font-style: italic;
    font-size: var(--fs-base);
    color: var(--text-soft);
  }

  /* ── Obras en El Poemario (rejilla de tarjetas ilustradas) ────────────── */
  .autor-poemas {
    margin-top: var(--space-2xl);
    padding-top: var(--space-xl);
    border-top: 1px solid var(--rule);
  }
  .autor-poemas h2 {
    font-family: var(--font-display);
    font-weight: var(--fw-semibold);
    font-size: var(--fs-xl);
    letter-spacing: var(--ls-wide);
    color: var(--text);
    margin: 0 0 var(--space-lg);
  }
  .obras-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(248px, 1fr));
    gap: clamp(var(--space-md), 1.8vw, var(--space-lg));
  }
  .obra-item {
    margin: 0;
    display: grid;
  }

  /* Oculta la tarjeta escondida y el <li> que la envuelve queda sin altura. */
  .obra-item:has(> [hidden]) {
    display: none;
  }

  .cargar-mas {
    display: block;
    margin: var(--space-xl) auto 0;
    padding: var(--space-2xs) var(--space-md);
    font-family: var(--font-display);
    font-size: var(--fs-3xs);
    letter-spacing: var(--ls-wide);
    text-transform: uppercase;
    color: var(--oro-texto);
    background: transparent;
    border: var(--rule-hairline) solid var(--oro);
    cursor: pointer;
    transition:
      background-color var(--dur-fast) var(--ease-standard),
      color var(--dur-fast) var(--ease-standard);
  }
  .cargar-mas:hover,
  .cargar-mas:focus-visible {
    background-color: var(--bg-elevated);
    color: var(--oro);
  }
  .cargar-mas:focus-visible {
    outline: 2px solid var(--oro);
    outline-offset: 2px;
  }
  .cargar-mas[hidden] {
    display: none;
  }

  /* ── Móvil ────────────────────────────────────────────────────────────── */
  /* Dos columnas fijas (handoff móvil): a ~280px de ancho, minmax(150px) caía a
     1 sola col; el mockup mantiene 2-up para que la lámina siga siendo la voz. */
  @media (max-width: 640px) {
    .obras-grid {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-sm);
    }
  }
</style>
