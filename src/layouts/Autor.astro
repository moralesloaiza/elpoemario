---
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

import Base from './Base.astro';
import JsonLd from '../components/JsonLd.astro';
import IconoEditar from '../components/IconoEditar.astro';
import PoemaCard from '../components/PoemaCard.astro';
import OrnamentoTarjeta from '../components/ornaments/OrnamentoTarjeta.astro';

import { buildAutorJsonLd, buildBreadcrumbJsonLd } from '../utils/jsonld';
import { paisASlug } from '../utils/taxonomia';

// Receives the author's frontmatter spread plus its id (slug). Same
// pattern as Poema.astro.
type Props = CollectionEntry<'autores'>['data'] & { id: string };

const props = Astro.props;
const {
  id,
  nombre,
  nacionalidad,
  nacimiento,
  muerte,
  imagen,
  tambien_en,
  lengua_original,
} = props;

// Life dates:
//   both years  → "1836–1870" (en dash range)
//   birth only  → "n. 1985"   (living author: director, collaborators)
//   neither     → suppressed  (e.g. Anónimo)
// No longer gated on `tipo === 'clasico'`: a living director with only a
// birth year now shows "n. 1985" instead of nothing.
const anios =
  nacimiento && muerte
    ? `${nacimiento} – ${muerte}`
    : nacimiento
      ? `n. ${nacimiento}`
      : null;

// Country eyebrow link target. Authors carrying `lengua_original` live on
// /nacionalidades/otras-lenguas/, not on a per-country page; everyone else
// links to their country's slug. Null when no nacionalidad (e.g. Anonimo).
const nacionalidadHref = nacionalidad
  ? lengua_original
    ? '/nacionalidades/otras-lenguas/'
    : `/nacionalidades/${paisASlug(nacionalidad)}/`
  : null;

// Sibling-portal cross-link. Mapping is local: only two valid values.
// Falls back to the literal hostname if a typo lands in the CMS, so the
// link still resolves to *something* rather than rendering `undefined`.
const PORTAL_LABEL: Record<string, string> = {
  'elfabulario.com': 'El Fabulario',
  'elpoemario.com': 'El Poemario',
};
const tambienEnLabel = tambien_en ? (PORTAL_LABEL[tambien_en] ?? tambien_en) : null;
const tambienEnUrl = tambien_en ? `https://${tambien_en}/autores/${id}/` : null;

// JSON-LD: Person + Breadcrumb. Breadcrumb points to /autores/ which
// lands in PR 7; until then it 404s. Valid schema markup either way.
const site = Astro.site!;
const personLd = buildAutorJsonLd(props as Props, site);
const breadcrumbLd = buildBreadcrumbJsonLd(
  [
    { name: 'Inicio', path: '/' },
    { name: 'Autores', path: '/autores/' },
    { name: nombre, path: `/autores/${id}/` },
  ],
  site,
);

// Poems by this author, non-draft, newest first.
const todosLosPoemas = await getCollection('poemas', ({ data }) => !data.borrador);
const poemasDelAutor = todosLosPoemas
  .filter((p) => p.data.autor.id === id)
  .sort((a, b) => b.data.fecha.getTime() - a.data.fecha.getTime());

const headingPoemas =
  poemasDelAutor.length === 0
    ? 'Aún no hay poemas de este autor'
    : poemasDelAutor.length === 1
      ? '1 poema en El Poemario'
      : `${poemasDelAutor.length} poemas en El Poemario`;

const descripcionMeta = `Poemas de ${nombre}, en El Poemario.`;
---

<Base titulo={`${nombre} · El Poemario`} descripcion={descripcionMeta}>
  <JsonLd slot="head" data={personLd} />
  <JsonLd slot="head" data={breadcrumbLd} />

  <article class="autor" lang="es">
    <header class="autor-cabecera">
      {nacionalidad && (
        <p class="autor-nacionalidad">
          {nacionalidadHref ? (
            <a href={nacionalidadHref}>{nacionalidad}</a>
          ) : (
            nacionalidad
          )}
        </p>
      )}
      <h1 class="autor-nombre">{nombre}</h1>
      {anios && <p class="autor-anios">{anios}</p>}
    </header>

    {imagen ? (
      <figure class="autor-retrato">
        <Image
          src={imagen}
          alt={`Retrato de ${nombre}`}
          loading="lazy"
          decoding="async"
          width={900}
          height={600}
        />
      </figure>
    ) : (
      <figure class="autor-ornamento" aria-hidden="true">
        <OrnamentoTarjeta />
      </figure>
    )}

    <div class="autor-bio prose">
      <slot />
    </div>

    {tambienEnLabel && tambienEnUrl && (
      <p class="autor-tambien-en">
        También figura en <a href={tambienEnUrl}>{tambienEnLabel}</a>.
      </p>
    )}

    <div class="divisor" aria-hidden="true"><span></span><span></span><span></span></div>

    <section class="autor-poemas" aria-labelledby="lista-titulo">
      <h2 id="lista-titulo">{headingPoemas}</h2>

      {poemasDelAutor.length > 0 && (
        <ul class="lista">
          {poemasDelAutor.map((p, i) => (
            <li class="item" hidden={i >= 18}>
              <PoemaCard poema={p} autorNombre={nombre} mostrarAutor={false} />
            </li>
          ))}
        </ul>
      )}

      {poemasDelAutor.length > 18 && (
        <button type="button" class="cargar-mas" data-cargar-mas>
          Mostrar más poemas
        </button>
      )}
    </section>
  </article>

  <IconoEditar slug={id} coleccion="autores" />
</Base>

<script>
  const PASO = 18;
  const boton = document.querySelector<HTMLButtonElement>('[data-cargar-mas]');
  const lista = document.querySelector<HTMLUListElement>('.lista');

  if (boton && lista) {
    const items = Array.from(lista.children) as HTMLElement[];

    boton.addEventListener('click', () => {
      const ocultos = items.filter((el) => el.hasAttribute('hidden'));
      const lote = ocultos.slice(0, PASO);

      lote.forEach((el) => el.removeAttribute('hidden'));

      // Move focus to the first card of the just-revealed batch.
      const primera = lote[0]?.querySelector<HTMLElement>('.card');
      if (primera) {
        primera.setAttribute('tabindex', '-1');
        primera.focus();
      }

      // Hide the button once no hidden cards remain.
      if (ocultos.length <= PASO) {
        boton.setAttribute('hidden', '');
      }
    });
  }
</script>

<style>
  .autor {
    max-width: var(--measure);
    margin: 0 auto;
    padding-inline: var(--space-md);
    padding-block: var(--space-2xl);
  }

  /* ── Header ──────────────────────────────────────────────────────── */
  .autor-cabecera {
    text-align: center;
    margin-bottom: var(--space-xl);
  }
  /* Country eyebrow above the name. Same small-caps gold treatment as the
     card's .card-nacionalidad, scaled for the detail header. */
  .autor-nacionalidad {
    font-family: var(--font-display);
    font-size: var(--fs-xs);
    letter-spacing: var(--ls-widest);
    text-transform: uppercase;
    color: var(--oro-texto);
    line-height: var(--lh-snug);
    margin: 0 0 var(--space-2xs);
  }
  .autor-nacionalidad a {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color var(--dur-fast) var(--ease-standard);
  }
  .autor-nacionalidad a:hover,
  .autor-nacionalidad a:focus-visible {
    border-bottom-color: var(--oro);
  }
  .autor-nombre {
    font-family: var(--font-display);
    font-size: var(--fs-3xl);
    line-height: var(--lh-snug);
    margin: 0 0 var(--space-2xs);
    color: var(--text);
    letter-spacing: 0.04em;
    text-wrap: balance;
  }
  .autor-anios {
    font-family: var(--font-body);
    font-style: italic;
    font-size: var(--fs-md);
    color: var(--text-soft);
    margin: 0;
  }

  /* ── Portrait ────────────────────────────────────────────────────── */
  /* Deliberate divergence from the mockup (decision 12): the live portrait is
     kept. No frame on the image itself (decision 6: zero frames on any image). */
  .autor-retrato {
    margin: 0 auto var(--space-xl);
    max-width: var(--measure-narrow);
    padding: 0;
  }
  .autor-retrato img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }

  /* ── Ornament fallback (no portrait) ─────────────────────────────── */
  /* Reuses the orphaned OrnamentoTarjeta (decision 9/12). The double gold frame
     is the one closed exception to "zero frames" (decision A): this is a
     placeholder, not a framed image. The parent that used to draw it
     (.card-img.con-ornamento in PoemaCard) was removed in R1, so the frame is
     recreated here replicating the canonical .frame (1.5px oro + 6px inset
     hairline oro-suave). Sized to the 3:2 footprint the portrait would occupy. */
  .autor-ornamento {
    position: relative;
    margin: 0 auto var(--space-xl);
    max-width: var(--measure-narrow);
    aspect-ratio: 3 / 2;
    padding: var(--space-md);
    border: 1.5px solid var(--oro);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .autor-ornamento::before {
    content: '';
    position: absolute;
    inset: 6px;
    border: 1px solid var(--oro-suave);
    pointer-events: none;
  }
  .autor-ornamento :global(svg) {
    width: 60%;
    height: auto;
  }

  /* ── Bio ─────────────────────────────────────────────────────────── */
  .autor-bio {
    max-width: var(--measure-narrow);
    margin: 0 auto var(--space-xl);
    font-family: var(--font-body);
    font-size: var(--fs-prosa);
    line-height: var(--lh-prosa);
    color: var(--text);
  }
  .autor-bio :global(p) {
    margin: 0 0 var(--space-lg);
  }
  .autor-bio :global(em) {
    font-style: italic;
  }
  .autor-bio :global(strong) {
    font-weight: var(--fw-bold);
  }
  .autor-bio :global(a) {
    color: var(--link);
  }

  /* ── Cross-portal link ───────────────────────────────────────────── */
  .autor-tambien-en {
    max-width: var(--measure-narrow);
    margin: 0 auto var(--space-xl);
    font-family: var(--font-body);
    font-style: italic;
    font-size: var(--fs-base);
    color: var(--text-soft);
    text-align: center;
  }


  /* ── Poems section ───────────────────────────────────────────────── */
  .autor-poemas h2 {
    text-align: center;
    font-family: var(--font-display);
    font-size: var(--fs-md);
    letter-spacing: var(--ls-wide);
    color: var(--oro-texto);
    margin: var(--space-xl) 0 var(--space-lg);
  }
  /* Card grid: same R1 system as /poemas and taxonomy. Container draws the top
     and left rules; each PoemaCard draws its own right and bottom rule. Confined
     to the reading column (--measure-grid). 3-col, collapsing to 1 at 680px. */
  .lista {
    list-style: none;
    padding: 0;
    margin: 0 auto;
    max-width: var(--measure-grid);
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0;
    border-top: 1px solid var(--line);
    border-left: 1px solid var(--line);
  }
  /* Visible cells stretch to the track; hidden batches (cargar-mas) stay out. */
  .item:not([hidden]) {
    display: grid;
  }
  /* Hidden batches for cargar-mas: overrides the grid's implicit display. */
  [hidden] {
    display: none !important;
  }
  .cargar-mas {
    display: block;
    margin: var(--space-xl) auto 0;
    padding: var(--space-2xs) var(--space-md);
    font-family: var(--font-display);
    font-size: var(--fs-3xs);
    letter-spacing: var(--ls-wide);
    text-transform: uppercase;
    color: var(--oro-texto);
    background: transparent;
    border: var(--rule-hairline) solid var(--oro);
    cursor: pointer;
    transition:
      background-color var(--dur-fast) var(--ease-standard),
      color var(--dur-fast) var(--ease-standard);
  }
  .cargar-mas:hover,
  .cargar-mas:focus-visible {
    background-color: var(--bg-elevated);
    color: var(--oro);
  }
  .cargar-mas:focus-visible {
    outline: 2px solid var(--oro);
    outline-offset: 2px;
  }

  @media (max-width: 680px) {
    .lista {
      grid-template-columns: 1fr;
    }
  }
</style>
