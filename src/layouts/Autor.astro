---
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

import Base from './Base.astro';
import JsonLd from '../components/JsonLd.astro';
import IconoEditar from '../components/IconoEditar.astro';
import OrnamentoTarjeta from '../components/ornaments/OrnamentoTarjeta.astro';

import { buildAutorJsonLd, buildBreadcrumbJsonLd } from '../utils/jsonld';
import {
  paisASlug,
  TIPOS_DISPLAY,
  MOVIMIENTOS_DISPLAY,
} from '../utils/taxonomia';

// Receives the author's frontmatter spread plus its id (slug). Same
// pattern as Poema.astro.
type Props = CollectionEntry<'autores'>['data'] & { id: string };

const props = Astro.props;
const {
  id,
  nombre,
  nacionalidad,
  nacimiento,
  muerte,
  lugar_nacimiento,
  imagen,
  tambien_en,
  lengua_original,
} = props;

// Life dates:
//   both years  → "1836–1870" (en dash range)
//   birth only  → "n. 1985"   (living author: director, collaborators)
//   neither     → suppressed  (e.g. Anónimo)
const anios =
  nacimiento && muerte
    ? `${nacimiento}–${muerte}`
    : nacimiento
      ? `n. ${nacimiento}`
      : null;

// Country eyebrow link target. Authors carrying `lengua_original` live on
// /nacionalidades/otras-lenguas/, not on a per-country page; everyone else
// links to their country's slug. Null when no nacionalidad (e.g. Anonimo).
const nacionalidadHref = nacionalidad
  ? lengua_original
    ? '/nacionalidades/otras-lenguas/'
    : `/nacionalidades/${paisASlug(nacionalidad)}/`
  : null;

// Sibling-portal cross-link. Mapping is local: only two valid values.
// Falls back to the literal hostname if a typo lands in the CMS, so the
// link still resolves to *something* rather than rendering `undefined`.
const PORTAL_LABEL: Record<string, string> = {
  'elfabulario.com': 'El Fabulario',
  'elpoemario.com': 'El Poemario',
};
const tambienEnLabel = tambien_en ? (PORTAL_LABEL[tambien_en] ?? tambien_en) : null;
const tambienEnUrl = tambien_en ? `https://${tambien_en}/autores/${id}/` : null;

// JSON-LD: Person + Breadcrumb.
const site = Astro.site!;
const personLd = buildAutorJsonLd(props as Props, site);
const breadcrumbLd = buildBreadcrumbJsonLd(
  [
    { name: 'Inicio', path: '/' },
    { name: 'Autores', path: '/autores/' },
    { name: nombre, path: `/autores/${id}/` },
  ],
  site,
);

// Poems by this author, non-draft, newest first. Each row shows an optional
// illustration thumbnail plus a "forma · movimiento" tag (handoff).
const todosLosPoemas = await getCollection('poemas', ({ data }) => !data.borrador);
const poemasDelAutor = todosLosPoemas
  .filter((p) => p.data.autor.id === id)
  .sort((a, b) => b.data.fecha.getTime() - a.data.fecha.getTime())
  .map((p) => {
    const forma = TIPOS_DISPLAY[p.data.tipo];
    const mov = p.data.movimiento ? MOVIMIENTOS_DISPLAY[p.data.movimiento] : null;
    return {
      id: p.id,
      titulo: p.data.titulo,
      ilustracion: p.data.ilustracion,
      tag: [forma, mov].filter(Boolean).join(' · '),
    };
  });

const headingPoemas =
  poemasDelAutor.length === 0
    ? 'Aún no hay poemas de este autor'
    : poemasDelAutor.length === 1
      ? '1 poema en El Poemario'
      : `${poemasDelAutor.length} poemas en El Poemario`;

const descripcionMeta = `Poemas de ${nombre}, en El Poemario.`;
---

<Base titulo={`${nombre} · El Poemario`} descripcion={descripcionMeta}>
  <JsonLd slot="head" data={personLd} />
  <JsonLd slot="head" data={breadcrumbLd} />

  <article class="autor" lang="es">
    <p class="autor-backlink">
      <a href="/autores/">← Autores</a>
    </p>

    <div class="autor-intro">
      {imagen ? (
        <figure class="autor-retrato">
          <Image
            src={imagen}
            alt={`Retrato de ${nombre}`}
            loading="eager"
            decoding="async"
          />
          {lugar_nacimiento && (
            <figcaption>{lugar_nacimiento}</figcaption>
          )}
        </figure>
      ) : (
        <figure class="autor-retrato autor-retrato--ornamento" aria-hidden="true">
          <OrnamentoTarjeta />
        </figure>
      )}

      <div class="autor-cuerpo">
        <h1 class="autor-nombre">{nombre}</h1>
        {(anios || nacionalidad) && (
          <p class="autor-meta">
            {anios}
            {anios && nacionalidad && ' · '}
            {nacionalidad && (
              nacionalidadHref ? (
                <a href={nacionalidadHref}>{nacionalidad}</a>
              ) : (
                nacionalidad
              )
            )}
          </p>
        )}

        <div class="autor-bio prose">
          <slot />
        </div>

        {tambienEnLabel && tambienEnUrl && (
          <p class="autor-tambien-en">
            También figura en <a href={tambienEnUrl}>{tambienEnLabel}</a>.
          </p>
        )}
      </div>
    </div>

    <section class="autor-poemas" aria-labelledby="lista-titulo">
      <h2 id="lista-titulo">{headingPoemas}</h2>

      {poemasDelAutor.length > 0 && (
        <ul class="lista">
          {poemasDelAutor.map((p, i) => (
            <li class="obra" hidden={i >= 18}>
              {p.ilustracion && (
                <div class="obra-thumb" aria-hidden="true">
                  <Image
                    src={p.ilustracion}
                    alt=""
                    width={200}
                    loading="lazy"
                    decoding="async"
                  />
                </div>
              )}
              <div class="obra-texto">
                <h3 class="obra-titulo">
                  <a href={`/poemas/${p.id}/`}>{p.titulo}</a>
                </h3>
                {p.tag && <p class="obra-tag">{p.tag}</p>}
              </div>
              <span class="obra-leer" aria-hidden="true">Leer →</span>
            </li>
          ))}
        </ul>
      )}

      {poemasDelAutor.length > 18 && (
        <button type="button" class="cargar-mas" data-cargar-mas>
          Mostrar más poemas
        </button>
      )}
    </section>
  </article>

  <IconoEditar slug={id} coleccion="autores" />
</Base>

<script>
  const PASO = 18;
  const boton = document.querySelector<HTMLButtonElement>('[data-cargar-mas]');
  const lista = document.querySelector<HTMLUListElement>('.autor-poemas .lista');

  if (boton && lista) {
    const items = Array.from(lista.children) as HTMLElement[];

    boton.addEventListener('click', () => {
      const ocultos = items.filter((el) => el.hasAttribute('hidden'));
      const lote = ocultos.slice(0, PASO);

      lote.forEach((el) => el.removeAttribute('hidden'));

      // Move focus to the first revealed row's link.
      const primera = lote[0]?.querySelector<HTMLElement>('.obra-titulo a');
      if (primera) {
        primera.setAttribute('tabindex', '-1');
        primera.focus();
      }

      // Hide the button once no hidden rows remain.
      if (ocultos.length <= PASO) {
        boton.setAttribute('hidden', '');
      }
    });
  }
</script>

<style>
  .autor {
    max-width: var(--measure-wide);
    margin: 0 auto;
    padding-inline: var(--space-md);
    padding-block: var(--space-2xl);
  }

  /* ── Back-link «← Autores» ────────────────────────────────────────── */
  .autor-backlink {
    margin: 0 0 var(--space-lg);
  }
  .autor-backlink a {
    font-family: var(--font-meta);
    font-size: var(--fs-3xs);
    letter-spacing: var(--ls-wider);
    text-transform: uppercase;
    color: var(--oro-texto);
    text-decoration: none;
    border-bottom: none;
    transition: color var(--dur-fast) var(--ease-standard);
  }
  .autor-backlink a:hover,
  .autor-backlink a:focus-visible {
    color: var(--oro);
  }

  /* ── Intro: retrato | biografía (handoff 0.85fr / 1.15fr) ─────────── */
  .autor-intro {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: var(--space-2xl);
    align-items: start;
    padding-bottom: var(--space-2xl);
    border-bottom: 1px solid var(--rule);
  }

  /* Portrait in passe-partout (handoff): --mat backing + --rule border,
     natural aspect ratio (no crop). Caption from `lugar_nacimiento`. */
  .autor-retrato {
    margin: 0;
    border: 1px solid var(--rule);
    padding: var(--space-xs);
    background: var(--mat);
  }
  .autor-retrato img {
    display: block;
    width: 100%;
    height: auto;
  }
  .autor-retrato figcaption {
    text-align: center;
    font-family: var(--font-body);
    font-style: italic;
    font-size: var(--fs-sm);
    color: var(--text-muted);
    padding: var(--space-sm) var(--space-2xs) var(--space-2xs);
  }
  /* Ornament fallback (no portrait). Kept inside the passe-partout frame. */
  .autor-retrato--ornamento {
    aspect-ratio: 3 / 2;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .autor-retrato--ornamento :global(svg) {
    width: 60%;
    height: auto;
  }

  /* ── Name + meta + bio (right column) ─────────────────────────────── */
  /* Nombre de autor = entidad de catalogo (decision de diseno §25): Cinzel
     semibold en versalitas, un escalon bajo el masthead bold de los titulos de
     indice. Convive con el titulo de obra (poema/entrada) que va en Garamond.
     Las mayusculas se aplican por CSS para no alterar el accessible name que
     leen los lectores de pantalla. */
  .autor-nombre {
    font-family: var(--font-display);
    font-weight: var(--fw-semibold);
    font-size: var(--fs-2xl);
    line-height: 1.1;
    margin: 0 0 var(--space-xs);
    color: var(--text);
    letter-spacing: var(--ls-wider);
    text-transform: uppercase;
    text-wrap: balance;
  }
  .autor-meta {
    font-family: var(--font-meta);
    font-size: var(--fs-xs);
    letter-spacing: var(--ls-widest);
    text-transform: uppercase;
    color: var(--oro-texto);
    margin: 0 0 var(--space-lg);
  }
  .autor-meta a {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color var(--dur-fast) var(--ease-standard);
  }
  .autor-meta a:hover,
  .autor-meta a:focus-visible {
    border-bottom-color: var(--oro);
  }

  .autor-bio {
    font-family: var(--font-body);
    font-size: var(--fs-prosa);
    line-height: var(--lh-prosa);
    color: var(--text);
  }
  .autor-bio :global(p) {
    font-family: var(--font-prose);
    margin: 0 0 var(--space-lg);
  }
  .autor-bio :global(p:last-child) {
    margin-bottom: 0;
  }
  .autor-bio :global(em) {
    font-style: italic;
  }
  .autor-bio :global(strong) {
    font-weight: var(--fw-bold);
  }
  .autor-bio :global(a) {
    color: var(--link);
  }

  .autor-tambien-en {
    margin: var(--space-lg) 0 0;
    font-family: var(--font-body);
    font-style: italic;
    font-size: var(--fs-base);
    color: var(--text-soft);
  }

  /* ── Obras en El Poemario (lista con miniatura) ───────────────────── */
  .autor-poemas {
    margin-top: var(--space-2xl);
  }
  .autor-poemas h2 {
    font-family: var(--font-display);
    font-weight: var(--fw-semibold);
    font-size: var(--fs-xl);
    letter-spacing: var(--ls-wide);
    color: var(--text);
    margin: 0 0 var(--space-md);
  }
  .lista {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .obra {
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--space-lg);
    padding: var(--space-md) var(--space-2xs);
    border-top: 1px solid var(--rule-soft);
    transition: background-color var(--dur-fast) var(--ease-standard);
  }
  .obra:has(.obra-titulo a:hover),
  .obra:has(.obra-titulo a:focus-visible) {
    background-color: var(--hover-tint);
  }
  /* Work thumbnail: small framed illustration (handoff 96×60). */
  .obra-thumb {
    flex: none;
    width: 96px;
    height: 60px;
    border: 1px solid var(--rule);
    overflow: hidden;
  }
  .obra-thumb img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .obra-texto {
    flex: 1;
    min-width: 0;
  }
  .obra-titulo {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--fs-lg);
    line-height: var(--lh-snug);
    color: var(--text);
    text-transform: none;
    letter-spacing: 0;
    margin: 0 0 var(--space-3xs);
  }
  .obra-titulo a {
    text-decoration: none;
    color: inherit;
    border-bottom: none;
  }
  .obra-titulo a::before {
    content: '';
    position: absolute;
    inset: 0;
  }
  .obra:has(.obra-titulo a:hover) .obra-titulo,
  .obra:has(.obra-titulo a:focus-visible) .obra-titulo {
    color: var(--oro-texto);
  }
  .obra-tag {
    font-family: var(--font-body);
    font-style: italic;
    font-size: var(--fs-sm);
    color: var(--text-muted);
    margin: 0;
  }
  .obra-leer {
    flex: none;
    font-family: var(--font-meta);
    font-size: var(--fs-3xs);
    letter-spacing: var(--ls-wider);
    text-transform: uppercase;
    color: var(--oro-texto);
  }

  /* Hidden batches for cargar-mas. */
  [hidden] {
    display: none !important;
  }
  .cargar-mas {
    display: block;
    margin: var(--space-xl) auto 0;
    padding: var(--space-2xs) var(--space-md);
    font-family: var(--font-display);
    font-size: var(--fs-3xs);
    letter-spacing: var(--ls-wide);
    text-transform: uppercase;
    color: var(--oro-texto);
    background: transparent;
    border: var(--rule-hairline) solid var(--oro);
    cursor: pointer;
    transition:
      background-color var(--dur-fast) var(--ease-standard),
      color var(--dur-fast) var(--ease-standard);
  }
  .cargar-mas:hover,
  .cargar-mas:focus-visible {
    background-color: var(--bg-elevated);
    color: var(--oro);
  }
  .cargar-mas:focus-visible {
    outline: 2px solid var(--oro);
    outline-offset: 2px;
  }

  /* ── Móvil: una columna ───────────────────────────────────────────── */
  @media (max-width: 640px) {
    .autor-intro {
      grid-template-columns: 1fr;
      gap: var(--space-lg);
    }
    .autor-retrato {
      max-width: 320px;
      margin-inline: auto;
    }
    .obra {
      gap: var(--space-md);
    }
    .obra-leer {
      display: none;
    }
  }
</style>
