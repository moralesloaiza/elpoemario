---
import '../styles/tokens.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BotonCrear from '../components/BotonCrear.astro';
import { SITE_DESCRIPTION } from '../consts';
import '@fontsource/cinzel/400.css';
import '@fontsource/cinzel/500.css';
import '@fontsource/cinzel/600.css';
import '@fontsource/cinzel/700.css';
import '@fontsource/cormorant-garamond/400.css';
import '@fontsource/cormorant-garamond/500.css';
import '@fontsource/cormorant-garamond/600.css';
import '@fontsource/cormorant-garamond/700.css';
import '@fontsource/cormorant-garamond/400-italic.css';
import '@fontsource/cormorant-garamond/500-italic.css';
import '@fontsource/cormorant-garamond/600-italic.css';

interface Props {
  titulo: string;
  descripcion?: string;
}

const { titulo, descripcion = SITE_DESCRIPTION } = Astro.props;

// Canonical absoluto, siempre en forma con barra final (coherente con
// trailingSlash: 'always' y con el sitemap). Punto único para todo el sitio.
const canonicalURL = new URL(Astro.url.pathname.replace(/\/?$/, '/'), Astro.site);

---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    {/* Tema día/noche · aplica la preferencia persistida ANTES del primer
        pintado para evitar flash. Noche es el default (:root, sin atributo);
        'day' fija [data-theme='day'] en <html>. Clave canónica
        'poemario-theme' (day|night) con lectura retrocompatible de la
        anterior 'elp-theme' (pergamino|nocturno), que solo usaba la página
        de poema. El conmutador vive en el Header (ver Header.astro). */}
    <script is:inline>
      (function () {
        try {
          var v = localStorage.getItem('poemario-theme');
          if (v === null) {
            var old = localStorage.getItem('elp-theme');
            if (old === 'pergamino') v = 'day';
            else if (old === 'nocturno') v = 'night';
          }
          if (v === 'day') document.documentElement.setAttribute('data-theme', 'day');
        } catch (e) {}
      })();
    </script>

    <meta name="description" content={descripcion} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{titulo}</title>
    <slot name="head" />
  </head>
  <body>
    <Header />

    <main class="page site-main">
      <slot />
    </main>

    <Footer />
    <BotonCrear />

    <style>
      .site-main {
        padding-block: var(--space-2xl);
      }
    </style>
  </body>
</html>