---
import '../styles/tokens.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BotonCrear from '../components/BotonCrear.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import '@fontsource/cinzel/400.css';
import '@fontsource/cinzel/500.css';
import '@fontsource/cinzel/600.css';
import '@fontsource/cinzel/700.css';
import '@fontsource/cormorant-garamond/400.css';
import '@fontsource/cormorant-garamond/500.css';
import '@fontsource/cormorant-garamond/600.css';
import '@fontsource/cormorant-garamond/700.css';
import '@fontsource/cormorant-garamond/400-italic.css';
import '@fontsource/cormorant-garamond/500-italic.css';
import '@fontsource/cormorant-garamond/600-italic.css';
import '@fontsource/cormorant-garamond/700-italic.css';
import '@fontsource/eb-garamond/400.css';
import '@fontsource/eb-garamond/500.css';
import '@fontsource/eb-garamond/700.css';
import '@fontsource/eb-garamond/400-italic.css';
import '@fontsource/eb-garamond/500-italic.css';
import '@fontsource/eb-garamond/700-italic.css';

interface Props {
  titulo: string;
  descripcion?: string;
  /* Modo inmersivo: la página aporta un hero a sangre por el slot "hero" y el
     masthead flota transparente encima (nav overlay). El cuerpo fluye justo
     bajo el hero (sin el padding superior de .site-main). Off por defecto: el
     Header sólido se pinta sobre <main> como en el resto del sitio. */
  heroInmersivo?: boolean;
  /* PWA · manifest y título de app instalada. Por defecto los de El Poemario
     (sitio completo). La página del Taller los sobrescribe para ofrecerse como
     app instalable independiente (scope /taller). El navegador toma el PRIMER
     <link rel="manifest">, por eso se parametriza aquí y no en un slot. */
  manifest?: string;
  appTitle?: string;
  appleTouchIcon?: string;
  /* Imagen para las tarjetas sociales (Open Graph / Twitter). Cuando la página
     tiene una ilustración o retrato propios, los pasa aquí; si no, se usa el
     icono del sitio como reserva. */
  imagen?: ImageMetadata;
  /* Texto alternativo de la imagen social (og:image:alt / twitter:image:alt). */
  imagenAlt?: string;
  /* Tipo Open Graph: 'article' para una obra o entrada, 'website' para índices
     y portada (por defecto). */
  ogTipo?: 'website' | 'article';
}

const {
  titulo,
  descripcion = SITE_DESCRIPTION,
  heroInmersivo = false,
  manifest = '/manifest.webmanifest',
  appTitle = 'El Poemario',
  appleTouchIcon = '/icons/apple-touch-icon.png',
  imagen,
  imagenAlt,
  ogTipo = 'website',
} = Astro.props;

// Canonical absoluto, siempre en forma con barra final (coherente con
// trailingSlash: 'always' y con el sitemap). Punto único para todo el sitio.
const canonicalURL = new URL(Astro.url.pathname.replace(/\/?$/, '/'), Astro.site);

// Tarjeta social: la ilustración de la página (absoluta) o, en su defecto, el
// icono del sitio. Las ilustraciones originales pesan megas y WhatsApp descarta
// las og:image pesadas (cae al icono del sitio), así que se re-encodan a una
// tarjeta 1.91:1 ligera (JPEG 1200×630, ~100-200 KB). Con imagen propia la
// tarjeta va a lo grande; con el icono cuadrado, al formato resumen.
const ogResultado = imagen
  ? await getImage({
      src: imagen,
      width: 1200,
      height: 630,
      fit: 'cover',
      position: 'center',
      format: 'jpeg',
      quality: 60,
    })
  : null;
const ogImagen = ogResultado
  ? new URL(ogResultado.src, Astro.site)
  : new URL('/icons/icon-512.png', Astro.site);
const ogAncho = ogResultado?.attributes.width ?? 512;
const ogAlto = ogResultado?.attributes.height ?? 512;
const ogAlt = imagenAlt ?? (imagen ? titulo : SITE_TITLE);
const twitterCard = imagen ? 'summary_large_image' : 'summary';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    {/* Barra del navegador / de la app instalada. Default noche (#141b28); el
        script de tema de abajo lo cambia a día (#ece4d2) si esa es la
        preferencia, para que la barra siga al tema elegido. */}
    <meta name="theme-color" content="#141b28" />

    {/* Tema día/noche · aplica la preferencia persistida ANTES del primer
        pintado para evitar flash. Noche es el default (:root, sin atributo);
        'day' fija [data-theme='day'] en <html>. Clave canónica
        'poemario-theme' (day|night) con lectura retrocompatible de la
        anterior 'elp-theme' (pergamino|nocturno), que solo usaba la página
        de poema. El conmutador vive en el Header (ver Header.astro). */}
    <script is:inline>
      (function () {
        try {
          var v = localStorage.getItem('poemario-theme');
          if (v === null) {
            var old = localStorage.getItem('elp-theme');
            if (old === 'pergamino') v = 'day';
            else if (old === 'nocturno') v = 'night';
          }
          if (v === 'day') {
            document.documentElement.setAttribute('data-theme', 'day');
            var m = document.querySelector('meta[name="theme-color"]');
            if (m) m.setAttribute('content', '#ece4d2');
          }
        } catch (e) {}
      })();
    </script>

    <meta name="description" content={descripcion} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    {/* Tarjetas sociales · así, al pegar un enlace en WhatsApp, X, Facebook,
        Telegram, etc., sale una previsualización con título, resumen e imagen
        en vez de una URL pelada. Open Graph lo leen casi todas; las etiquetas
        twitter:* las usa X. */}
    <meta property="og:type" content={ogTipo} />
    <meta property="og:site_name" content={SITE_TITLE} />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImagen} />
    <meta property="og:image:width" content={ogAncho} />
    <meta property="og:image:height" content={ogAlto} />
    <meta property="og:image:alt" content={ogAlt} />
    <meta property="og:locale" content="es_ES" />
    <meta name="twitter:card" content={twitterCard} />
    <meta name="twitter:title" content={titulo} />
    <meta name="twitter:description" content={descripcion} />
    <meta name="twitter:image" content={ogImagen} />
    <meta name="twitter:image:alt" content={ogAlt} />

    {/* PWA · permite «instalar» el sitio como app (Windows/Android/escritorio)
        y la lectura offline de lo ya visitado (ver public/manifest.webmanifest
        y public/sw.js). */}
    <link rel="manifest" href={manifest} />
    <link rel="apple-touch-icon" href={appleTouchIcon} />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content={appTitle} />

    <title>{titulo}</title>
    <slot name="head" />
  </head>
  <body>
    {heroInmersivo ? (
      <div class="hero-inmersivo">
        <slot name="hero" />
        <Header variante="overlay" />
      </div>
    ) : (
      <Header />
    )}

    <main class="page site-main" class:list={{ 'site-main--tras-hero': heroInmersivo }}>
      <slot />
    </main>

    <Footer />
    <BotonCrear />

    {/* Registro del service worker · SOLO en producción. En desarrollo el SW
        cachearía respuestas y pelearía con el HMR de Astro (CSS/JS obsoleto),
        así que se omite del build de dev. */}
    {import.meta.env.PROD && (
      <script is:inline>
        if ('serviceWorker' in navigator) {
          window.addEventListener('load', function () {
            navigator.serviceWorker.register('/sw.js').catch(function () {});
          });
        }
      </script>
    )}

    <style>
      .site-main {
        padding-block: var(--space-2xl);
      }

      /* Hero inmersivo: contenedor full-bleed (hijo directo de <body>, sin el
         contenedor .page, sangra de borde a borde) y contexto de posición para
         que el masthead overlay se ancle arriba sobre la imagen. */
      .hero-inmersivo {
        position: relative;
      }

      /* Tras un hero inmersivo el cuerpo arranca pegado a la imagen: se quita
         solo el padding superior (el inferior de la página se conserva). */
      .site-main--tras-hero {
        padding-block-start: 0;
      }
    </style>
  </body>
</html>