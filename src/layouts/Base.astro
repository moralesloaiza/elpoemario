---
import '../styles/tokens.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BotonCrear from '../components/BotonCrear.astro';
import { SITE_DESCRIPTION } from '../consts';

interface Props {
  titulo: string;
  descripcion?: string;
}

const { titulo, descripcion = SITE_DESCRIPTION } = Astro.props;

// Canonical absoluto, siempre en forma con barra final (coherente con
// trailingSlash: 'always' y con el sitemap). Punto único para todo el sitio.
const canonicalURL = new URL(Astro.url.pathname.replace(/\/?$/, '/'), Astro.site);

---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600;700&family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600&family=Josefin+Sans:wght@400;500;600&display=swap"
    />
    <title>{titulo}</title>
    <slot name="head" />
  </head>
  <body>
    <Header />

    <main class="page site-main">
      <slot />
    </main>

    <Footer />
    <BotonCrear />

    <style>
      .site-main {
        padding-block: var(--space-2xl);
      }
    </style>
  </body>
</html>