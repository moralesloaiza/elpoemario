---
import '../styles/tokens.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BotonCrear from '../components/BotonCrear.astro';
import { SITE_DESCRIPTION } from '../consts';
import '@fontsource/cinzel/400.css';
import '@fontsource/cinzel/500.css';
import '@fontsource/cinzel/600.css';
import '@fontsource/cinzel/700.css';
import '@fontsource/cormorant-garamond/400.css';
import '@fontsource/cormorant-garamond/500.css';
import '@fontsource/cormorant-garamond/600.css';
import '@fontsource/cormorant-garamond/700.css';
import '@fontsource/cormorant-garamond/400-italic.css';
import '@fontsource/cormorant-garamond/500-italic.css';
import '@fontsource/cormorant-garamond/600-italic.css';
import '@fontsource/cormorant-garamond/700-italic.css';
import '@fontsource/eb-garamond/400.css';
import '@fontsource/eb-garamond/500.css';
import '@fontsource/eb-garamond/700.css';
import '@fontsource/eb-garamond/400-italic.css';
import '@fontsource/eb-garamond/500-italic.css';
import '@fontsource/eb-garamond/700-italic.css';

interface Props {
  titulo: string;
  descripcion?: string;
  /* Modo inmersivo: la página aporta un hero a sangre por el slot "hero" y el
     masthead flota transparente encima (nav overlay). El cuerpo fluye justo
     bajo el hero (sin el padding superior de .site-main). Off por defecto: el
     Header sólido se pinta sobre <main> como en el resto del sitio. */
  heroInmersivo?: boolean;
}

const { titulo, descripcion = SITE_DESCRIPTION, heroInmersivo = false } = Astro.props;

// Canonical absoluto, siempre en forma con barra final (coherente con
// trailingSlash: 'always' y con el sitemap). Punto único para todo el sitio.
const canonicalURL = new URL(Astro.url.pathname.replace(/\/?$/, '/'), Astro.site);

---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    {/* Barra del navegador / de la app instalada. Default noche (#141b28); el
        script de tema de abajo lo cambia a día (#ece4d2) si esa es la
        preferencia, para que la barra siga al tema elegido. */}
    <meta name="theme-color" content="#141b28" />

    {/* Tema día/noche · aplica la preferencia persistida ANTES del primer
        pintado para evitar flash. Noche es el default (:root, sin atributo);
        'day' fija [data-theme='day'] en <html>. Clave canónica
        'poemario-theme' (day|night) con lectura retrocompatible de la
        anterior 'elp-theme' (pergamino|nocturno), que solo usaba la página
        de poema. El conmutador vive en el Header (ver Header.astro). */}
    <script is:inline>
      (function () {
        try {
          var v = localStorage.getItem('poemario-theme');
          if (v === null) {
            var old = localStorage.getItem('elp-theme');
            if (old === 'pergamino') v = 'day';
            else if (old === 'nocturno') v = 'night';
          }
          if (v === 'day') {
            document.documentElement.setAttribute('data-theme', 'day');
            var m = document.querySelector('meta[name="theme-color"]');
            if (m) m.setAttribute('content', '#ece4d2');
          }
        } catch (e) {}
      })();
    </script>

    <meta name="description" content={descripcion} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    {/* PWA · permite «instalar» el sitio como app (Windows/Android/escritorio)
        y la lectura offline de lo ya visitado (ver public/manifest.webmanifest
        y public/sw.js). */}
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Poemario" />

    <title>{titulo}</title>
    <slot name="head" />
  </head>
  <body>
    {heroInmersivo ? (
      <div class="hero-inmersivo">
        <slot name="hero" />
        <Header variante="overlay" />
      </div>
    ) : (
      <Header />
    )}

    <main class="page site-main" class:list={{ 'site-main--tras-hero': heroInmersivo }}>
      <slot />
    </main>

    <Footer />
    <BotonCrear />

    {/* Registro del service worker · SOLO en producción. En desarrollo el SW
        cachearía respuestas y pelearía con el HMR de Astro (CSS/JS obsoleto),
        así que se omite del build de dev. */}
    {import.meta.env.PROD && (
      <script is:inline>
        if ('serviceWorker' in navigator) {
          window.addEventListener('load', function () {
            navigator.serviceWorker.register('/sw.js').catch(function () {});
          });
        }
      </script>
    )}

    <style>
      .site-main {
        padding-block: var(--space-2xl);
      }

      /* Hero inmersivo: contenedor full-bleed (hijo directo de <body>, sin el
         contenedor .page, sangra de borde a borde) y contexto de posición para
         que el masthead overlay se ancle arriba sobre la imagen. */
      .hero-inmersivo {
        position: relative;
      }

      /* Tras un hero inmersivo el cuerpo arranca pegado a la imagen: se quita
         solo el padding superior (el inferior de la página se conserva). */
      .site-main--tras-hero {
        padding-block-start: 0;
      }
    </style>
  </body>
</html>