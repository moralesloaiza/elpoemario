---
import type { CollectionEntry } from 'astro:content';
import { getCollection, getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { marked } from 'marked';

import Base from './Base.astro';
import JsonLd from '../components/JsonLd.astro';
import FormattedDate from '../components/FormattedDate.astro';
import SpotifyEmbed from '../components/SpotifyEmbed.astro';
import NavegacionPoemas from '../components/NavegacionPoemas.astro';
import IconoEditar from '../components/IconoEditar.astro';

import { buildPoemaJsonLd } from '../utils/jsonld';
import {
  TIPOS_DISPLAY,
  MOVIMIENTOS_DISPLAY,
  TEMAS_DISPLAY,
  MOTIVOS_DISPLAY,
  URL_TIPOS,
  URL_MOVIMIENTOS,
  URL_TEMAS,
  URL_MOTIVOS,
} from '../utils/taxonomia';

// Receives the poema's frontmatter spread plus its id (slug). Same
// pattern as Fabula.astro in El Fabulario.
type Props = CollectionEntry<'poemas'>['data'] & { id: string };

const props = Astro.props;
const {
  id,
  titulo,
  resumen,
  fecha,
  fecha_actualizada,
  ilustracion,
  spotify_url,
  tipo,
  movimiento,
  temas,
  motivos,
  autor: autorRef,
  traductor: traductorRef,
  curador,
  nota_curador,
} = props;

// Resolve referenced author entry.
const autor = await getEntry(autorRef);
if (!autor) {
  throw new Error(`Poema "${id}" referencia autor inexistente: ${autorRef.id}`);
}

// Resolve optional translator entry. Zod has already validated the
// reference exists; we still guard against an unexpected null return.
const traductor = traductorRef ? await getEntry(traductorRef) : null;
if (traductorRef && !traductor) {
  throw new Error(
    `Poema "${id}" referencia traductor inexistente: ${traductorRef.id}`,
  );
}

// JSON-LD for the Poem entity.
const site = Astro.site!;
const jsonLd = buildPoemaJsonLd(props as Props, autor, traductor, site);

// Author dates: "1836–1870" only if both years are known.
const fnac = autor.data.nacimiento;
const fmue = autor.data.muerte;
const anios = fnac && fmue
  ? `${fnac}–${fmue}`
  : null;

// Author nationality + dates line, e.g. "mexicano · 1849–1873".
const autorNacionalidad = autor.data.nacionalidad ?? null;
const autorSubmeta = [autorNacionalidad, anios].filter(Boolean).join(' · ');

// Curator note: inline Markdown (no <p> wrapper, sits inside a <p>).
const notaCuradorHtml = nota_curador
  ? (marked.parseInline(nota_curador, { async: false }) as string)
  : null;

// Curator credit (decision 11).
const creditoCurador = notaCuradorHtml
  ? `Selección y nota de ${curador}.`
  : `Selección de ${curador}.`;

// Body class: verse vs prose-poetry.
const bodyClass = tipo === 'prosa-poetica' ? 'prose' : 'prose prose--verso';

// Description for <Base>.
const descripcion = resumen ?? `Poema de ${autor.data.nombre}, en El Poemario.`;

// ── Previous / next navigation ────────────────────────────────────────────
// Build a chronological-desc list of all non-draft poemas. The current
// entry is found by id and the neighbors are selected with circular
// wrapping at both ends. Replicates NavegacionFabulas behaviour.
const todos = await getCollection('poemas', ({ data }) => !data.borrador);
todos.sort((a, b) => b.data.fecha.getTime() - a.data.fecha.getTime());

const idx = todos.findIndex((p) => p.id === id);

// idx can legitimately be -1 when this layout renders a draft (drafts
// are excluded from `todos`). In that case neighbours collapse to the
// current entry, which makes the navigation harmless but visible.
const safeIdx = idx === -1 ? 0 : idx;
const total = todos.length;
const anteriorEntry = total > 0
  ? todos[(safeIdx - 1 + total) % total]
  : null;
const siguienteEntry = total > 0
  ? todos[(safeIdx + 1) % total]
  : null;

const anterior = anteriorEntry
  ? { slug: anteriorEntry.id, titulo: anteriorEntry.data.titulo }
  : null;
const siguiente = siguienteEntry
  ? { slug: siguienteEntry.id, titulo: siguienteEntry.data.titulo }
  : null;
---

<Base titulo={`${titulo} · El Poemario`} descripcion={descripcion}>
  <JsonLd slot="head" data={jsonLd} />

  <article class="poema" lang="es" data-pagefind-body>
    {ilustracion && (
      <figure class="poema-ilustracion">
        <Image
          src={ilustracion}
          alt=""
          loading="eager"
          decoding="async"
          width={1200}
          height={800}
        />
      </figure>
    )}

    <header class="poema-cabecera">
      <h1 class="poema-titulo">{titulo}</h1>
      <p class="poema-autor">
        <a href={`/autores/${autor.id}/`}><span data-pagefind-meta="author">{autor.data.nombre}</span></a>
      </p>
      {autorSubmeta && <p class="poema-autor-submeta">{autorSubmeta}</p>}
      {traductor && (
        <p class="poema-traductor">
          Traducción de <a href={`/autores/${traductor.id}/`}>{traductor.data.nombre}</a>
        </p>
      )}
      <hr class="ornate" />
    </header>

    {spotify_url && <SpotifyEmbed url={spotify_url} />}

    <div class={bodyClass}>
      <slot />
    </div>

    {notaCuradorHtml && (
      <aside class="nota-curador" aria-label={`Nota de ${curador}`}>
        <p class="nota-curador-rotulo">Nota de {curador}</p>
        <p class="nota-curador-texto" set:html={notaCuradorHtml}></p>
      </aside>
    )}

    <footer class="poema-cierre">
      <p class="poema-credito">{creditoCurador}</p>
      <p class="poema-fecha">
        Publicado el <FormattedDate date={fecha} />
        {fecha_actualizada && (
          <span>
            {' · Actualizado el '}<FormattedDate date={fecha_actualizada} />
          </span>
        )}
      </p>
    </footer>

    <section class="poema-taxonomia" aria-label="Categorías de este poema">
      <dl>
        <div class="taxo-grupo">
          <dt>Tipo</dt>
          <dd>
            <a href={`${URL_TIPOS}/${tipo}/`} class="chip">{TIPOS_DISPLAY[tipo]}</a>
          </dd>
        </div>

        {movimiento && (
          <div class="taxo-grupo">
            <dt>Movimiento</dt>
            <dd>
              <a href={`${URL_MOVIMIENTOS}/${movimiento}/`} class="chip">
                {MOVIMIENTOS_DISPLAY[movimiento]}
              </a>
            </dd>
          </div>
        )}

        {temas.length > 0 && (
          <div class="taxo-grupo">
            <dt>Temas</dt>
            <dd>
              <ul class="chips">
                {temas.map((t) => (
                  <li>
                    <a href={`${URL_TEMAS}/${t}/`} class="chip">{TEMAS_DISPLAY[t]}</a>
                  </li>
                ))}
              </ul>
            </dd>
          </div>
        )}

        {motivos.length > 0 && (
          <div class="taxo-grupo">
            <dt>Motivos</dt>
            <dd>
              <ul class="chips">
                {motivos.map((m) => (
                  <li>
                    <a href={`${URL_MOTIVOS}/${m}/`} class="chip">{MOTIVOS_DISPLAY[m]}</a>
                  </li>
                ))}
              </ul>
            </dd>
          </div>
        )}

        <div class="taxo-grupo">
          <dt>Autor</dt>
          <dd>
            <a href={`/autores/${autor.id}/`} class="chip">{autor.data.nombre}</a>
          </dd>
        </div>

        {traductor && (
          <div class="taxo-grupo">
            <dt>Traductor</dt>
            <dd>
              <a href={`/autores/${traductor.id}/`} class="chip">{traductor.data.nombre}</a>
            </dd>
          </div>
        )}

        <div class="taxo-grupo">
          <dt>Ayuda</dt>
          <dd>
            <a href="/colaborar/" class="chip">¿Cómo colaborar?</a>
          </dd>
        </div>
      </dl>
    </section>

    {anterior && siguiente && (
      <NavegacionPoemas anterior={anterior} siguiente={siguiente} />
    )}
  </article>

  <IconoEditar slug={id} coleccion="poemas" />
</Base>

<style>
  /* ── Article wrapper ─────────────────────────────────────────────── */
  .poema {
    max-width: var(--measure);
    margin: 0 auto;
    padding-inline: var(--space-md);
  }

  /* ── Illustration ────────────────────────────────────────────────── */
  .poema-ilustracion {
    margin: 0 0 var(--space-2xl);
    padding: 0;
  }
  .poema-ilustracion img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border: var(--rule-hairline) solid var(--oro);
  }

  /* ── Header ──────────────────────────────────────────────────────── */
  .poema-cabecera {
    text-align: center;
    margin-bottom: var(--space-xl);
  }
  .poema-titulo {
    font-family: var(--font-display);
    font-size: var(--fs-3xl);
    line-height: var(--lh-snug);
    margin: 0 0 var(--space-md);
    color: var(--text);
    letter-spacing: 0.04em;
    text-wrap: balance;
  }
  .poema-autor {
    font-family: var(--font-body);
    font-style: italic;
    font-size: var(--fs-lg);
    color: var(--text-soft);
    margin: 0;
  }
  .poema-autor a {
    color: inherit;
    border-bottom-color: transparent;
  }
  .poema-autor a:hover,
  .poema-autor a:focus-visible {
    color: var(--link-hover);
    border-bottom-color: currentColor;
  }
  .poema-autor-submeta {
    font-family: var(--font-body);
    font-style: italic;
    font-size: var(--fs-sm);
    color: var(--text-muted);
    margin: var(--space-2xs) 0 0;
  }
  .poema-traductor {
    font-family: var(--font-body);
    font-style: italic;
    font-size: var(--fs-sm);
    color: var(--text-muted);
    margin: var(--space-2xs) 0 0;
  }
  .poema-traductor a {
    color: inherit;
    border-bottom-color: transparent;
  }
  .poema-traductor a:hover,
  .poema-traductor a:focus-visible {
    color: var(--link-hover);
    border-bottom-color: currentColor;
  }

  /* ── Body (verse and prose-poetry) ───────────────────────────────── */
  .prose {
    font-family: var(--font-body);
    font-size: var(--fs-md);
    line-height: var(--line-height-body);
    color: var(--text);
    max-width: var(--measure-narrow);
    margin-inline: auto;
  }
  .prose :global(p) {
    margin: 0 0 var(--space-lg);
  }
  .prose :global(em) {
    font-style: italic;
  }
  .prose :global(strong) {
    font-weight: var(--fw-bold);
  }
  .prose :global(a) {
    color: var(--link);
  }
  .prose :global(blockquote) {
    margin: var(--space-lg) 0;
    padding-inline: var(--space-md);
    border-left: 2px solid var(--coral);
    font-style: italic;
    color: var(--text-soft);
  }

  /* Verse block: shrink-to-fit to the longest line and center it
     (like El Fabulario), capped at the reading measure so an
     over-long line wraps instead of stretching the column. */
  .prose--verso {
    width: max-content;
    max-width: min(var(--measure-narrow), 100%);
    margin-inline: auto;
  }

  /* Verse-specific: hanging indent for wrapped long lines. */
  .prose--verso :global(p) {
    margin: 0 0 1.5em;
    padding-inline-start: 2ch;
    text-indent: -2ch;
  }

  /* Prose-poetry: first-letter drop cap on the first paragraph. */
  .prose:not(.prose--verso) :global(p:first-of-type::first-letter) {
    font-family: var(--font-display);
    float: left;
    font-size: 3.4em;
    line-height: 0.85;
    padding-right: 0.08em;
    padding-top: 0.05em;
    color: var(--oro-texto);
  }

  /* ── Curator note ────────────────────────────────────────────────── */
  .nota-curador {
    margin: var(--space-2xl) auto 0;
    max-width: var(--measure-narrow);
    padding: var(--space-lg);
    border: var(--rule-hairline) solid var(--oro);
    background: var(--bg-elevated);
  }
  .nota-curador-rotulo {
    font-family: var(--font-display);
    font-size: var(--fs-3xs);
    letter-spacing: var(--ls-widest);
    text-transform: uppercase;
    color: var(--oro-texto);
    margin: 0 0 var(--space-xs);
    font-weight: var(--fw-bold);
  }
  .nota-curador-texto {
    font-family: var(--font-body);
    font-style: italic;
    font-size: var(--fs-base);
    line-height: var(--line-height-body);
    color: var(--text-soft);
    margin: 0;
  }

  /* ── Cierre ──────────────────────────────────────────────────────── */
  .poema-cierre {
    margin-top: var(--space-2xl);
    text-align: center;
    color: var(--text-soft);
    font-size: var(--fs-sm);
  }
  .poema-credito {
    margin: 0 0 var(--space-2xs);
    font-style: italic;
  }
  .poema-fecha {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--fs-3xs);
    letter-spacing: var(--ls-wide);
    text-transform: uppercase;
    color: var(--text-muted);
  }

  /* ── Taxonomy footer ─────────────────────────────────────────────── */
  .poema-taxonomia {
    margin-top: var(--space-2xl);
    padding-top: var(--space-lg);
    border-top: var(--rule-hairline) solid var(--oro);
  }
  .poema-taxonomia dl {
    margin: 0;
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: var(--space-xs) var(--space-lg);
  }
  .taxo-grupo {
    display: contents;
  }
  .poema-taxonomia dt {
    font-family: var(--font-display);
    font-size: var(--fs-3xs);
    letter-spacing: var(--ls-widest);
    text-transform: uppercase;
    color: var(--oro-texto);
    font-weight: var(--fw-bold);
    padding-top: var(--space-2xs);
  }
  .poema-taxonomia dd {
    margin: 0;
  }
  .chips {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
  }
  .chip {
    display: inline-block;
    font-family: var(--font-body);
    font-size: var(--fs-sm);
    padding: var(--space-3xs) var(--space-xs);
    border: var(--rule-hairline) solid var(--oro-suave);
    color: var(--text);
    text-decoration: none;
    transition:
      border-color var(--dur-fast) var(--ease-standard),
      color var(--dur-fast) var(--ease-standard);
  }
  .chip:hover,
  .chip:focus-visible {
    border-color: var(--oro);
    color: var(--oro-texto);
  }

  @media (max-width: 640px) {
    .poema-taxonomia dl {
      grid-template-columns: 1fr;
      gap: var(--space-2xs);
    }
    .taxo-grupo {
      display: block;
      margin-bottom: var(--space-sm);
    }
    .poema-taxonomia dt {
      margin-bottom: var(--space-2xs);
    }
  }
</style>