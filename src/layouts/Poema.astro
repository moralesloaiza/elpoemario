---
import type { CollectionEntry } from 'astro:content';
import { getCollection, getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { marked } from 'marked';

import Base from './Base.astro';
import JsonLd from '../components/JsonLd.astro';
import FormattedDate from '../components/FormattedDate.astro';
import SpotifyEmbed from '../components/SpotifyEmbed.astro';
import NavegacionPoemas from '../components/NavegacionPoemas.astro';
import IconoEditar from '../components/IconoEditar.astro';

import { buildPoemaJsonLd } from '../utils/jsonld';
import {
  TIPOS_DISPLAY,
  MOVIMIENTOS_DISPLAY,
  TEMAS_DISPLAY,
  MOTIVOS_DISPLAY,
  URL_TIPOS,
  URL_MOVIMIENTOS,
  URL_TEMAS,
  URL_MOTIVOS,
} from '../utils/taxonomia';

// Receives the poema's frontmatter spread plus its id (slug). Same
// pattern as Fabula.astro in El Fabulario.
type Props = CollectionEntry<'poemas'>['data'] & { id: string };

const props = Astro.props;
const {
  id,
  titulo,
  resumen,
  fecha,
  fecha_actualizada,
  ilustracion,
  spotify_url,
  tipo,
  movimiento,
  temas,
  motivos,
  autor: autorRef,
  traductor: traductorRef,
  curador,
  nota_curador,
} = props;

// Resolve referenced author entry.
const autor = await getEntry(autorRef);
if (!autor) {
  throw new Error(`Poema "${id}" referencia autor inexistente: ${autorRef.id}`);
}

// (i) Curator-author: when the author is the director (i.e. the curator),
// the "Selección de…" credit is nonsensical and the note is the author's own.
const esCuradorAutor = autor.data.tipo === 'director';

// Resolve optional translator entry. Zod has already validated the
// reference exists; we still guard against an unexpected null return.
const traductor = traductorRef ? await getEntry(traductorRef) : null;
if (traductorRef && !traductor) {
  throw new Error(
    `Poema "${id}" referencia traductor inexistente: ${traductorRef.id}`,
  );
}

// JSON-LD for the Poem entity.
const site = Astro.site!;
const jsonLd = buildPoemaJsonLd(props as Props, autor, traductor, site);

// Author dates: "1836–1870" only if both years are known.
const fnac = autor.data.nacimiento;
const fmue = autor.data.muerte;
const anios = fnac && fmue
  ? `${fnac}–${fmue}`
  : null;

// Author nationality + dates line, e.g. "mexicano · 1849–1873".
const autorNacionalidad = autor.data.nacionalidad ?? null;
const autorSubmeta = [autorNacionalidad, anios].filter(Boolean).join(' · ');

// Curator note: block-level Markdown (paragraphs, lists, blockquotes).
// `breaks: true` honours single newlines as <br>, matching El Fabulario.
const notaCuradorHtml = nota_curador
  ? (marked.parse(nota_curador, { async: false, breaks: true }) as string)
  : null;

// Curator credit (decision 11).
const creditoCurador = esCuradorAutor
  ? null
  : notaCuradorHtml
    ? `Selección y nota de ${curador}.`
    : `Selección de ${curador}.`;

// (i) Note label: the author's own note vs the curator selecting another's poem.
const rotuloNota = esCuradorAutor ? 'Nota del autor' : `Nota de ${curador}`;

// Body class: verse vs prose-poetry.
const bodyClass = tipo === 'prosa-poetica' ? 'prose' : 'prose prose--verso';

// Description for <Base>.
const descripcion = resumen ?? `Poema de ${autor.data.nombre}, en El Poemario.`;

// ── Previous / next navigation ────────────────────────────────────────────
// Build a chronological-desc list of all non-draft poemas. The current
// entry is found by id and the neighbors are selected with circular
// wrapping at both ends. Replicates NavegacionFabulas behaviour.
const todos = await getCollection('poemas', ({ data }) => !data.borrador);
todos.sort((a, b) => b.data.fecha.getTime() - a.data.fecha.getTime());

const idx = todos.findIndex((p) => p.id === id);

// idx can legitimately be -1 when this layout renders a draft (drafts
// are excluded from `todos`). In that case neighbours collapse to the
// current entry, which makes the navigation harmless but visible.
const safeIdx = idx === -1 ? 0 : idx;
const total = todos.length;
const anteriorEntry = total > 0
  ? todos[(safeIdx - 1 + total) % total]
  : null;
const siguienteEntry = total > 0
  ? todos[(safeIdx + 1) % total]
  : null;

const anterior = anteriorEntry
  ? { slug: anteriorEntry.id, titulo: anteriorEntry.data.titulo }
  : null;
const siguiente = siguienteEntry
  ? { slug: siguienteEntry.id, titulo: siguienteEntry.data.titulo }
  : null;
---

<Base titulo={`${titulo} · El Poemario`} descripcion={descripcion}>
  <JsonLd slot="head" data={jsonLd} />

  <script slot="head" is:inline>
    // Aplica el tema persistido (elp-theme) antes del primer pintado para
    // evitar flash. Solo se ejecuta en la página de poema; el resto del
    // sitio nunca fija data-theme y permanece en modo nocturno.
    (function () {
      try {
        var t = localStorage.getItem('elp-theme');
        if (t === 'pergamino') document.documentElement.setAttribute('data-theme', 'pergamino');
      } catch (e) {}
    })();
  </script>

  <article class="poema" lang="es" data-pagefind-body>
    <div class="poema-tema" data-pagefind-ignore>
      <button type="button" class="poema-tema-boton" aria-pressed="false">
        <span class="poema-tema-icono" aria-hidden="true">◑</span>
        <span class="poema-tema-texto">Pergamino</span>
      </button>
    </div>

    {ilustracion && (
      <figure class="poema-ilustracion">
        <Image
          src={ilustracion}
          alt=""
          loading="eager"
          decoding="async"
          width={1200}
          height={800}
        />
      </figure>
    )}

    <header class="poema-cabecera">
      <p class="poema-antetitulo">Poema</p>
      <h1 class="poema-titulo">{titulo}</h1>
      <p class="poema-autor">
        <a href={`/autores/${autor.id}/`}><span data-pagefind-meta="author">{autor.data.nombre}</span></a>
      </p>
      {autorSubmeta && <p class="poema-autor-submeta">{autorSubmeta}</p>}
      {traductor && (
        <p class="poema-traductor">
          Traducción de <a href={`/autores/${traductor.id}/`}>{traductor.data.nombre}</a>
        </p>
      )}
      <div class="divisor-rombo" role="presentation">
        <span class="divisor-rombo-pieza"></span>
        <span class="divisor-rombo-diamante"></span>
        <span class="divisor-rombo-pieza"></span>
      </div>
    </header>

    {spotify_url && <SpotifyEmbed url={spotify_url} />}

    <div class={bodyClass}>
      <slot />
    </div>

    {notaCuradorHtml && (
      <aside class="nota-curador" aria-label={rotuloNota}>
        <p class="nota-curador-rotulo">{rotuloNota}</p>
        <div class="nota-curador-texto" set:html={notaCuradorHtml}></div>
      </aside>
    )}

    <footer class="poema-cierre">
      {creditoCurador && <p class="poema-credito">{creditoCurador}</p>}
      <p class="poema-fecha">
        Publicado el <FormattedDate date={fecha} />
        {fecha_actualizada && (
          <span>
            {' · Actualizado el '}<FormattedDate date={fecha_actualizada} />
          </span>
        )}
      </p>
    </footer>

    <section class="poema-taxonomia" aria-label="Categorías de este poema">
      <span class="taxo-grupo">
        <span class="taxo-rotulo">Tipo</span>
        <a href={`${URL_TIPOS}/${tipo}/`} class="taxo-valor">{TIPOS_DISPLAY[tipo]}</a>
      </span>

      {movimiento && (
        <span class="taxo-grupo">
          <span class="taxo-rotulo">Movimiento</span>
          <a href={`${URL_MOVIMIENTOS}/${movimiento}/`} class="taxo-valor">
            {MOVIMIENTOS_DISPLAY[movimiento]}
          </a>
        </span>
      )}

      {temas.length > 0 && (
        <span class="taxo-grupo">
          <span class="taxo-rotulo">Temas</span>
          <span class="taxo-valores">
            {temas.map((t, i) => (
              <>
                {i > 0 && <span class="taxo-sep" aria-hidden="true">·</span>}
                <a href={`${URL_TEMAS}/${t}/`} class="taxo-valor">{TEMAS_DISPLAY[t]}</a>
              </>
            ))}
          </span>
        </span>
      )}

      {motivos.length > 0 && (
        <span class="taxo-grupo">
          <span class="taxo-rotulo">Motivos</span>
          <span class="taxo-valores">
            {motivos.map((m, i) => (
              <>
                {i > 0 && <span class="taxo-sep" aria-hidden="true">·</span>}
                <a href={`${URL_MOTIVOS}/${m}/`} class="taxo-valor">{MOTIVOS_DISPLAY[m]}</a>
              </>
            ))}
          </span>
        </span>
      )}
    </section>

    {anterior && siguiente && (
      <NavegacionPoemas anterior={anterior} siguiente={siguiente} />
    )}
  </article>

  <IconoEditar slug={id} coleccion="poemas" />

  <script is:inline>
    (function () {
      var btn = document.querySelector('.poema-tema-boton');
      if (!btn) return;
      var root = document.documentElement;
      function sync() {
        var on = root.getAttribute('data-theme') === 'pergamino';
        btn.setAttribute('aria-pressed', on ? 'true' : 'false');
        var txt = btn.querySelector('.poema-tema-texto');
        if (txt) txt.textContent = on ? 'Nocturno' : 'Pergamino';
      }
      sync();
      btn.addEventListener('click', function () {
        var on = root.getAttribute('data-theme') === 'pergamino';
        if (on) {
          root.removeAttribute('data-theme');
          try { localStorage.setItem('elp-theme', 'nocturno'); } catch (e) {}
        } else {
          root.setAttribute('data-theme', 'pergamino');
          try { localStorage.setItem('elp-theme', 'pergamino'); } catch (e) {}
        }
        sync();
      });
    })();
  </script>
</Base>

<style>
  /* ── Article wrapper ─────────────────────────────────────────────── */
  .poema {
    max-width: var(--measure);
    margin: 0 auto;
    padding-inline: var(--space-md);
  }

  /* ── Botón de tema (solo página de poema) ────────────────────────── */
  .poema-tema {
    display: flex;
    justify-content: flex-end;
    margin-bottom: var(--space-md);
  }
  .poema-tema-boton {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    background: transparent;
    border: var(--rule-hairline) solid var(--oro-suave);
    color: var(--oro-texto);
    font-family: var(--font-meta);
    font-size: var(--fs-3xs);
    letter-spacing: var(--ls-wide);
    text-transform: uppercase;
    padding: var(--space-2xs) var(--space-sm);
    cursor: pointer;
    transition:
      border-color var(--dur-fast) var(--ease-standard),
      color var(--dur-fast) var(--ease-standard);
  }
  .poema-tema-boton:hover,
  .poema-tema-boton:focus-visible {
    border-color: var(--oro);
    color: var(--oro);
  }
  .poema-tema-icono {
    font-size: 1em;
    line-height: 1;
    color: var(--accent);
  }

  /* ── Divisor de rombo (Art Déco, CSS puro) ───────────────────────── */
  .divisor-rombo {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-sm);
    margin: var(--space-lg) auto 0;
    max-width: 80%;
  }
  .divisor-rombo-pieza {
    flex: 1;
    height: 0;
    border-top: var(--rule-hairline) solid var(--oro);
    max-width: 8rem;
  }
  .divisor-rombo-diamante {
    width: 0.6rem;
    height: 0.6rem;
    flex-shrink: 0;
    transform: rotate(45deg);
    border: 1px solid var(--oro);
    background: color-mix(in srgb, var(--oro) 30%, transparent);
  }

  /* ── Illustration (sin marco) ─────────────────────────────── */
  .poema-ilustracion {
    margin: 0 0 var(--space-2xl);
  }
  .poema-ilustracion img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }

  /* ── Header ──────────────────────────────────────────────────────── */
  .poema-cabecera {
    text-align: center;
    margin-bottom: var(--space-xl);
  }
  .poema-antetitulo {
    font-family: var(--font-display);
    font-size: var(--fs-3xs);
    letter-spacing: var(--ls-widest);
    text-transform: uppercase;
    color: var(--oro-texto);
    margin: 0 0 var(--space-sm);
  }
  .poema-titulo {
    font-family: var(--font-display);
    font-size: var(--fs-3xl);
    line-height: var(--lh-snug);
    margin: 0 0 var(--space-md);
    color: var(--text);
    letter-spacing: 0.04em;
    text-wrap: balance;
  }
  .poema-autor {
    font-family: var(--font-body);
    font-style: italic;
    font-size: var(--fs-lg);
    color: var(--oro);
    margin: 0;
  }
  .poema-autor a {
    color: inherit;
    border-bottom-color: transparent;
  }
  .poema-autor a:hover,
  .poema-autor a:focus-visible {
    color: var(--link-hover);
    border-bottom-color: currentColor;
  }
  .poema-autor-submeta {
    font-family: var(--font-body);
    font-style: italic;
    font-size: var(--fs-md);
    color: var(--text-muted);
    margin: var(--space-2xs) 0 0;
  }
  .poema-traductor {
    font-family: var(--font-body);
    font-style: italic;
    font-size: var(--fs-md);
    color: var(--text-muted);
    margin: var(--space-2xs) 0 0;
  }
  .poema-traductor a {
    color: inherit;
    border-bottom-color: transparent;
  }
  .poema-traductor a:hover,
  .poema-traductor a:focus-visible {
    color: var(--link-hover);
    border-bottom-color: currentColor;
  }

  /* ── Body (verse and prose-poetry) ───────────────────────────────── */
  .prose {
    font-family: var(--font-body);
    font-size: var(--fs-md);
    line-height: 1.85;
    color: var(--text);
    max-width: var(--measure-narrow);
    margin-inline: auto;
  }
  .prose--verso :global(h2),
  .prose--verso :global(h3),
  .prose--verso :global(h4) {
    text-align: center;
    margin-block: var(--space-xl) var(--space-md);
  }
  .prose :global(h2),
  .prose :global(h3),
  .prose :global(h4) {
    color: var(--text);
  }
  .prose :global(p) {
    margin: 0 0 var(--space-lg);
  }
  .prose :global(em) {
    font-style: italic;
  }
  .prose :global(strong) {
    font-weight: var(--fw-bold);
  }
  .prose :global(a) {
    color: var(--link);
    font-style: italic;
  }
  .prose :global(blockquote) {
    margin: var(--space-lg) 0;
    padding-inline: var(--space-md);
    border-left: 2px solid var(--accent);
    font-style: italic;
    color: var(--text-soft);
  }

  /* Verse block: shrink-to-fit to the longest line and center it
     (like El Fabulario), capped at the reading measure so an
     over-long line wraps instead of stretching the column. */
  .prose--verso {
    width: max-content;
    max-width: min(var(--measure-narrow), 100%);
    margin-inline: auto;
    font-size: clamp(20px, 3.4vw, 24px);
    color: var(--verse);
  }

  /* Verse-specific: hanging indent for wrapped long lines. */
  .prose--verso :global(p) {
    margin: 0 0 1.5em;
    padding-inline-start: 2ch;
    text-indent: -2ch;
  }

  /* Prose-poetry: match the verse reading size and tone, keep prose flow. */
  .prose:not(.prose--verso) {
    font-size: clamp(20px, 3.4vw, 24px);
    color: var(--verse);
  }

  /* Prose-poetry: first-letter drop cap on the first paragraph. */
  .prose:not(.prose--verso) :global(p:first-of-type::first-letter) {
    font-family: var(--font-display);
    float: left;
    font-size: 3.4em;
    line-height: 0.85;
    padding-right: 0.08em;
    padding-top: 0.05em;
    color: var(--oro-texto);
  }

  /* ── Curator note (filete) ───────────────────────────────────────── */
  .nota-curador {
    margin: var(--space-2xl) auto 0;
    max-width: var(--measure-narrow);
    padding: var(--space-2xs) 0 var(--space-2xs) var(--space-md);
    border-left: 2px solid var(--oro);
    text-align: left;
  }
  .nota-curador-rotulo {
    font-family: var(--font-meta);
    font-size: var(--fs-3xs);
    letter-spacing: var(--ls-widest);
    text-transform: uppercase;
    color: var(--oro-texto);
    margin: 0 0 var(--space-xs);
    font-weight: var(--fw-semibold);
  }
  .nota-curador-texto {
    font-family: var(--font-body);
    font-size: var(--fs-md);
    color: var(--text-soft);
  }
  .nota-curador-texto :global(p) {
    font-style: italic;
    line-height: var(--line-height-body);
    margin: 0 0 var(--space-sm);
  }
  .nota-curador-texto :global(p:last-child) {
    margin-bottom: 0;
  }
  /* Inside an italic note, <em> flips to roman so emphasis stays visible. */
  .nota-curador-texto :global(em) {
    font-style: normal;
  }
  .nota-curador-texto :global(strong) {
    font-weight: var(--fw-bold);
  }
  .nota-curador-texto :global(a) {
    color: var(--link);
  }
  .nota-curador-texto :global(blockquote) {
    margin: var(--space-sm) 0;
    padding-inline: var(--space-md);
    border-left: 2px solid var(--oro);
  }
  .nota-curador-texto :global(ul),
  .nota-curador-texto :global(ol) {
    margin: 0 0 var(--space-sm);
    padding-inline-start: var(--space-lg);
  }
  .nota-curador-texto :global(li) {
    font-style: italic;
    line-height: var(--line-height-body);
  }

  /* ── Cierre ──────────────────────────────────────────────────────── */
  .poema-cierre {
    margin-top: var(--space-2xl);
    text-align: center;
    color: var(--text-soft);
    font-size: var(--fs-sm);
  }
  .poema-credito {
    margin: 0 0 var(--space-2xs);
    font-style: italic;
  }
  .poema-fecha {
    margin: 0;
    font-family: var(--font-meta);
    font-size: var(--fs-3xs);
    letter-spacing: var(--ls-wide);
    text-transform: uppercase;
    color: var(--text-muted);
  }

  /* ── Taxonomy footer (inline, centered) ──────────────────────────── */
  .poema-taxonomia {
    margin-top: var(--space-2xl);
    padding-top: var(--space-lg);
    border-top: var(--rule-hairline) solid var(--oro);
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: center;
    gap: var(--space-sm) var(--space-xl);
  }
  .taxo-grupo {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-xs);
  }
  .taxo-rotulo {
    font-family: var(--font-meta);
    font-size: var(--fs-xs);
    letter-spacing: var(--ls-wider);
    text-transform: uppercase;
    color: var(--oro-texto);
    font-weight: var(--fw-semibold);
  }
  .taxo-valores {
    display: inline;
  }
  .taxo-sep {
    color: var(--oro-suave);
    margin: 0 var(--space-3xs);
  }
  .taxo-valor {
    font-family: var(--font-body);
    font-size: var(--fs-md);
    color: var(--link);
    text-decoration: none;
    border-bottom: var(--rule-hairline) solid transparent;
    transition:
      border-color var(--dur-fast) var(--ease-standard),
      color var(--dur-fast) var(--ease-standard);
  }
  .taxo-valor:hover,
  .taxo-valor:focus-visible {
    color: var(--link-hover);
    border-bottom-color: currentColor;
  }

  @media (max-width: 640px) {
    .poema-taxonomia {
      flex-direction: column;
      align-items: center;
      gap: var(--space-sm);
    }
  }
</style>