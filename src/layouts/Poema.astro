---
import type { CollectionEntry } from 'astro:content';
import { getCollection, getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { marked } from 'marked';

import Base from './Base.astro';
import JsonLd from '../components/JsonLd.astro';
import FormattedDate from '../components/FormattedDate.astro';
import SpotifyEmbed from '../components/SpotifyEmbed.astro';
import NavegacionPoemas from '../components/NavegacionPoemas.astro';
import IconoEditar from '../components/IconoEditar.astro';

import { buildPoemaJsonLd } from '../utils/jsonld';
import {
  TIPOS_DISPLAY,
  MOVIMIENTOS_DISPLAY,
  TEMAS_DISPLAY,
  MOTIVOS_DISPLAY,
  URL_TIPOS,
  URL_MOVIMIENTOS,
  URL_TEMAS,
  URL_MOTIVOS,
  URL_NACIONALIDADES,
  URL_SIGLOS,
  sigloDeNacimiento,
  intARomano,
  paisASlug,
} from '../utils/taxonomia';

// Receives the poema's frontmatter spread plus its id (slug). Same
// pattern as Fabula.astro in El Fabulario.
type Props = CollectionEntry<'poemas'>['data'] & { id: string };

const props = Astro.props;
const {
  id,
  titulo,
  resumen,
  fecha,
  fecha_actualizada,
  ilustracion,
  spotify_url,
  tipo,
  movimiento,
  temas,
  motivos,
  autor: autorRef,
  traductor: traductorRef,
  curador,
  nota_curador,
} = props;

// Resolve referenced author entry.
const autor = await getEntry(autorRef);
if (!autor) {
  throw new Error(`Poema "${id}" referencia autor inexistente: ${autorRef.id}`);
}

// (i) Curator-author: when the author is the director (i.e. the curator),
// the "Selección de…" credit is nonsensical and the note is the author's own.
const esCuradorAutor = autor.data.tipo === 'director';

// Resolve optional translator entry. Zod has already validated the
// reference exists; we still guard against an unexpected null return.
const traductor = traductorRef ? await getEntry(traductorRef) : null;
if (traductorRef && !traductor) {
  throw new Error(
    `Poema "${id}" referencia traductor inexistente: ${traductorRef.id}`,
  );
}

// JSON-LD for the Poem entity.
const site = Astro.site!;
const jsonLd = buildPoemaJsonLd(props as Props, autor, traductor, site);

// ── Ficha de 4 columnas (handoff): Forma · Movimiento · Siglo · País ────────
// Cada celda enlaza a su faceta cuando existe (preserva la navegación que antes
// daba la taxonomía inline y añade siglo/país). El siglo se deriva del año de
// nacimiento del autor; el país es su `nacionalidad` (proper noun literal).
const sigloNum = sigloDeNacimiento(autor.data.nacimiento);
const sigloRomano = sigloNum ? intARomano(sigloNum) : null;
const pais = autor.data.nacionalidad ?? null;

const ficha: { rotulo: string; valor: string | null; href: string | null }[] = [
  { rotulo: 'Forma', valor: TIPOS_DISPLAY[tipo], href: `${URL_TIPOS}/${tipo}/` },
  {
    rotulo: 'Movimiento',
    valor: movimiento ? MOVIMIENTOS_DISPLAY[movimiento] : null,
    href: movimiento ? `${URL_MOVIMIENTOS}/${movimiento}/` : null,
  },
  {
    rotulo: 'Siglo',
    valor: sigloRomano,
    href: sigloRomano ? `${URL_SIGLOS}/${sigloRomano.toLowerCase()}/` : null,
  },
  {
    rotulo: 'País',
    valor: pais,
    href: pais ? `${URL_NACIONALIDADES}/${paisASlug(pais)}/` : null,
  },
];

// Theme + motif chips (handoff), all linked to their facet pages.
const chips = [
  ...temas.map((t) => ({ label: TEMAS_DISPLAY[t], href: `${URL_TEMAS}/${t}/` })),
  ...motivos.map((m) => ({ label: MOTIVOS_DISPLAY[m], href: `${URL_MOTIVOS}/${m}/` })),
];

// Curator note: block-level Markdown (paragraphs, lists, blockquotes).
// `breaks: true` honours single newlines as <br>, matching El Fabulario.
const notaCuradorHtml = nota_curador
  ? (marked.parse(nota_curador, { async: false, breaks: true }) as string)
  : null;

// Curator credit (decision 11).
const creditoCurador = esCuradorAutor
  ? null
  : notaCuradorHtml
    ? `Selección y nota de ${curador}.`
    : `Selección de ${curador}.`;

// (i) Note label: the author's own note vs the curator selecting another's poem.
const rotuloNota = esCuradorAutor ? 'Nota del autor' : `Nota de ${curador}`;

// Body class: verse vs prose-poetry.
const bodyClass = tipo === 'prosa-poetica' ? 'prose' : 'prose prose--verso';

// Description for <Base>.
const descripcion = resumen ?? `Poema de ${autor.data.nombre}, en El Poemario.`;

// ── Previous / next navigation ────────────────────────────────────────────
// Build a chronological-desc list of all non-draft poemas. The current
// entry is found by id and the neighbors are selected with circular
// wrapping at both ends. Replicates NavegacionFabulas behaviour.
const todos = await getCollection('poemas', ({ data }) => !data.borrador);
todos.sort((a, b) => b.data.fecha.getTime() - a.data.fecha.getTime());

const idx = todos.findIndex((p) => p.id === id);

// idx can legitimately be -1 when this layout renders a draft (drafts
// are excluded from `todos`). In that case neighbours collapse to the
// current entry, which makes the navigation harmless but visible.
const safeIdx = idx === -1 ? 0 : idx;
const total = todos.length;
const anteriorEntry = total > 0
  ? todos[(safeIdx - 1 + total) % total]
  : null;
const siguienteEntry = total > 0
  ? todos[(safeIdx + 1) % total]
  : null;

const anterior = anteriorEntry
  ? { slug: anteriorEntry.id, titulo: anteriorEntry.data.titulo }
  : null;
const siguiente = siguienteEntry
  ? { slug: siguienteEntry.id, titulo: siguienteEntry.data.titulo }
  : null;
---

<Base titulo={`${titulo} · El Poemario`} descripcion={descripcion} heroInmersivo={!!ilustracion}>
  <JsonLd slot="head" data={jsonLd} />

  {ilustracion && (
    <div class="poema-hero" slot="hero">
      <Image
        src={ilustracion}
        alt=""
        class="poema-hero-img"
        widths={[768, 1280, 1920]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
      <div class="poema-hero-degradado" aria-hidden="true"></div>
      <div class="poema-hero-contenido page">
        <p class="poema-hero-kicker">{TIPOS_DISPLAY[tipo]}</p>
        <h1 class="poema-hero-titulo">{titulo}</h1>
        <p class="poema-hero-autor">
          <a href={`/autores/${autor.id}/`}>{autor.data.nombre}</a>
        </p>
        {traductor && (
          <p class="poema-hero-traductor">
            Traducción de <a href={`/autores/${traductor.id}/`}>{traductor.data.nombre}</a>
          </p>
        )}
      </div>
    </div>
  )}

  <article class:list={['poema', { 'poema--con-hero': !!ilustracion }]} lang="es" data-pagefind-body>
    <p class="poema-backlink">
      <a href="/poemas/">← Catálogo</a>
    </p>

    {ilustracion ? (
      /* Con hero inmersivo, el título y el autor viven sobre la imagen (fuera
         de este [data-pagefind-body]). Preservamos el meta de búsqueda con
         spans ocultos, como en las cartas de la bitácora. */
      <>
        <span hidden data-pagefind-meta="title">{titulo}</span>
        <span hidden data-pagefind-meta="author">{autor.data.nombre}</span>
      </>
    ) : (
      <header class="poema-cabecera">
        <p class="poema-kicker">{TIPOS_DISPLAY[tipo]}</p>
        <h1 class="poema-titulo">{titulo}</h1>
        <p class="poema-autor">
          <a href={`/autores/${autor.id}/`}><span data-pagefind-meta="author">{autor.data.nombre}</span></a>
        </p>
        {traductor && (
          <p class="poema-traductor">
            Traducción de <a href={`/autores/${traductor.id}/`}>{traductor.data.nombre}</a>
          </p>
        )}
      </header>
    )}

    <dl class="poema-ficha">
      {ficha.map((celda) => (
        <div class="ficha-celda">
          <dt class="ficha-rotulo">{celda.rotulo}</dt>
          <dd class="ficha-valor">
            {celda.valor
              ? (celda.href ? <a href={celda.href}>{celda.valor}</a> : celda.valor)
              : '—'}
          </dd>
        </div>
      ))}
    </dl>

    {spotify_url && <SpotifyEmbed url={spotify_url} />}

    <div class={bodyClass}>
      <slot />
    </div>

    <div class="divisor" aria-hidden="true"><span></span><span></span><span></span></div>

    {notaCuradorHtml && (
      <aside class="nota-curador" aria-label={rotuloNota}>
        <p class="nota-curador-rotulo">{rotuloNota}</p>
        <div class="nota-curador-texto" set:html={notaCuradorHtml}></div>
      </aside>
    )}

    {chips.length > 0 && (
      <nav class="poema-chips" aria-label="Temas y motivos de este poema">
        {chips.map((c) => (
          <a class="poema-chip" href={c.href}>{c.label}</a>
        ))}
      </nav>
    )}

    <footer class="poema-cierre">
      {creditoCurador && <p class="poema-credito">{creditoCurador}</p>}
      <p class="poema-fecha">
        Publicado el <FormattedDate date={fecha} />
        {fecha_actualizada && (
          <span>
            {' · Actualizado el '}<FormattedDate date={fecha_actualizada} />
          </span>
        )}
      </p>
    </footer>

    {anterior && siguiente && (
      <NavegacionPoemas anterior={anterior} siguiente={siguiente} />
    )}
  </article>

  <IconoEditar slug={id} coleccion="poemas" />
</Base>

<style>
  /* ── Article wrapper ─────────────────────────────────────────────────
     Más ancho que la columna de lectura: la cabecera, la ficha y la
     ilustración se despliegan a lo ancho (handoff), mientras que el cuerpo
     del poema, la nota y el cierre se estrechan y centran para leer bien. */
  .poema {
    max-width: var(--measure-wide);
    margin: 0 auto;
    padding-inline: var(--space-md);
  }
  /* Tras un hero inmersivo, .site-main pierde su padding superior; el artículo
     recupera aquí el respiro para no pegar el back-link a la imagen. */
  .poema--con-hero {
    padding-top: var(--space-2xl);
  }

  /* ── Hero inmersivo (poema con imagen, handoff 4a) ───────────────────
     Ilustración a sangre 740px con la nav flotando encima (Base) y el título
     anclado abajo sobre el degradado. Colores fijos claros (--hero-*),
     legibles en día y noche. Sustituye al antiguo passe-partout enmarcado. */
  .poema-hero {
    position: relative;
    height: 740px;
    overflow: hidden;
  }
  .poema-hero-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 30%;
  }
  .poema-hero-degradado {
    position: absolute;
    inset: 0;
    background: var(--hero-gradiente);
  }
  /* Bloque de título anclado abajo, centrado dentro del contenedor de página
     (.page aporta max-width + margen auto + gutter lateral). */
  .poema-hero-contenido {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding-bottom: var(--space-2xl);
    text-align: center;
  }
  .poema-hero-kicker {
    font-family: var(--font-meta);
    font-size: var(--fs-3xs);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-widest);
    text-transform: uppercase;
    color: var(--hero-accent);
    margin: 0 0 var(--space-sm);
  }
  .poema-hero-titulo {
    font-family: var(--font-body);
    font-weight: 500;
    font-size: var(--fs-4xl);
    line-height: 1.02;
    letter-spacing: 0;
    text-transform: none;
    color: var(--hero-title);
    margin: 0 0 var(--space-sm);
    text-shadow: 0 2px 24px rgba(0, 0, 0, 0.5);
    text-wrap: balance;
  }
  .poema-hero-autor {
    font-family: var(--font-body);
    font-style: italic;
    font-size: var(--fs-lg);
    color: var(--hero-accent);
    margin: 0;
  }
  .poema-hero-autor a {
    color: inherit;
    border-bottom-color: transparent;
  }
  .poema-hero-autor a:hover,
  .poema-hero-autor a:focus-visible {
    color: var(--hero-title);
    border-bottom-color: currentColor;
  }
  .poema-hero-traductor {
    font-family: var(--font-body);
    font-style: italic;
    font-size: var(--fs-md);
    color: var(--hero-ink-soft);
    margin: var(--space-2xs) 0 0;
  }
  .poema-hero-traductor a {
    color: inherit;
    border-bottom-color: transparent;
  }
  .poema-hero-traductor a:hover,
  .poema-hero-traductor a:focus-visible {
    color: var(--hero-title);
    border-bottom-color: currentColor;
  }
  @media (max-width: 900px) {
    .poema-hero {
      height: 520px;
    }
  }

  /* ── Back-link «← Catálogo» ───────────────────────────────────────── */
  .poema-backlink {
    margin: 0 0 var(--space-lg);
  }
  .poema-backlink a {
    font-family: var(--font-meta);
    font-size: var(--fs-3xs);
    letter-spacing: var(--ls-wider);
    text-transform: uppercase;
    color: var(--oro-texto);
    text-decoration: none;
    border-bottom: none;
    transition: color var(--dur-fast) var(--ease-standard);
  }
  .poema-backlink a:hover,
  .poema-backlink a:focus-visible {
    color: var(--oro);
    border-bottom: none;
  }

  /* ── Header ──────────────────────────────────────────────────────────
     Kicker (forma) + título en Cormorant caja mixta (handoff) + autor. */
  .poema-cabecera {
    text-align: center;
    margin-bottom: var(--space-xl);
    padding-bottom: var(--space-lg);
    border-bottom: 1px solid var(--rule);
  }
  .poema-kicker {
    font-family: var(--font-meta);
    font-size: var(--fs-3xs);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-widest);
    text-transform: uppercase;
    color: var(--oro-texto);
    margin: 0 0 var(--space-md);
  }
  .poema-titulo {
    font-family: var(--font-body);
    font-weight: 500;
    font-size: var(--fs-3xl);
    line-height: 1.05;
    letter-spacing: 0;
    text-transform: none;
    margin: 0 0 var(--space-sm);
    color: var(--text);
    text-wrap: balance;
  }
  .poema-autor {
    font-family: var(--font-body);
    font-style: italic;
    font-size: var(--fs-lg);
    color: var(--oro);
    margin: 0;
  }
  .poema-autor a {
    color: inherit;
    border-bottom-color: transparent;
  }
  .poema-autor a:hover,
  .poema-autor a:focus-visible {
    color: var(--link-hover);
    border-bottom-color: currentColor;
  }
  .poema-traductor {
    font-family: var(--font-body);
    font-style: italic;
    font-size: var(--fs-md);
    color: var(--text-muted);
    margin: var(--space-2xs) 0 0;
  }
  .poema-traductor a {
    color: inherit;
    border-bottom-color: transparent;
  }
  .poema-traductor a:hover,
  .poema-traductor a:focus-visible {
    color: var(--link-hover);
    border-bottom-color: currentColor;
  }

  /* ── Ficha de 4 columnas ─────────────────────────────────────────────
     Forma · Movimiento · Siglo · País, con filetes finos entre celdas. */
  .poema-ficha {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    margin: 0 0 var(--space-2xl);
    border-bottom: 1px solid var(--rule);
  }
  .ficha-celda {
    padding: var(--space-md) var(--space-sm);
    text-align: center;
    border-right: 1px solid var(--rule-soft);
  }
  .ficha-celda:last-child {
    border-right: none;
  }
  .ficha-rotulo {
    font-family: var(--font-meta);
    font-size: var(--fs-3xs);
    letter-spacing: var(--ls-wide);
    text-transform: uppercase;
    color: var(--text-faint);
    margin: 0 0 var(--space-2xs);
  }
  .ficha-valor {
    font-family: var(--font-body);
    font-size: var(--fs-lg);
    color: var(--text);
    margin: 0;
  }
  .ficha-valor a {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition:
      color var(--dur-fast) var(--ease-standard),
      border-color var(--dur-fast) var(--ease-standard);
  }
  .ficha-valor a:hover,
  .ficha-valor a:focus-visible {
    color: var(--oro-texto);
    border-bottom-color: currentColor;
  }

  /* ── Body (verse and prose-poetry) ───────────────────────────────── */
  .prose {
    font-family: var(--font-body);
    font-size: var(--fs-md);
    line-height: var(--lh-poema);
    color: var(--text);
    max-width: var(--measure-narrow);
    margin-inline: auto;
  }
  .prose--verso :global(h2),
  .prose--verso :global(h3),
  .prose--verso :global(h4),
  .prose--verso :global(h5),
  .prose--verso :global(h6) {
    text-align: center;
  }
  /* Subtitulos del cuerpo (h2-h6, editables en Decap) = voz literaria (§25):
     Cormorant Garamond, NO Cinzel; jerarquia por tamano -> italica -> color.
     Mismo sistema que en las entradas de la bitacora. */
  .prose :global(h2) {
    font-family: var(--font-body);
    font-weight: var(--fw-semibold);
    font-size: var(--fs-xl);
    font-style: normal;
    line-height: var(--lh-snug);
    letter-spacing: 0;
    color: var(--text);
    margin-block: var(--space-xl) var(--space-sm);
    text-wrap: balance;
  }
  .prose :global(h3) {
    font-family: var(--font-body);
    font-weight: var(--fw-semibold);
    font-size: var(--fs-lg);
    font-style: normal;
    line-height: var(--lh-snug);
    letter-spacing: 0;
    color: var(--text);
    margin-block: var(--space-lg) var(--space-sm);
    text-wrap: balance;
  }
  .prose :global(h4) {
    font-family: var(--font-body);
    font-weight: var(--fw-semibold);
    font-size: var(--fs-md);
    font-style: normal;
    letter-spacing: 0;
    color: var(--text);
    margin-block: var(--space-lg) var(--space-xs);
  }
  .prose :global(h5) {
    font-family: var(--font-body);
    font-weight: var(--fw-semibold);
    font-size: var(--fs-base);
    font-style: italic;
    letter-spacing: 0;
    color: var(--text);
    margin-block: var(--space-md) var(--space-xs);
  }
  .prose :global(h6) {
    font-family: var(--font-body);
    font-weight: var(--fw-semibold);
    font-size: var(--fs-sm);
    font-style: italic;
    letter-spacing: 0;
    color: var(--text-muted);
    margin-block: var(--space-md) var(--space-xs);
  }
  .prose :global(p) {
    margin: 0 0 var(--space-lg);
  }
  .prose :global(em) {
    font-style: italic;
  }
  .prose :global(strong) {
    font-weight: var(--fw-bold);
  }
  .prose :global(a) {
    color: var(--link);
    font-style: italic;
  }
  .prose :global(blockquote) {
    margin: var(--space-lg) 0;
    padding-inline: var(--space-md);
    border-left: 2px solid var(--accent);
    font-style: italic;
    color: var(--text-soft);
  }

  /* Verse block: shrink-to-fit to the longest line and center it
     (like El Fabulario), capped at the reading measure so an
     over-long line wraps instead of stretching the column. */
  .prose--verso {
    width: max-content;
    max-width: min(var(--measure-narrow), 100%);
    margin-inline: auto;
    font-size: var(--fs-poema);
    color: var(--verse);
  }

  /* Verse-specific: hanging indent for wrapped long lines. */
  .prose--verso :global(p) {
    margin: 0 0 1.5em;
    padding-inline-start: 2ch;
    text-indent: -2ch;
  }

  /* Prose-poetry: match the verse reading size and tone, keep prose flow. */
  .prose:not(.prose--verso) {
    font-size: var(--fs-poema);
    color: var(--verse);
  }

  /* Prose-poetry: first-letter drop cap on the first paragraph. */
  .prose:not(.prose--verso) :global(p:first-of-type::first-letter) {
    font-family: var(--font-display);
    float: left;
    font-size: 3.4em;
    line-height: 0.85;
    padding-right: 0.08em;
    padding-top: 0.05em;
    color: var(--oro-texto);
  }

  /* Rombo divisor bajo el cuerpo del poema (handoff). */
  .poema .divisor {
    margin-block: var(--space-2xl);
  }

  /* ── Curator note (filete) ───────────────────────────────────────── */
  .nota-curador {
    margin: var(--space-2xl) auto 0;
    max-width: var(--measure-narrow);
    padding: var(--space-2xs) 0 var(--space-2xs) var(--space-md);
    border-left: 2px solid var(--oro);
    text-align: left;
  }
  .nota-curador-rotulo {
    font-family: var(--font-meta);
    font-size: var(--fs-3xs);
    letter-spacing: var(--ls-widest);
    text-transform: uppercase;
    color: var(--oro-texto);
    margin: 0 0 var(--space-xs);
    font-weight: var(--fw-semibold);
  }
  .nota-curador-texto {
    font-family: var(--font-body);
    font-size: var(--fs-md);
    color: var(--text-soft);
  }
  .nota-curador-texto :global(p) {
    font-style: italic;
    line-height: var(--line-height-body);
    margin: 0 0 var(--space-sm);
  }
  .nota-curador-texto :global(p:last-child) {
    margin-bottom: 0;
  }
  /* Inside an italic note, <em> flips to roman so emphasis stays visible. */
  .nota-curador-texto :global(em) {
    font-style: normal;
  }
  .nota-curador-texto :global(strong) {
    font-weight: var(--fw-bold);
  }
  .nota-curador-texto :global(a) {
    color: var(--link);
  }
