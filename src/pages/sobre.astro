---
import Base from '../layouts/Base.astro';
import { getPagina } from '../utils/paginas';
import { render } from 'astro:content';

// Page heading + body come from src/content/paginas/sobre.md (editable in
// Decap). The browser tab <title> stays hardcoded by design: the h1 already
// contains "El Poemario", so deriving the <title> would read redundantly.
const pagina = await getPagina('sobre');
const { rotulo, titulo, subtitulo, descripcion } = pagina.data;
const { Content } = await render(pagina);
---

<Base titulo="Acerca de · El Poemario" descripcion={descripcion}>
  <div class="sobre">
    <header class="title">
      {rotulo && <p class="rotulo">{rotulo}</p>}
      <h1>{titulo}</h1>
      {subtitulo && <p class="subtitulo">{subtitulo}</p>}
    </header>

    <div class="divisor" aria-hidden="true"><span></span><span></span><span></span></div>

    <section class="prose">
      <Content />
    </section>
  </div>
</Base>

<style>
  .sobre {
  }
  .title {
    text-align: center;
    margin-bottom: var(--space-md);
  }
  .title h1 {
    margin: 0;
    font-family: var(--font-body);
    font-weight: 500;
    font-size: var(--fs-3xl);
    text-transform: none;
    letter-spacing: 0;
    text-wrap: balance;
  }
  .prose {
    max-width: var(--measure-grid);
    margin-inline: auto;
  }
  /* Body is rendered from markdown via <Content/>, so its inner elements
     are not processed by Astro's scoped-style compiler. Target them
     globally, anchored on the scoped .prose wrapper. */
  /* Encabezado de seccion en voz literaria (§26): Cormorant Garamond, no Cinzel.
     Se conserva el centrado propio de esta pagina editorial. */
  .prose :global(h2) {
    font-family: var(--font-body);
    font-size: var(--fs-xl);
    font-weight: var(--fw-semibold);
    font-style: normal;
    letter-spacing: 0;
    text-align: center;
    margin: var(--space-xl) 0 var(--space-lg);
    text-wrap: balance;
  }
  .prose :global(p) {
    font-family: var(--font-prose);
    font-size: var(--fs-prosa);
    line-height: var(--lh-prosa);
    margin-bottom: var(--space-md);
  }
  /* Epígrafes/citas del cuerpo (sobre.md) → cita central grande en cursiva
     Cormorant (handoff §9), sin filete lateral. La fuente/atribución va en
     Cinzel oro debajo. Cubre tanto la cita con .cita/.fuente como la
     dedicatoria (párrafos sueltos dentro de .epigrafe). */
  .prose :global(.epigrafe) {
    max-width: var(--measure);
    margin: var(--space-2xl) auto;
    padding: 0;
    border: 0;
    text-align: center;
  }
  .prose :global(.epigrafe p),
  .prose :global(.epigrafe .cita) {
    font-family: var(--font-body);
    font-style: italic;
    font-size: var(--fs-2xl);
    line-height: var(--lh-snug);
    color: var(--text);
    margin: 0 0 var(--space-xs);
  }
  .prose :global(.epigrafe .fuente) {
    font-family: var(--font-display);
    font-style: normal;
    font-size: var(--fs-3xs);
    letter-spacing: var(--ls-wider);
    text-transform: uppercase;
    color: var(--oro-texto);
    margin: var(--space-sm) 0 0;
  }

</style>