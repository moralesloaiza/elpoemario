---
import Base from '../layouts/Base.astro';
import { getPagina } from '../utils/paginas';
import { render } from 'astro:content';

// Page heading + body come from src/content/paginas/sobre.md (editable in
// Decap). The browser tab <title> stays hardcoded by design: the h1 already
// contains "El Poemario", so deriving the <title> would read redundantly.
const pagina = await getPagina('sobre');
const { titulo, descripcion } = pagina.data;
const { Content } = await render(pagina);
---

<Base titulo="Acerca de · El Poemario" descripcion={descripcion}>
  <div class="sobre">
    <header class="title">
      <h1>{titulo}</h1>
    </header>

    <div class="divisor-rombo" role="presentation">
        <span class="divisor-rombo-pieza"></span>
        <span class="divisor-rombo-diamante"></span>
        <span class="divisor-rombo-pieza"></span>
      </div>

    <section class="prose">
      <Content />
    </section>
  </div>
</Base>

<style>
  .sobre {
  }
  .title {
    text-align: center;
    margin-bottom: var(--space-md);
  }
  .title h1 {
    margin: 0;
    font-size: var(--fs-3xl);
    text-wrap: balance;
  }
  .prose {
    max-width: var(--measure);
    margin-inline: auto;
  }
  /* Body is rendered from markdown via <Content/>, so its inner elements
     are not processed by Astro's scoped-style compiler. Target them
     globally, anchored on the scoped .prose wrapper. */
  .prose :global(h2) {
    font-family: var(--font-display);
    font-size: var(--fs-xl);
    font-weight: var(--fw-semibold);
    text-align: center;
    margin: var(--space-xl) 0 var(--space-lg);
    text-wrap: balance;
  }
  .prose :global(p) {
    font-size: var(--fs-md);
    line-height: var(--lh-relaxed);
    margin-bottom: var(--space-md);
  }
  .prose :global(.dedicatoria) {
    font-style: italic;
    color: var(--text-soft);
    border-left: var(--rule-hairline) solid var(--oro);
    padding-left: var(--space-md);
    margin: var(--space-lg) 0 var(--space-lg) var(--space-md);
  }
  .prose :global(.dedicatoria p:first-child) {
    margin-bottom: 0;
  }
  .prose :global(.firma) {
    text-align: right;
    font-style: italic;
    color: var(--oro-texto);
    margin-top: var(--space-2xl);
  }

  .divisor-rombo {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-sm);
    margin: 0 auto var(--space-2xl);
    max-width: 80%;
  }
  .divisor-rombo-pieza {
    flex: 1;
    height: 0;
    border-top: var(--rule-hairline) solid var(--oro);
    max-width: 8rem;
  }
  .divisor-rombo-diamante {
    width: 0.6rem;
    height: 0.6rem;
    flex-shrink: 0;
    transform: rotate(45deg);
    border: 1px solid var(--oro);
    background: color-mix(in srgb, var(--oro) 30%, transparent);
  }
</style>