---
import { getCollection } from 'astro:content';

import Base from '../../layouts/Base.astro';
import ChipsFacetas from '../../components/ChipsFacetas.astro';
import FilaPoema from '../../components/FilaPoema.astro';

import { SITE_TITLE } from '../../consts';
import { getPagina } from '../../utils/paginas';

// All non-draft poems, newest first. Full anthology, no pagination in v1.
// For ~86 Bécquer Rimas a flat list is fine. Revisit when the corpus
// grows to several hundred entries.
const poemas = (await getCollection('poemas', ({ data }) => !data.borrador)).sort(
  (a, b) => b.data.fecha.getTime() - a.data.fecha.getTime(),
);

// Author names and countries live in the `autores` collection; the `autor`
// field on a poem is a reference. Build id->name and id->country maps once so
// the list renders without per-row awaits. `nacionalidad` stores the country
// verbatim ("Chile", "España"…) — that is the "lugar" column of the catalog.
const autoresLista = await getCollection('autores');
const autoresPorId = new Map(autoresLista.map((a) => [a.id, a.data.nombre]));
const paisPorId = new Map(autoresLista.map((a) => [a.id, a.data.nacionalidad]));

const pagina = await getPagina('poemas');
---

<Base
  titulo={`${pagina.data.titulo} · ${SITE_TITLE}`}
  descripcion={pagina.data.descripcion}
>
  <section class="indice" aria-labelledby="indice-titulo">
    <header class="title">
      {pagina.data.rotulo && <p class="rotulo">{pagina.data.rotulo}</p>}
      <h1 id="indice-titulo">{pagina.data.titulo}</h1>
      <p class="subtitulo">{pagina.data.subtitulo}</p>
    </header>

    <ChipsFacetas />

    {poemas.length === 0 ? (
      <p class="vacio">Aún no hay poemas publicados.</p>
    ) : (
      <ul class="catalogo">
        {poemas.map((poema, i) => (
          <FilaPoema
            poema={poema}
            autorNombre={autoresPorId.get(poema.data.autor.id) ?? ''}
            indice={i + 1}
            lugar={paisPorId.get(poema.data.autor.id)}
            encabezado="h2"
          />
        ))}
      </ul>
    )}
  </section>
</Base>

<style>
  .title {
    text-align: center;
    margin-bottom: var(--space-md);
  }
  .title h1 {
    margin: 0;
    font-size: var(--fs-3xl);
  }

  .vacio {
    text-align: center;
    font-style: italic;
    color: var(--text-soft);
    margin-top: var(--space-2xl);
  }

  /* Catálogo como lista de filas compartidas (FilaPoema): nº · (título +
     autor) · etiqueta · lugar. Cada fila trae su propio filete superior. */
  .catalogo {
    list-style: none;
    margin: 0;
    padding: 0;
  }
</style>
