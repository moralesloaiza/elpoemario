---
import Base from '../layouts/Base.astro';
import { getPagina } from '../utils/paginas';
import { render } from 'astro:content';

// Page heading + body come from src/content/paginas/colaborar.md (editable
// in Decap). External links in the body open in a new tab via the global
// rehype-external-links plugin. The browser tab <title> stays hardcoded by
// design (the h1 already contains "El Poemario").
const pagina = await getPagina('colaborar');
const { rotulo, titulo, subtitulo, descripcion } = pagina.data;
const { Content } = await render(pagina);
---

<Base titulo="Colaborar · El Poemario" descripcion={descripcion}>
  <div class="colaborar">
    <header class="title">
      {rotulo && <p class="rotulo">{rotulo}</p>}
      <h1>{titulo}</h1>
      {subtitulo && <p class="subtitulo">{subtitulo}</p>}
    </header>

    <div class="divisor" aria-hidden="true"><span></span><span></span><span></span></div>

    <section class="prose">
      <Content />
    </section>

    <div class="acciones">
      <a class="boton-galon" href="mailto:alejandro@elpoemario.com">Escribir al curador</a>
    </div>
  </div>
</Base>

<style>
  .title {
    text-align: center;
    margin-bottom: var(--space-md);
  }
  .title h1 {
    margin: 0;
    font-family: var(--font-body);
    font-weight: 500;
    font-size: var(--fs-3xl);
    text-transform: none;
    letter-spacing: 0;
    text-wrap: balance;
  }
  .prose {
    max-width: var(--measure-grid);
    margin-inline: auto;
  }
  /* Body is rendered from markdown via <Content/>; target inner elements
     globally, anchored on the scoped .prose wrapper. */
  .prose :global(p) {
    font-family: var(--font-prose);
    font-size: var(--fs-prosa);
    line-height: var(--lh-prosa);
    margin-bottom: var(--space-md);
  }
  .prose :global(h2) {
    font-family: var(--font-display);
    font-size: var(--fs-xl);
    font-weight: var(--fw-semibold);
    text-align: center;
    margin: var(--space-xl) 0 var(--space-lg);
    text-wrap: balance;
  }
  .prose :global(h3) {
    font-family: var(--font-display);
    font-size: var(--fs-md);
    font-weight: var(--fw-semibold);
    margin-top: var(--space-lg);
    margin-bottom: var(--space-xs);
  }
  .prose :global(ol) {
    margin-bottom: var(--space-md);
    padding-left: 1.5em;
  }
  .prose :global(ol li) {
    font-family: var(--font-prose);
    font-size: var(--fs-prosa);
    line-height: var(--lh-prosa);
    margin-bottom: var(--space-2xs);
  }
  .prose :global(code) {
    font-family: ui-monospace, monospace;
    font-size: 0.9em;
    padding: 0.1em 0.3em;
    background: var(--bg-elevated);
    border-radius: 3px;
  }
  .acciones {
    margin-top: var(--space-xl);
    text-align: center;
  }
  /* CTA primario en tinta solida (handoff): fondo --btn-bg, texto --btn-ink.
     Hover invierte a contorno; el borde se mantiene para no alterar la caja. */
  .boton-galon {
    display: inline-block;
    font-family: var(--font-meta);
    font-size: var(--fs-2xs);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-wider);
    text-transform: uppercase;
    color: var(--btn-ink);
    background: var(--btn-bg);
    text-decoration: none;
    border: 1px solid var(--btn-bg);
    padding: 0.85em 1.75em;
    transition: background var(--dur-fast) var(--ease-standard),
      color var(--dur-fast) var(--ease-standard);
  }
  .boton-galon:hover,
  .boton-galon:focus-visible {
    background: transparent;
    color: var(--btn-bg);
    border-bottom: 1px solid var(--btn-bg);
  }

</style>