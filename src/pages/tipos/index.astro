---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ChipsFacetas from '../../components/ChipsFacetas.astro';
import GrillaTerminos from '../../components/GrillaTerminos.astro';
import { TIPOS_DISPLAY, type Tipo } from '../../utils/taxonomia';

import { SITE_TITLE } from '../../consts';
import { getPagina } from '../../utils/paginas';

const poemas = await getCollection('poemas', ({ data }) => !data.borrador);

// Count poemas per tipo (single-select, required). Only tipos with >=1
// published poema appear in the index.
const conteo = new Map<Tipo, number>();
for (const p of poemas) {
  const k = p.data.tipo;
  conteo.set(k, (conteo.get(k) ?? 0) + 1);
}

// Sort by count desc, alphabetical Spanish as tiebreaker.
const items = Array.from(conteo.entries())
  .map(([slug, n]) => ({ href: `/tipos/${slug}/`, conteo: n, display: TIPOS_DISPLAY[slug] }))
  .sort((a, b) => {
    if (b.conteo !== a.conteo) return b.conteo - a.conteo;
    return a.display.localeCompare(b.display, 'es');
  });

const pagina = await getPagina('tipos');
---

<Base
  titulo={`${pagina.data.titulo} · ${SITE_TITLE}`}
  descripcion={pagina.data.descripcion}
>
  <div class="indice">
    <header class="title">
      {pagina.data.rotulo && <p class="rotulo">{pagina.data.rotulo}</p>}
      <h1>{pagina.data.titulo}</h1>
      <p class="subtitulo">{pagina.data.subtitulo}</p>
    </header>

    <ChipsFacetas activa="forma" />

    <GrillaTerminos items={items} unidad="poema" />
  </div>
</Base>

<style>
  .title {
    text-align: center;
    margin-bottom: var(--space-md);
  }
  .title h1 {
    margin: 0;
    font-size: var(--fs-3xl);
  }
</style>