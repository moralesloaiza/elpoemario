---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import JsonLd from '../../components/JsonLd.astro';
import ListadoPoemasTaxonomia from '../../components/ListadoPoemasTaxonomia.astro';
import { buildBreadcrumbJsonLd } from '../../utils/jsonld';
import { MOTIVOS_DISPLAY, type Motivo } from '../../utils/taxonomia';

export async function getStaticPaths() {
  const poemas = await getCollection('poemas', ({ data }) => !data.borrador);
  const autores = await getCollection('autores');
  const autorMap = new Map(autores.map((a) => [a.id, a.data.nombre]));

  // Group by `motivos` (multi-select, default []). A poema with no motivos
  // simply produces no path here — it lives under its tipo/temas instead.
  const porSlug = new Map<string, typeof poemas>();
  for (const p of poemas) {
    for (const m of p.data.motivos) {
      if (!porSlug.has(m)) porSlug.set(m, []);
      porSlug.get(m)!.push(p);
    }
  }

  return Array.from(porSlug.entries()).map(([slug, ps]) => ({
    params: { slug },
    props: {
      slug: slug as Motivo,
      poemas: ps.sort((a, b) => b.data.fecha.valueOf() - a.data.fecha.valueOf()),
      autorMap,
    },
  }));
}

const { slug, poemas, autorMap } = Astro.props;
const display = MOTIVOS_DISPLAY[slug];
const contadorTexto =
  poemas.length === 1
    ? '1 poema con este motivo'
    : `${poemas.length} poemas con este motivo`;

const breadcrumbLd = buildBreadcrumbJsonLd(
  [
    { name: 'Inicio', path: '/' },
    { name: display, path: `/motivos/${slug}/` },
  ],
  Astro.site!,
);
---

<Base
  titulo={`Motivo: ${display} · El Poemario`}
  descripcion={`Poemas con el motivo «${display}» en El Poemario.`}
>
  <JsonLd slot="head" data={breadcrumbLd} />
  <ListadoPoemasTaxonomia
    rotulo="Motivo"
    display={display}
    poemas={poemas}
    autorMap={autorMap}
    contadorTexto={contadorTexto}
    vacioTexto="Aún no hay poemas publicados con este motivo."
  />
</Base>