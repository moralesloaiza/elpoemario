---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import EntradasTabs from '../../components/EntradasTabs.astro';
import FilaEntrada from '../../components/FilaEntrada.astro';

import { SITE_TITLE } from '../../consts';
import { getPagina } from '../../utils/paginas';

const cartas = (
  await getCollection(
    'entradas',
    ({ data }) => !data.borrador && data.tipo === 'correspondencia',
  )
).sort((a, b) => b.data.fecha.valueOf() - a.data.fecha.valueOf());

const pagina = await getPagina('cartas');
---

<Base
  titulo={`${pagina.data.titulo} · ${SITE_TITLE}`}
  descripcion={pagina.data.descripcion}
>
  <main class="page bitacora">
    <header class="title">
      {pagina.data.rotulo && <p class="rotulo">{pagina.data.rotulo}</p>}
      <h1>{pagina.data.titulo}</h1>
      <p class="subtitulo">
        {pagina.data.subtitulo}
        Para escribir una carta, visita <a href="/correspondencia/">correspondencia</a>.
      </p>
    </header>

    <div class="divisor" aria-hidden="true"><span></span><span></span><span></span></div>

    <EntradasTabs activa="cartas" />

    {cartas.length === 0 && (
      <p class="vacio">Aún no hay cartas publicadas.</p>
    )}

    {cartas.length > 0 && (
      <ul class="lista">
        {cartas.map((entrada) => (
          <FilaEntrada entrada={entrada} />
        ))}
      </ul>
    )}
  </main>
</Base>

<style>
  .title {
    text-align: center;
    margin-bottom: var(--space-md);
  }
  .title h1 {
    margin: 0;
    font-size: var(--fs-3xl);
  }
  .subtitulo a {
    color: var(--text);
    border-bottom: var(--rule-hairline) solid var(--oro);
    text-decoration: none;
  }
  .subtitulo a:hover {
    color: var(--oro-texto);
  }
  .vacio {
    text-align: center;
    font-style: italic;
    color: var(--text-soft);
    margin-top: var(--space-2xl);
  }
  .lista {
    list-style: none;
    padding: 0;
    margin: var(--space-xl) auto 0;
    max-width: var(--measure-wide);
  }
</style>
