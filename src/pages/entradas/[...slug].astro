---
import { type CollectionEntry, getCollection, getEntry, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import CartaHeader from '../../components/CartaHeader.astro';
import SpotifyEmbed from '../../components/SpotifyEmbed.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import IconoEditar from '../../components/IconoEditar.astro';

export async function getStaticPaths() {
  const entradas = await getCollection('entradas', ({ data }) => !data.borrador);
  return entradas.map((entrada) => ({
    params: { slug: entrada.id },
    props: entrada,
  }));
}

type Props = CollectionEntry<'entradas'>;
const entrada = Astro.props;
const { titulo, fecha, ilustracion, curador, resumen, tipo, remitente, poema_referido, spotify_url } = entrada.data;
const { Content } = await render(entrada);

// If this is correspondence referring to a poem, resolve its title and
// slug so CartaHeader can render the link.
let poemaTitulo: string | undefined;
let poemaSlug: string | undefined;
if (tipo === 'correspondencia' && poema_referido) {
  const p = await getEntry(poema_referido);
  if (p) {
    poemaTitulo = p.data.titulo;
    poemaSlug = p.id;
  }
}

const descripcion = resumen ?? titulo;

// Back-link: las cartas (correspondencia) viven en /entradas/cartas/;
// el resto, en la bitacora /entradas/.
const volver =
  tipo === 'correspondencia'
    ? { href: '/entradas/cartas/', label: 'Volver a las cartas' }
    : { href: '/entradas/', label: 'Volver a la bitácora' };
---

<Base titulo={`${titulo} · El Poemario`} descripcion={descripcion}>
  <main class="page">
    <article class="entrada" data-pagefind-body data-pagefind-meta={`tipo:${tipo}`}>
      {ilustracion && (
        <figure class="hero-image">
          <Image
            src={ilustracion}
            alt=""
            width={1200}
            height={800}
            loading="eager"
            decoding="async"
          />
        </figure>
      )}

      <header class="title">
        <h1>{titulo}</h1>
        <p class="fecha">
          <FormattedDate date={fecha} />
        </p>
        {tipo === 'correspondencia' && remitente && (
          <CartaHeader
            remitente={remitente}
            poemaTitulo={poemaTitulo}
            poemaSlug={poemaSlug}
          />
        )}
      </header>

      <div class="divisor" aria-hidden="true"><span></span><span></span><span></span></div>

      {spotify_url && <SpotifyEmbed url={spotify_url} />}

      <div class="prose">
        <Content />
      </div>

      {curador && (
        <p class="curaduria">
          Por <strong data-pagefind-meta="author">{curador}</strong>.
        </p>
      )}

      <nav class="volver" aria-label="Volver al índice">
        <a class="volver-enlace" href={volver.href}>
          <span class="galon galon--izq" aria-hidden="true"></span>
          <span>{volver.label}</span>
        </a>
      </nav>
    </article>
  </main>

  <IconoEditar slug={entrada.id} coleccion="entradas" />
</Base>

<style>
  .entrada {
    max-width: var(--measure);
    margin-inline: auto;
  }
  .hero-image {
    margin: 0 0 var(--space-2xl);
  }
  .hero-image img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }
  .title {
    text-align: center;
    margin-bottom: var(--space-xl);
  }
  .title h1 {
    margin: 0 0 var(--space-md);
    font-family: var(--font-display);
    font-size: var(--fs-3xl);
    color: var(--text);
    text-wrap: balance;
    letter-spacing: 0.04em;
  }
  .fecha {
    font-family: var(--font-body);
    font-style: italic;
    font-size: var(--fs-sm);
    color: var(--text-soft);
    margin: 0;
  }
  .prose {
    font-family: var(--font-body);
    font-size: var(--fs-prosa);
    line-height: var(--lh-prosa);
    color: var(--text);
  }
  .prose :global(p) {
    font-family: var(--font-prose);
    margin: 0 0 var(--space-md);
    hyphens: auto;
  }
  .prose :global(h2) {
    font-family: var(--font-display);
    font-size: var(--fs-xl);
    margin: var(--space-xl) 0 var(--space-md);
    color: var(--text);
  }
  .prose :global(blockquote) {
    margin: var(--space-lg) 0;
    padding-inline: var(--space-md);
    border-left: 2px solid var(--oro);
    font-style: italic;
    color: var(--text-soft);
  }
  .prose :global(a) {
    color: var(--link);
  }
  .curaduria {
    text-align: center;
    font-family: var(--font-display);
    font-size: var(--fs-2xs);
    letter-spacing: var(--ls-wider);
    text-transform: uppercase;
    color: var(--oro-texto);
    margin-top: var(--space-2xl);
    padding-top: var(--space-md);
    border-top: var(--rule-hairline) solid var(--oro);
  }
  .curaduria strong {
    font-weight: var(--fw-regular);
    color: var(--oro-texto);
  }
  .volver {
    margin-top: var(--space-2xl);
    text-align: center;
  }
  .volver-enlace {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    font-family: var(--font-meta);
    font-size: var(--fs-2xs);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-wider);
    text-transform: uppercase;
    color: var(--oro-texto);
    text-decoration: none;
    border-bottom: none;
  }
  .volver-enlace .galon {
    transition: transform var(--dur-fast) var(--ease-standard);
  }
  .volver-enlace:hover,
  .volver-enlace:focus-visible {
    color: var(--oro);
    border-bottom: none;
  }
  .volver-enlace:hover .galon,
  .volver-enlace:focus-visible .galon {
    transform: translateX(-3px);
  }
</style>