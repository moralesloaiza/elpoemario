---
import { type CollectionEntry, getCollection, getEntry, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import CartaHeader from '../../components/CartaHeader.astro';
import SpotifyEmbed from '../../components/SpotifyEmbed.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import IconoEditar from '../../components/IconoEditar.astro';

export async function getStaticPaths() {
  const entradas = await getCollection('entradas', ({ data }) => !data.borrador);
  return entradas.map((entrada) => ({
    params: { slug: entrada.id },
    props: entrada,
  }));
}

type Props = CollectionEntry<'entradas'>;
const entrada = Astro.props;
const { titulo, fecha, ilustracion, curador, resumen, tipo, remitente, poema_referido, spotify_url } = entrada.data;
const { Content } = await render(entrada);

// If this is correspondence referring to a poem, resolve its title and
// slug so CartaHeader can render the link.
let poemaTitulo: string | undefined;
let poemaSlug: string | undefined;
if (tipo === 'correspondencia' && poema_referido) {
  const p = await getEntry(poema_referido);
  if (p) {
    poemaTitulo = p.data.titulo;
    poemaSlug = p.id;
  }
}

const descripcion = resumen ?? titulo;
const esCarta = tipo === 'correspondencia';
const kind = esCarta ? 'Carta' : 'Bitácora';

// Hero inmersivo (handoff 4c): solo para entradas de bitácora con ilustración.
// Las cartas tienen su propia cabecera (CartaHeader) y no van a modo inmersivo.
const conHero = !!ilustracion && !esCarta;

// Back-link (handoff §7): las cartas viven en /entradas/cartas/;
// el resto, en la bitácora /entradas/.
const volver = esCarta
  ? { href: '/entradas/cartas/', label: '← Cartas' }
  : { href: '/entradas/', label: '← Bitácora' };
---

<Base titulo={`${titulo} · El Poemario`} descripcion={descripcion} heroInmersivo={conHero}>
  {conHero && (
    <div class="entrada-hero" slot="hero">
      <Image
        src={ilustracion}
        alt=""
        class="entrada-hero-img"
        widths={[768, 1280, 1920]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
      <div class="entrada-hero-degradado" aria-hidden="true"></div>
      <div class="entrada-hero-contenido page">
        <p class="entrada-hero-kicker">
          <FormattedDate date={fecha} />
          <span class="kicker-sep"> · </span>
          {kind}
        </p>
        <h1 class="entrada-hero-titulo">{titulo}</h1>
        <p class="entrada-hero-firma">por {curador}</p>
      </div>
    </div>
  )}

  <main class="page">
    <article
      class:list={['entrada', { 'entrada--con-hero': conHero }]}
      data-pagefind-body
      data-pagefind-meta={`tipo:${tipo}`}
    >
      <nav class="volver" aria-label="Volver al índice">
        <a class="volver-enlace" href={volver.href}>{volver.label}</a>
      </nav>

      {conHero ? (
        /* El título y el autor viven sobre el hero (fuera de este
           [data-pagefind-body]); se preservan aquí para Pagefind, como en las
           cartas y en el poema con hero. */
        <>
          <span hidden data-pagefind-meta="title">{titulo}</span>
          <span hidden data-pagefind-meta="author">{curador}</span>
        </>
      ) : (
        <header class="cabecera">
          <p class="kicker">
            <FormattedDate date={fecha} />
            <span class="kicker-sep"> · </span>
            {kind}
          </p>
          <h1>{titulo}</h1>
          {esCarta && remitente ? (
            <CartaHeader
              remitente={remitente}
              poemaTitulo={poemaTitulo}
              poemaSlug={poemaSlug}
            />
          ) : (
            <p class="firma">por <strong data-pagefind-meta="author">{curador}</strong></p>
          )}
          {esCarta && (
            <span class="pf-author" data-pagefind-meta={`author:${curador}`} hidden></span>
          )}
        </header>
      )}

      {ilustracion && !conHero && (
        <figure class="hero">
          <Image
            src={ilustracion}
            alt=""
            width={1200}
            height={800}
            loading="eager"
            decoding="async"
          />
        </figure>
      )}

      {spotify_url && <SpotifyEmbed url={spotify_url} />}

      <div class="prose">
        <Content />
      </div>
    </article>
  </main>

  <IconoEditar slug={entrada.id} coleccion="entradas" />
</Base>

<style>
  .entrada {
    max-width: var(--measure-wide);
    margin-inline: auto;
  }
  /* Tras un hero inmersivo, .site-main pierde su padding superior; el artículo
     recupera aquí el respiro para no pegar el back-link a la imagen. */
  .entrada--con-hero {
    padding-top: var(--space-2xl);
  }

  /* ── Hero inmersivo (entrada con imagen, handoff 4c) ─────────────────
     Ilustración a sangre 740px con la nav flotando encima (Base) y el título
     anclado abajo a la IZQUIERDA sobre el degradado. Colores fijos claros
     (--hero-*), legibles en día y noche. Sustituye al passe-partout enmarcado.
     Comparte forma con el hero del poema (Poema.astro); una posible limpieza
     futura extraería un componente HeroInmersivo común. */
  .entrada-hero {
    position: relative;
    height: 740px;
    overflow: hidden;
  }
  .entrada-hero-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 32%;
  }
  .entrada-hero-degradado {
    position: absolute;
    inset: 0;
    background: var(--hero-gradiente);
  }
  /* Bloque de título anclado abajo, alineado a la izquierda dentro del
     contenedor de página (.page aporta max-width + margen auto + gutter). */
  .entrada-hero-contenido {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding-bottom: var(--space-2xl);
    text-align: left;
  }
  .entrada-hero-kicker {
    font-family: var(--font-display);
    font-size: var(--fs-2xs);
    letter-spacing: var(--ls-widest);
    text-transform: uppercase;
    color: var(--hero-accent);
    margin: 0 0 var(--space-md);
  }
  .entrada-hero-kicker .kicker-sep {
    color: var(--hero-rule);
  }
  .entrada-hero-titulo {
    max-width: 54rem;
    font-family: var(--font-body);
    font-weight: 500;
    font-size: var(--fs-4xl);
    line-height: 1.04;
    letter-spacing: 0;
    text-transform: none;
    color: var(--hero-title);
    margin: 0 0 var(--space-sm);
    text-shadow: 0 2px 24px rgba(0, 0, 0, 0.5);
    text-wrap: balance;
  }
  .entrada-hero-firma {
    font-family: var(--font-body);
    font-style: italic;
    font-size: var(--fs-lg);
    color: var(--hero-ink-soft);
    margin: 0;
  }
  @media (max-width: 900px) {
    .entrada-hero {
      height: 520px;
    }
  }

  /* Back-link at the top (handoff): Cinzel uppercase gold. */
  .volver {
    margin-bottom: var(--space-lg);
  }
  .volver-enlace {
    font-family: var(--font-meta);
    font-size: var(--fs-2xs);
    letter-spacing: var(--ls-wider);
    text-transform: uppercase;
    color: var(--oro-texto);
    text-decoration: none;
    border-bottom: none;
    transition: color var(--dur-fast) var(--ease-standard);
  }
  .volver-enlace:hover,
  .volver-enlace:focus-visible {
    color: var(--oro);
    border-bottom: none;
  }

  /* Centered narrow header: kicker · title · attribution. */
  .cabecera {
    max-width: var(--measure-grid);
    margin: 0 auto var(--space-xl);
    text-align: center;
  }
  .kicker {
    font-family: var(--font-display);
    font-size: var(--fs-2xs);
    letter-spacing: var(--ls-widest);
    text-transform: uppercase;
    color: var(--oro-texto);
    margin: 0 0 var(--space-md);
  }
  .kicker-sep {
    color: var(--oro-suave);
  }
  /* Titulo de entrada = OBRA que se lee (§25): Garamond caja normal, identico al
     titulo de poema. Anula el text-transform:uppercase heredado del h1 base; sin
     este reset el titulo salia en versalitas, incoherente con .poema-titulo. */
  .cabecera h1 {
    margin: 0 0 var(--space-sm);
    font-family: var(--font-body);
    font-weight: 500;
    font-size: var(--fs-3xl);
    line-height: var(--lh-snug);
    color: var(--text);
    text-transform: none;
    text-wrap: balance;
    letter-spacing: 0;
  }
  .firma {
    font-family: var(--font-body);
    font-style: italic;
    font-size: var(--fs-lg);
    color: var(--text-muted);
    margin: 0;
  }
  .firma strong {
    font-weight: var(--fw-regular);
  }

  /* Hero in a passe-partout frame (handoff §7). */
  .hero {
    margin: 0 auto var(--space-2xl);
    border: 1px solid var(--rule);
    background: var(--mat);
    padding: 10px;
  }
  .hero img {
    display: block;
    width: 100%;
    height: 420px;
    object-fit: cover;
    object-position: center 26%;
  }

  /* Reading column narrows to ~660px (handoff). */
  .prose {
    max-width: var(--measure);
    margin-inline: auto;
    font-family: var(--font-body);
    font-size: var(--fs-prosa);
    line-height: var(--lh-prosa);
    color: var(--text);
  }
  .prose :global(p) {
    font-family: var(--font-prose);
    margin: 0 0 var(--space-md);
    hyphens: auto;
  }
  /* Subtitulos del cuerpo (h2-h6, editables en Decap) = voz literaria (§25):
     Cormorant Garamond, NO Cinzel. Jerarquia por tamano -> italica -> color,
     no por cambio de fuente. Garamond tiene italica real, asi que un encabezado
     en italica (p.ej. `### *...*` dentro de una cita) sale bien, sin la
     faux-italic que producia Cinzel. Los niveles altos van en font-style:normal
     para no heredar la italica del blockquote; h5-h6 van en italica a proposito.
     Un h1 en el cuerpo se evita: el h1 es el titulo de la pagina. */
  .prose :global(h2) {
    font-family: var(--font-body);
    font-weight: var(--fw-semibold);
    font-size: var(--fs-xl);
    font-style: normal;
    line-height: var(--lh-snug);
    letter-spacing: 0;
    color: var(--text);
    margin: var(--space-xl) 0 var(--space-sm);
    text-wrap: balance;
  }
  .prose :global(h3) {
    font-family: var(--font-body);
    font-weight: var(--fw-semibold);
    font-size: var(--fs-lg);
    font-style: normal;
    line-height: var(--lh-snug);
    letter-spacing: 0;
    color: var(--text);
    margin: var(--space-lg) 0 var(--space-sm);
    text-wrap: balance;
  }
  .prose :global(h4) {
    font-family: var(--font-body);
    font-weight: var(--fw-semibold);
    font-size: var(--fs-md);
    font-style: normal;
    letter-spacing: 0;
    color: var(--text);
    margin: var(--space-lg) 0 var(--space-xs);
  }
  .prose :global(h5) {
    font-family: var(--font-body);
    font-weight: var(--fw-semibold);
    font-size: var(--fs-base);
    font-style: italic;
    letter-spacing: 0;
    color: var(--text);
    margin: var(--space-md) 0 var(--space-xs);
  }
  .prose :global(h6) {
    font-family: var(--font-body);
    font-weight: var(--fw-semibold);
    font-size: var(--fs-sm);
    font-style: italic;
    letter-spacing: 0;
    color: var(--text-muted);
    margin: var(--space-md) 0 var(--space-xs);
  }
  /* Pull-quote: big centered italic in Cormorant, no side rule (handoff). */
  .prose :global(blockquote) {
    margin: var(--space-2xl) 0;
    padding-inline: var(--space-lg);
    border: 0;
    font-family: var(--font-body);
    font-style: italic;
    font-size: var(--fs-2xl);
    line-height: var(--lh-snug);
    text-align: center;
    color: var(--text);
  }
  .prose :global(blockquote p) {
    font-family: inherit;
    margin: 0;
  }
  .prose :global(a) {
    color: var(--link);
  }

  @media (max-width: 640px) {
    .hero img {
      height: 260px;
    }
  }
</style>
