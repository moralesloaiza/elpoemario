---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import EntradasTabs from '../../components/EntradasTabs.astro';
import FormattedDate from '../../components/FormattedDate.astro';

import { SITE_TITLE } from '../../consts';
import { getPagina } from '../../utils/paginas';

const entradas = (
  await getCollection('entradas', ({ data }) => !data.borrador)
).sort((a, b) => b.data.fecha.valueOf() - a.data.fecha.valueOf());

const pagina = await getPagina('bitacora');
---

<Base
  titulo={`${pagina.data.titulo} · ${SITE_TITLE}`}
  descripcion={pagina.data.descripcion}
>
  <main class="page bitacora">
    <header class="title">
      {pagina.data.rotulo && <p class="rotulo">{pagina.data.rotulo}</p>}
      <h1>{pagina.data.titulo}</h1>
      <p class="subtitulo">{pagina.data.subtitulo}</p>
    </header>

    <div class="divisor" aria-hidden="true"><span></span><span></span><span></span></div>

    <EntradasTabs activa="todas" />

    {entradas.length === 0 && (
      <p class="vacio">Aún no hay entradas en la bitácora.</p>
    )}

    {entradas.length > 0 && (
      <ul class="lista">
        {entradas.map((entrada) => {
          const kind =
            entrada.data.tipo === 'correspondencia' ? 'Carta' : 'Bitácora';
          return (
            <li class="fila">
              <div class="fila-imagen" aria-hidden="true">
                {entrada.data.ilustracion ? (
                  <Image
                    src={entrada.data.ilustracion}
                    alt=""
                    width={480}
                    loading="lazy"
                    decoding="async"
                  />
                ) : (
                  <span class="fila-inicial">
                    {entrada.data.titulo.trim().charAt(0).toUpperCase()}
                  </span>
                )}
              </div>
              <div class="fila-texto">
                <p class="fila-meta">
                  <FormattedDate date={entrada.data.fecha} />
                  <span class="fila-meta-sep"> · </span>
                  {kind}
                </p>
                <h3 class="fila-titulo">
                  <a href={`/entradas/${entrada.id}/`}>{entrada.data.titulo}</a>
                </h3>
                {entrada.data.resumen && (
                  <p class="fila-resumen">{entrada.data.resumen}</p>
                )}
                <span class="fila-leer">Leer la entrada →</span>
              </div>
            </li>
          );
        })}
      </ul>
    )}
  </main>
</Base>

<style>
  .title {
    text-align: center;
    margin-bottom: var(--space-md);
  }
  .title h1 {
    margin: 0;
    font-size: var(--fs-3xl);
    font-family: var(--font-display);
    color: var(--text);
  }
  .vacio {
    text-align: center;
    font-style: italic;
    color: var(--text-soft);
    margin-top: var(--space-2xl);
  }
  .lista {
    list-style: none;
    padding: 0;
    margin: var(--space-xl) auto 0;
    max-width: var(--measure-wide);
  }

  /* Entry row (handoff §6): framed image | text, whole row clickable via the
     title link's ::before overlay. Bottom hairline separates rows. */
  .fila {
    position: relative;
    display: grid;
    grid-template-columns: 0.9fr 2fr;
    gap: var(--space-xl);
    align-items: center;
    padding: var(--space-xl) 0;
    border-bottom: 1px solid var(--rule-soft);
    transition: background-color var(--dur-fast) var(--ease-standard);
  }
  .fila:has(.fila-titulo a:hover),
  .fila:has(.fila-titulo a:focus-visible) {
    background-color: var(--hover-tint);
  }

  /* Passe-partout frame: --mat backing + --rule hairline, no radius. */
  .fila-imagen {
    border: 1px solid var(--rule);
    background: var(--mat);
    padding: 7px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  .fila-imagen img {
    display: block;
    width: 100%;
    height: 180px;
    object-fit: cover;
    object-position: center 28%;
  }
  .fila-inicial {
    font-family: var(--font-body);
    font-size: var(--fs-3xl);
    font-weight: 500;
    color: var(--oro-texto);
    line-height: 1;
    padding-block: calc((180px - 1em) / 2);
  }

  .fila-texto {
    min-width: 0;
  }
  .fila-meta {
    font-family: var(--font-display);
    font-size: var(--fs-3xs);
    letter-spacing: var(--ls-wider);
    text-transform: uppercase;
    color: var(--oro-texto);
    margin: 0 0 var(--space-2xs);
  }
  .fila-meta-sep {
    color: var(--oro-suave);
  }
  .fila-titulo {
    font-family: var(--font-body);
    font-size: var(--fs-2xl);
    font-weight: 500;
    line-height: var(--lh-snug);
    color: var(--text);
    text-transform: none;
    letter-spacing: 0;
    margin: 0 0 var(--space-2xs);
    text-wrap: balance;
  }
  .fila-titulo a {
    text-decoration: none;
    color: inherit;
    border-bottom: none;
  }
  .fila-titulo a::before {
    content: "";
    position: absolute;
    inset: 0;
  }
  .fila:has(.fila-titulo a:hover) .fila-titulo,
  .fila:has(.fila-titulo a:focus-visible) .fila-titulo {
    color: var(--oro-texto);
  }
  .fila-resumen {
    font-family: var(--font-prose);
    font-size: var(--fs-md);
    line-height: 1.62;
    color: var(--text-soft);
    margin: 0 0 var(--space-sm);
  }
  .fila-leer {
    font-family: var(--font-display);
    font-size: var(--fs-3xs);
    letter-spacing: var(--ls-wide);
    text-transform: uppercase;
    color: var(--oro-texto);
  }

  /* Móvil (handoff): imagen apilada sobre el texto, una columna. */
  @media (max-width: 640px) {
    .fila {
      grid-template-columns: 1fr;
      gap: var(--space-md);
    }
    .fila-imagen img {
      height: 200px;
    }
  }
</style>
