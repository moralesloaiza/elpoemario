---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import EntradasTabs from '../../components/EntradasTabs.astro';
import FormattedDate from '../../components/FormattedDate.astro';

import { SITE_TITLE } from '../../consts';
import { getPagina } from '../../utils/paginas';

const entradas = (
  await getCollection('entradas', ({ data }) => !data.borrador)
).sort((a, b) => b.data.fecha.valueOf() - a.data.fecha.valueOf());

const pagina = await getPagina('bitacora');
---

<Base
  titulo={`${pagina.data.titulo} · ${SITE_TITLE}`}
  descripcion={pagina.data.descripcion}
>
  <main class="page bitacora">
    <header class="title">
      <h1>{pagina.data.titulo}</h1>
      <p class="subtitulo">{pagina.data.subtitulo}</p>
    </header>

    <hr class="ornate" />

    <EntradasTabs activa="todas" />

    {entradas.length === 0 && (
      <p class="vacio">Aún no hay entradas en la bitácora.</p>
    )}

    {entradas.length > 0 && (
      <ul class="lista">
        {entradas.map((entrada) => (
          <li class="item">
            <a href={`/entradas/${entrada.id}/`} class="item-link">
              <span class="item-texto">
                <span class="item-marca">
                  {entrada.data.tipo === 'correspondencia' ? 'Carta' : 'Bitácora'}
                </span>
                <span class="item-titulo">{entrada.data.titulo}</span>
              </span>
              <span class="item-fecha">
                <FormattedDate date={entrada.data.fecha} />
              </span>
            </a>
          </li>
        ))}
      </ul>
    )}
  </main>
</Base>

<style>
  .title {
    text-align: center;
    margin-bottom: var(--space-md);
  }
  .title h1 {
    margin: 0 0 var(--space-sm);
    font-size: var(--fs-3xl);
    font-family: var(--font-display);
    color: var(--text);
  }
  .subtitulo {
    font-family: var(--font-body);
    font-style: italic;
    font-size: var(--fs-md);
    color: var(--text-soft);
    max-width: var(--measure-narrow);
    margin: 0 auto;
  }
  .vacio {
    text-align: center;
    font-style: italic;
    color: var(--text-soft);
    margin-top: var(--space-2xl);
  }
  .lista {
    list-style: none;
    padding: 0;
    margin: var(--space-2xl) 0 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1px;
    background-color: color-mix(in srgb, var(--oro) 16%, transparent);
    border: var(--rule-hairline) solid color-mix(in srgb, var(--oro) 16%, transparent);
  }
  .item-link {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2xs) var(--space-lg);
    text-decoration: none;
    color: inherit;
    background-color: var(--bg);
    padding: var(--space-md);
    border-bottom: none;
    transition: background-color var(--dur-fast) var(--ease-standard);
  }
  .item-link:hover,
  .item-link:focus-visible {
    background-color: var(--bg-elevated);
  }
  .item-texto {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-sm) var(--space-md);
    min-width: 0;
  }
  .item-marca {
    font-family: var(--font-display);
    font-size: var(--fs-3xs);
    letter-spacing: var(--ls-widest);
    text-transform: uppercase;
    color: var(--oro-texto);
    flex: none;
  }
  .item-titulo {
    font-family: var(--font-display);
    font-size: var(--fs-lg);
    font-weight: var(--fw-regular);
    letter-spacing: var(--ls-wide);
    line-height: var(--lh-snug);
    color: var(--text);
  }
  .item-link:hover .item-titulo,
  .item-link:focus-visible .item-titulo {
    color: var(--oro-texto);
  }
  .item-fecha {
    font-family: var(--font-body);
    font-style: italic;
    font-size: var(--fs-sm);
    color: var(--text-soft);
    flex: none;
  }
</style>
