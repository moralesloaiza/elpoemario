---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import EntradasTabs from '../../components/EntradasTabs.astro';
import FormattedDate from '../../components/FormattedDate.astro';

import { SITE_TITLE } from '../../consts';
import { getPagina } from '../../utils/paginas';

const entradas = (
  await getCollection('entradas', ({ data }) => !data.borrador)
).sort((a, b) => b.data.fecha.valueOf() - a.data.fecha.valueOf());

const pagina = await getPagina('bitacora');
---

<Base
  titulo={`${pagina.data.titulo} · ${SITE_TITLE}`}
  descripcion={pagina.data.descripcion}
>
  <main class="page bitacora">
    <header class="title">
      <h1>{pagina.data.titulo}</h1>
      <p class="subtitulo">{pagina.data.subtitulo}</p>
    </header>

    <div class="divisor" aria-hidden="true"><span></span><span></span><span></span></div>

    <EntradasTabs activa="todas" />

    {entradas.length === 0 && (
      <p class="vacio">Aún no hay entradas en la bitácora.</p>
    )}

    {entradas.length > 0 && (
      <ul class="lista">
        {entradas.map((entrada) => (
          <li class="item">
            <a href={`/entradas/${entrada.id}/`} class="item-link">
              <span class="item-meta">
                <FormattedDate date={entrada.data.fecha} />
                <span class="item-meta-sep"> · </span>
                {entrada.data.tipo === 'correspondencia' ? 'Carta' : 'Bitácora'}
              </span>
              <span class="item-titulo">{entrada.data.titulo}</span>
              {entrada.data.resumen && (
                <span class="item-resumen">{entrada.data.resumen}</span>
              )}
              <span class="item-seguir">
                <span>Seguir leyendo</span>
                <span class="galon galon--der" aria-hidden="true"></span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    )}
  </main>
</Base>

<style>
  .title {
    text-align: center;
    margin-bottom: var(--space-md);
  }
  .title h1 {
    margin: 0 0 var(--space-sm);
    font-size: var(--fs-3xl);
    font-family: var(--font-display);
    color: var(--text);
  }
  .subtitulo {
    font-family: var(--font-body);
    font-style: italic;
    font-size: var(--fs-md);
    color: var(--text-soft);
    max-width: var(--measure-narrow);
    margin: 0 auto;
  }
  .vacio {
    text-align: center;
    font-style: italic;
    color: var(--text-soft);
    margin-top: var(--space-2xl);
  }
  .lista {
    list-style: none;
    padding: 0;
    margin: var(--space-2xl) auto 0;
    max-width: var(--measure);
  }
  .item-link {
    display: block;
    text-decoration: none;
    color: inherit;
    padding: var(--space-lg) var(--space-md);
    border-bottom: var(--rule-hairline) solid var(--line);
    transition: background-color var(--dur-fast) var(--ease-standard);
  }
  .item:last-child .item-link {
    border-bottom: 0;
  }
  .item-link:hover,
  .item-link:focus-visible {
    background-color: var(--bg-elevated);
  }
  .item-meta {
    display: block;
    font-family: var(--font-display);
    font-size: var(--fs-3xs);
    letter-spacing: var(--ls-widest);
    text-transform: uppercase;
    color: var(--oro-texto);
    margin-bottom: var(--space-xs);
  }
  .item-meta-sep {
    color: var(--oro-suave);
  }
  .item-titulo {
    display: block;
    font-family: var(--font-display);
    font-size: var(--fs-lg);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-wide);
    line-height: var(--lh-snug);
    color: var(--text);
  }
  .item-link:hover .item-titulo,
  .item-link:focus-visible .item-titulo {
    color: var(--oro-texto);
  }
  .item-resumen {
    display: block;
    font-family: var(--font-body);
    font-size: var(--fs-md);
    line-height: 1.65;
    color: var(--text-soft);
    margin-top: var(--space-xs);
  }
  .item-seguir {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    margin-top: var(--space-sm);
    font-family: var(--font-display);
    font-size: var(--fs-3xs);
    letter-spacing: var(--ls-wide);
    text-transform: uppercase;
    color: var(--oro-texto);
  }
  .item-seguir .galon {
    transition: transform var(--dur-fast) var(--ease-standard);
  }
  .item-link:hover .item-seguir .galon,
  .item-link:focus-visible .item-seguir .galon {
    transform: translateX(var(--space-3xs));
  }
</style>
