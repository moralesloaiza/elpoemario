---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { TEMAS_DISPLAY, type Tema } from '../../utils/taxonomia';

import { SITE_TITLE } from '../../consts';
import { getPagina } from '../../utils/paginas';

const poemas = await getCollection('poemas', ({ data }) => !data.borrador);

// Count poemas per tema (multi-select, min 1). A poema with N temas
// contributes 1 to N different counters.
const conteo = new Map<Tema, number>();
for (const p of poemas) {
  for (const t of p.data.temas) {
    conteo.set(t, (conteo.get(t) ?? 0) + 1);
  }
}

// Sort by count desc, alphabetical Spanish as tiebreaker.
const items = Array.from(conteo.entries())
  .map(([slug, n]) => ({ slug, conteo: n, display: TEMAS_DISPLAY[slug] }))
  .sort((a, b) => {
    if (b.conteo !== a.conteo) return b.conteo - a.conteo;
    return a.display.localeCompare(b.display, 'es');
  });

const pagina = await getPagina('temas');
---

<Base
  titulo={`${pagina.data.titulo} · ${SITE_TITLE}`}
  descripcion={pagina.data.descripcion}
>
  <div class="indice">
    <header class="title">
      <h1>{pagina.data.titulo}</h1>
      <p class="subtitulo">{pagina.data.subtitulo}</p>
    </header>

    <hr class="ornate" />

    <ul class="lista">
      {items.map((item) => (
        <li class="item">
          <a href={`/temas/${item.slug}/`} class="item-link">
            <h2 class="item-nombre">{item.display}</h2>
            <p class="item-conteo">
              {item.conteo === 1 ? '1 poema' : `${item.conteo} poemas`}
            </p>
          </a>
        </li>
      ))}
    </ul>
  </div>
</Base>

<style>
  .indice {
  }
  .title {
    text-align: center;
    margin-bottom: var(--space-md);
  }
  .title h1 {
    margin: 0 0 var(--space-sm);
    font-size: var(--fs-3xl);
  }
  .subtitulo {
    font-family: var(--font-body);
    font-style: italic;
    font-size: var(--fs-md);
    color: var(--text-soft);
    max-width: var(--measure-narrow);
    margin: 0 auto;
  }
  .lista {
    list-style: none;
    padding: 0;
    margin: var(--space-2xl) 0 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: var(--space-md);
  }
  .item-link {
    display: block;
    text-decoration: none;
    color: inherit;
    text-align: center;
    padding: var(--space-md);
    border: var(--rule-hairline) solid var(--oro);
    transition: background-color var(--dur-fast) var(--ease-standard);
  }
  .item-link:hover,
  .item-link:focus-visible {
    background-color: rgba(255, 255, 255, 0.04);
  }
  .item-nombre {
    font-family: var(--font-display);
    font-size: var(--fs-md);
    font-weight: var(--fw-bold);
    letter-spacing: var(--ls-wide);
    line-height: var(--lh-snug);
    margin: 0 0 var(--space-2xs);
    color: var(--text);
    text-transform: none;
  }
  .item-link:hover .item-nombre {
    color: var(--oro-texto);
  }
  .item-conteo {
    font-family: var(--font-display);
    font-size: var(--fs-3xs);
    letter-spacing: var(--ls-widest);
    color: var(--esmeralda);
    margin: 0;
  }
</style>