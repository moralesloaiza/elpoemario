---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import JsonLd from '../../components/JsonLd.astro';
import ListadoPoemasTaxonomia from '../../components/ListadoPoemasTaxonomia.astro';
import { buildBreadcrumbJsonLd } from '../../utils/jsonld';
import { TEMAS_DISPLAY, type Tema } from '../../utils/taxonomia';

export async function getStaticPaths() {
  const poemas = await getCollection('poemas', ({ data }) => !data.borrador);
  const autores = await getCollection('autores');
  const autorMap = new Map(autores.map((a) => [a.id, a.data.nombre]));

  // Group by `temas` (multi-select, min 1). A poema with N temas appears
  // under all N keys.
  const porSlug = new Map<string, typeof poemas>();
  for (const p of poemas) {
    for (const t of p.data.temas) {
      if (!porSlug.has(t)) porSlug.set(t, []);
      porSlug.get(t)!.push(p);
    }
  }

  return Array.from(porSlug.entries()).map(([slug, ps]) => ({
    params: { slug },
    props: {
      slug: slug as Tema,
      poemas: ps.sort((a, b) => b.data.fecha.valueOf() - a.data.fecha.valueOf()),
      autorMap,
    },
  }));
}

const { slug, poemas, autorMap } = Astro.props;
const display = TEMAS_DISPLAY[slug];
const contadorTexto =
  poemas.length === 1
    ? '1 poema sobre este tema'
    : `${poemas.length} poemas sobre este tema`;

const breadcrumbLd = buildBreadcrumbJsonLd(
  [
    { name: 'Inicio', path: '/' },
    { name: display, path: `/temas/${slug}/` },
  ],
  Astro.site!,
);
---

<Base
  titulo={`Tema: ${display} · El Poemario`}
  descripcion={`Poemas sobre ${display.toLowerCase()} en El Poemario.`}
>
  <JsonLd slot="head" data={breadcrumbLd} />
  <ListadoPoemasTaxonomia
    rotulo="Tema"
    display={display}
    poemas={poemas}
    autorMap={autorMap}
    contadorTexto={contadorTexto}
    vacioTexto="Aún no hay poemas publicados sobre este tema."
  />
</Base>