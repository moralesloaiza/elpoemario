---
import Base from '../layouts/Base.astro';
import { getPagina } from '../utils/paginas';

// h1, lead and meta description from src/content/paginas/error-404.md.
// The browser tab <title> stays hardcoded by design.
const pagina = await getPagina('error-404');
const { titulo, descripcion } = pagina.data;
---

<Base titulo="Página no encontrada · El Poemario" descripcion={descripcion}>
  <div class="error-page">
    <p class="error-numero">404</p>
    <header class="title">
      {pagina.data.rotulo && <p class="rotulo">{pagina.data.rotulo}</p>}
      <h1>{titulo}</h1>
      <p class="lead">{pagina.data.subtitulo}</p>
    </header>

    <div class="divisor" aria-hidden="true"><span></span><span></span><span></span></div>

    <nav class="acciones" aria-label="Navegación de rescate">
      <a class="accion" href="/"><span class="galon galon--izq" aria-hidden="true"></span><span>Volver al inicio</span></a>
      <span class="sep-diamante" aria-hidden="true"></span>
      <a class="accion" href="/poemas/"><span>Ver todos los poemas</span><span class="galon galon--der" aria-hidden="true"></span></a>
      <span class="sep-diamante" aria-hidden="true"></span>
      <a class="accion" href="/autores/"><span>Ver autores</span><span class="galon galon--der" aria-hidden="true"></span></a>
    </nav>
  </div>
</Base>

<style>
  .error-page {
    max-width: var(--measure-narrow);
    margin-inline: auto;
    text-align: center;
  }
  .error-numero {
    font-family: var(--font-display);
    font-weight: var(--fw-bold);
    font-size: clamp(60px, 12vw, 120px);
    line-height: 1;
    letter-spacing: 0.08em;
    color: var(--oro-suave);
    margin: 0;
  }
  .title {
    margin-bottom: var(--space-xl);
  }
  .title h1 {
    font-size: var(--fs-3xl);
    margin: var(--space-md) 0;
    text-wrap: balance;
  }
  .lead {
    font-family: var(--font-body);
    font-style: italic;
    font-size: var(--fs-lg);
    line-height: var(--lh-snug);
    color: var(--text-soft);
    max-width: var(--measure-narrow);
    margin: 0 auto;
  }
  .acciones {
    font-family: var(--font-display);
    font-size: var(--fs-xs);
    letter-spacing: var(--ls-widest);
    color: var(--oro-texto);
    margin-top: var(--space-xl);
  }
  .acciones a {
    color: inherit;
    text-decoration: none;
    border-bottom: var(--rule-hairline) solid transparent;
    transition: border-color var(--dur-fast) var(--ease-standard);
  }
  .acciones a:hover,
  .acciones a:focus-visible {
    border-bottom-color: var(--oro-texto);
  }
  .acciones span {
    margin-inline: var(--space-xs);
    color: var(--oro);
  }
.acciones .accion {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    text-decoration: none;
    border-bottom: none;
  }
  .acciones .accion .galon {
    transition: transform var(--dur-fast) var(--ease-standard);
  }
  .acciones .accion:hover,
  .acciones .accion:focus-visible {
    border-bottom: none;
  }
  .acciones a:hover,
  .acciones a:focus-visible {
    border-bottom-color: var(--oro-texto);
  }
  .acciones span {
    margin-inline: var(--space-xs);
    color: var(--oro);
  }


  .acciones .sep-diamante {
    display: inline-block;
    vertical-align: middle;
    width: 5px;
    height: 5px;
    transform: rotate(45deg);
    background: color-mix(in srgb, var(--oro) 60%, transparent);
  }
</style>