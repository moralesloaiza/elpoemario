---
import { getCollection, getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import JsonLd from '../components/JsonLd.astro';
import Destacado from '../components/Destacado.astro';
import { SITE_TITLE, SPOTIFY_SHOW_URL } from '../consts';
import { TIPOS_DISPLAY } from '../utils/taxonomia';
import { getPagina } from '../utils/paginas';
import { buildWebSiteJsonLd } from '../utils/jsonld';
import type { ImageMetadata } from 'astro';

// Home hero text from src/content/paginas/home.md (editable in Decap).
// `rotulo` is the short antetitulo above the heading; `titulo` is the long
// descriptor (browser <title> suffix / og:title), not rendered visibly;
// `subtitulo` is the italic tagline, which now IS the page <h1> (the body no
// longer repeats "El Poemario" — the wordmark lives in the masthead — but the
// page keeps a real h1 for SEO/a11y, falling back to SITE_TITLE if empty);
// `lema` is an optional secondary italic line below.
const home = await getPagina('home');

// Latest non-draft poems, newest first, capped at 6.
const ultimos = (await getCollection('poemas', ({ data }) => !data.borrador))
  .sort((a, b) => b.data.fecha.valueOf() - a.data.fecha.valueOf())
  .slice(0, 6);

// Author id->name map, so the grid renders authors without per-row awaits.
const autoresLista = await getCollection('autores');
const autoresPorId = new Map(autoresLista.map((a) => [a.id, a.data.nombre]));

// --- Destacado (curatorial singleton) ---
// Polymorphic: the referenced item can be a poema, an entrada or an autor.
// We resolve the reference here and validate the target has an image — Zod
// cannot do cross-collection lookups, so this validation lives at build time.
const destacadoEntries = await getCollection('destacado');
const destacadoCfg = destacadoEntries[0]; // singleton

type DestacadoRender = {
  cintillo: string;
  titulo: string;
  href: string;
  cta: string;
  imagen: ImageMetadata;
  byline?: string;
  versos?: string[];
  resumen?: string;
};

let destacado: DestacadoRender | null = null;

if (destacadoCfg && destacadoCfg.data.activo) {
  const { tipo, cintillo } = destacadoCfg.data;

  if (tipo === 'poema' && destacadoCfg.data.poema_referido) {
    const poema = await getEntry(destacadoCfg.data.poema_referido);
    if (!poema.data.ilustracion) {
      throw new Error(
        `Destacado activo referencia el poema "${poema.id}" sin \`ilustracion\`. La imagen es obligatoria para destacar.`,
      );
    }
    const autor = await getEntry(poema.data.autor);
    // Verse extract is curator-set on the destacado singleton: one verse per
    // line. Falls back to no extract if the field is empty.
    const versos = (destacadoCfg.data.extracto ?? '')
      .split(/\r?\n/)
      .map((linea) => linea.trim())
      .filter(Boolean);
    destacado = {
      cintillo,
      titulo: poema.data.titulo,
      href: `/poemas/${poema.id}/`,
      cta: 'Leer el poema',
      imagen: poema.data.ilustracion,
      byline: autor.data.nombre,
      versos,
    };
  } else if (tipo === 'entrada' && destacadoCfg.data.entrada_referida) {
    const entrada = await getEntry(destacadoCfg.data.entrada_referida);
    if (!entrada.data.ilustracion) {
      throw new Error(
        `Destacado activo referencia la entrada "${entrada.id}" sin \`ilustracion\`. La imagen es obligatoria para destacar.`,
      );
    }
    destacado = {
      cintillo,
      titulo: entrada.data.titulo,
      href: `/entradas/${entrada.id}/`,
      cta: 'Leer la entrada',
      imagen: entrada.data.ilustracion,
      byline: entrada.data.curador,
      resumen: entrada.data.resumen,
    };
  } else if (tipo === 'autor' && destacadoCfg.data.autor_referido) {
    const autor = await getEntry(destacadoCfg.data.autor_referido);
    if (!autor.data.imagen) {
      throw new Error(
        `Destacado activo referencia al autor "${autor.id}" sin \`imagen\`. La imagen es obligatoria para destacar.`,
      );
    }
    const aniosAutor =
      autor.data.nacimiento && autor.data.muerte
        ? `${autor.data.nacimiento}–${autor.data.muerte}`
        : undefined;
    destacado = {
      cintillo,
      titulo: autor.data.nombre,
      href: `/autores/${autor.id}/`,
      cta: 'Ver la ficha',
      imagen: autor.data.imagen,
      byline: [autor.data.nacionalidad, aniosAutor].filter(Boolean).join(' · ') || undefined,
      resumen: autor.data.descripcion,
    };
  }
}
---

<Base titulo={`${SITE_TITLE} · ${home.data.titulo}`} descripcion={home.data.descripcion}>
  <JsonLd slot="head" data={buildWebSiteJsonLd()} />

  <section class="hero">
    {home.data.rotulo && <p class="antetitulo">{home.data.rotulo}</p>}
    <h1 class="hero-titulo">{home.data.subtitulo || SITE_TITLE}</h1>
    {home.data.lema && <p class="lema">{home.data.lema}</p>}
  </section>

  {destacado && (
    <Destacado
      cintillo={destacado.cintillo}
      titulo={destacado.titulo}
      href={destacado.href}
      cta={destacado.cta}
      imagen={destacado.imagen}
      byline={destacado.byline}
      versos={destacado.versos}
      resumen={destacado.resumen}
    />
  )}

  {ultimos.length > 0 && (
    <section class="seccion-poemas" aria-labelledby="ultimos-titulo">
      <div class="seccion-cab">
        <h2 id="ultimos-titulo" class="seccion-titulo">Últimos poemas</h2>
        <a class="ver-todo" href="/poemas/">Ver todo el catálogo →</a>
      </div>
      <ul class="lista-poemas">
        {ultimos.map((poema, i) => (
          <li class="fila-poema">
            <span class="fila-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="fila-titulo">
              <a href={`/poemas/${poema.id}/`}>{poema.data.titulo}</a>
            </h3>
            <span class="fila-autor">{autoresPorId.get(poema.data.autor.id) ?? ''}</span>
            <span class="fila-tag">{TIPOS_DISPLAY[poema.data.tipo]}</span>
          </li>
        ))}
      </ul>
    </section>
  )}

  <nav class="descubrir-bar" aria-label="Descubrir por facetas">
    <a class="descubrir-celda" href="/tipos/">
      <span class="descubrir-eyebrow">Descubrir</span>
      <span class="descubrir-nombre">Por forma</span>
    </a>
    <a class="descubrir-celda" href="/temas/">
      <span class="descubrir-eyebrow">Descubrir</span>
      <span class="descubrir-nombre">Por tema</span>
    </a>
    <a class="descubrir-celda" href="/siglos/">
      <span class="descubrir-eyebrow">Descubrir</span>
      <span class="descubrir-nombre">Por siglo</span>
    </a>
    <a class="descubrir-celda" href="/nacionalidades/">
      <span class="descubrir-eyebrow">Descubrir</span>
      <span class="descubrir-nombre">Por país</span>
    </a>
  </nav>

  <section class="seccion-podcast">
    <div class="podcast-fila">
      <h2 class="podcast-texto">
        <span class="podcast-eyebrow">{home.data.podcast_titulo}</span>
        <span class="podcast-desc">{home.data.podcast_eyebrow}</span>
      </h2>
      <a class="podcast-boton" href={SPOTIFY_SHOW_URL} target="_blank" rel="noopener">
        {home.data.podcast_cta}
      </a>
    </div>
  </section>
</Base>

<style>
  /* ── Héroe ─────────────────────────────────────────────────────────── */
  .hero {
    position: relative;
    text-align: center;
    /* El layout (.site-main) ya aporta 48px arriba; subimos el héroe para que
       el tagline quede cerca del masthead (~24px) sin tocar el espaciado
       global del resto de páginas. */
    margin-top: calc(-1 * var(--space-lg));
    margin-bottom: 0;
    padding-top: 0;
    padding-bottom: 0;
  }

  .antetitulo {
    font-family: var(--font-meta);
    font-size: var(--fs-xs);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-widest);
    text-transform: uppercase;
    color: var(--oro-texto);
    margin: 0 0 var(--space-sm);
  }

  /* Encabezado del Inicio: el tagline ES el h1 (semántico), en cursiva
     Cormorant como el subtítulo del handoff — no el titular grande en
     versalita. Resetea las reglas del h1 global (versalita, letter-spacing,
     bold). El «El Poemario» del cuerpo se retira: el wordmark vive en el
     masthead. */
  .hero-titulo {
    font-family: var(--font-body);
    font-style: italic;
    font-weight: var(--font-body-weight);
    font-size: var(--fs-lg);
    line-height: var(--lh-snug);
    letter-spacing: 0;
    text-transform: none;
    color: var(--text-muted);
    max-width: var(--measure-narrow);
    margin: 0 auto var(--space-md);
    text-wrap: balance;
  }

  /* Línea secundaria en cursiva bajo el tagline (editable: home.lema). */
  .lema {
    font-family: var(--font-body);
    font-style: italic;
    font-size: var(--fs-lg);
    line-height: var(--lh-snug);
    color: var(--text-soft);
    max-width: var(--measure-narrow);
    margin: 0 auto var(--space-md);
  }

  /* ── Secciones ─────────────────────────────────────────────────────── */
  .seccion-poemas {
    margin-bottom: var(--space-2xl);
  }
  /* Cabecera de sección: título a la izquierda, «ver todo» a la derecha
     (handoff). */
  .seccion-cab {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-md);
    margin-bottom: var(--space-lg);
  }
  .seccion-titulo {
    font-family: var(--font-body);
    font-size: var(--fs-xl);
    font-weight: 500;
    text-transform: none;
    letter-spacing: 0;
    margin: 0;
    color: var(--text);
  }
  .ver-todo {
    font-family: var(--font-meta);
    font-size: var(--fs-3xs);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-wider);
    text-transform: uppercase;
    color: var(--oro-texto);
    text-decoration: none;
    white-space: nowrap;
    border-bottom: none;
  }
  .ver-todo:hover,
  .ver-todo:focus-visible {
    color: var(--oro);
    border-bottom: none;
  }

  /* Índice «Últimos poemas» como lista (handoff): nº · título · autor ·
     etiqueta, separados por filetes de 1px. Fila-enlace: el ::before del
     título extiende el área clicable a toda la fila. */
  .lista-poemas {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .fila-poema {
    position: relative;
    display: grid;
    grid-template-columns: 2.4rem 1fr auto auto;
    grid-template-areas: 'num titulo autor tag';
    align-items: baseline;
    column-gap: var(--space-lg);
    padding: var(--space-md) 0;
    border-top: 1px solid var(--rule-soft);
    transition: background-color var(--dur-fast) var(--ease-standard);
  }
  .fila-poema:has(.fila-titulo a:hover),
  .fila-poema:has(.fila-titulo a:focus-visible) {
    background-color: var(--hover-tint);
  }
  .fila-num {
    grid-area: num;
    font-family: var(--font-body);
    font-size: var(--fs-md);
    color: var(--num);
  }
  .fila-titulo {
    grid-area: titulo;
    font-family: var(--font-body);
    font-size: var(--fs-lg);
    font-weight: 500;
    line-height: var(--lh-snug);
    margin: 0;
    color: var(--text);
  }
  .fila-titulo a {
    text-decoration: none;
    color: inherit;
    border-bottom: none;
  }
  .fila-titulo a::before {
    content: '';
    position: absolute;
    inset: 0;
  }
  .fila-poema:has(.fila-titulo a:hover) .fila-titulo,
  .fila-poema:has(.fila-titulo a:focus-visible) .fila-titulo {
    color: var(--oro-texto);
  }
  .fila-autor {
    grid-area: autor;
    font-family: var(--font-body);
    font-style: italic;
    font-size: var(--fs-sm);
    color: var(--text-muted);
  }
  .fila-tag {
    grid-area: tag;
    font-family: var(--font-meta);
    font-size: var(--fs-3xs);
    letter-spacing: var(--ls-wider);
    text-transform: uppercase;
    color: var(--oro-texto);
    text-align: right;
  }

  /* ── Barra «Descubrir»: 4 celdas con borde (handoff) ───────────────── */
  .descubrir-bar {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border: 1px solid var(--rule);
    margin: var(--space-2xl) 0;
  }
  .descubrir-celda {
    padding: var(--space-lg);
    text-align: center;
    text-decoration: none;
    border-right: 1px solid var(--rule);
    border-bottom: none;
    transition: background-color var(--dur-fast) var(--ease-standard);
  }
  .descubrir-celda:last-child {
    border-right: none;
  }
  .descubrir-celda:hover,
  .descubrir-celda:focus-visible {
    background-color: var(--hover-tint);
    border-bottom: none;
  }
  .descubrir-eyebrow {
    display: block;
    font-family: var(--font-meta);
    font-size: var(--fs-3xs);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-wider);
    text-transform: uppercase;
    color: var(--oro-texto);
    margin-bottom: var(--space-2xs);
  }
  .descubrir-nombre {
    display: block;
    font-family: var(--font-body);
    font-size: var(--fs-lg);
    color: var(--text);
  }
  .descubrir-celda:hover .descubrir-nombre,
  .descubrir-celda:focus-visible .descubrir-nombre {
    color: var(--oro-texto);
  }

  /* ── Pódcast «En voz alta»: fila con botón fantasma (handoff) ───────── */
  .seccion-podcast {
    margin-top: var(--space-2xl);
  }
  .podcast-fila {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-lg);
    padding: var(--space-lg) 0;
    border-top: 1px solid var(--rule);
  }
  .podcast-texto {
    margin: 0;
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: var(--space-sm) var(--space-md);
  }
  .podcast-eyebrow {
    font-family: var(--font-meta);
    font-size: var(--fs-3xs);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-widest);
    text-transform: uppercase;
    color: var(--oro-texto);
  }
  .podcast-desc {
    font-family: var(--font-body);
    font-weight: 500;
    font-size: var(--fs-lg);
    color: var(--text);
  }
  /* Botón fantasma: contorno en tinta que se rellena al hover. */
  .podcast-boton {
    flex: none;
    font-family: var(--font-meta);
    font-size: var(--fs-2xs);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-wider);
    text-transform: uppercase;
    color: var(--text);
    background: transparent;
    border: 1px solid var(--text);
    padding: 0.7em 1.5em;
    text-decoration: none;
    transition: background var(--dur-fast) var(--ease-standard),
      color var(--dur-fast) var(--ease-standard);
  }
  .podcast-boton:hover,
  .podcast-boton:focus-visible {
    background: var(--text);
    color: var(--bg);
    border-bottom: 1px solid var(--text);
  }

  @media (max-width: 680px) {
    .fila-poema {
      grid-template-columns: 2.4rem 1fr;
      grid-template-areas:
        'num titulo'
        'num autor'
        'num tag';
      row-gap: var(--space-3xs);
    }
    .fila-tag {
      text-align: left;
    }
    .descubrir-bar {
      grid-template-columns: repeat(2, 1fr);
    }
    .descubrir-celda {
      border-right: 1px solid var(--rule);
      border-bottom: 1px solid var(--rule);
    }
    .descubrir-celda:nth-child(2n) {
      border-right: none;
    }
    .descubrir-celda:nth-child(n + 3) {
      border-bottom: none;
    }
    .podcast-fila {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
