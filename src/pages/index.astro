---
import Base from '../layouts/Base.astro';
import JsonLd from '../components/JsonLd.astro';
import { buildWebSiteJsonLd } from '../utils/jsonld';
---

<Base titulo="El Poemario · Un breviario de versos y voces">
  <JsonLd slot="head" data={buildWebSiteJsonLd()} />

  <section class="hero">
    <h1>EL POEMARIO</h1>
    <p class="lema">
      Un breviario de versos y voces
    </p>
    <hr class="ornate" />
    <p class="intro">
      Una colección dirigida por
      D. Alejandro de Morales y Loaiza
    </p>
  </section>
</Base>

<style>
  .hero {
    text-align: center;
    padding: 3rem 0;
  }
  .hero h1 {
    font-size: 5rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    line-height: 1.05;
    color: var(--text);
    margin: 0;
  }
  .lema {
    font-style: italic;
    color: var(--text-soft);
    font-size: 1.2rem;
    margin: 1rem 0 2rem;
  }
  .intro {
    color: var(--text);
  }
</style>