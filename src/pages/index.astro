---
import { getCollection, getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import JsonLd from '../components/JsonLd.astro';
import Destacado from '../components/Destacado.astro';
import PoemaCard from '../components/PoemaCard.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE_TITLE } from '../consts';
import { getPagina } from '../utils/paginas';
import { buildWebSiteJsonLd } from '../utils/jsonld';

// Home hero text from src/content/paginas/home.md (editable in Decap).
// `titulo` here is the long descriptor (browser <title> suffix / og:title);
// `subtitulo` is the tagline antetítulo. The visible h1 is SITE_TITLE.
const home = await getPagina('home');

// Latest non-draft poems, newest first, capped at 6.
const ultimos = (await getCollection('poemas', ({ data }) => !data.borrador))
  .sort((a, b) => b.data.fecha.valueOf() - a.data.fecha.valueOf())
  .slice(0, 6);

// Author id→name map, so the grid renders authors without per-row awaits.
const autoresLista = await getCollection('autores');
const autoresPorId = new Map(autoresLista.map((a) => [a.id, a.data.nombre]));

// --- Destacado (curatorial singleton) ---
// Polymorphic: the referenced item can be a poema, an entrada or an autor.
// We resolve the reference here and validate the target has an image — Zod
// cannot do cross-collection lookups, so this validation lives at build time.
const destacadoEntries = await getCollection('destacado');
const destacadoCfg = destacadoEntries[0]; // singleton

type DestacadoRender = {
  cintillo: string;
  imagen: import('astro').ImageMetadata;
  alt: string;
  titulo: string;
  href: string;
  cta: string;
  resumen?: string;
  autorNombre?: string;
  fecha?: Date;
  nacionalidad?: string;
  anios?: string;
};

let destacado: DestacadoRender | null = null;

if (destacadoCfg && destacadoCfg.data.activo) {
  const { tipo, cintillo } = destacadoCfg.data;

  if (tipo === 'poema' && destacadoCfg.data.poema_referido) {
    const poema = await getEntry(destacadoCfg.data.poema_referido);
    if (!poema.data.ilustracion) {
      throw new Error(
        `[destacado] El poema "${poema.data.titulo}" no tiene ilustración. ` +
          `El destacado activo requiere imagen. Añade una ilustración o cambia el destacado.`,
      );
    }
    const autor = await getEntry(poema.data.autor);
    destacado = {
      cintillo,
      imagen: poema.data.ilustracion,
      alt: '',
      titulo: poema.data.titulo,
      href: `/poemas/${poema.id}/`,
      cta: 'Leer el poema',
      resumen: poema.data.resumen,
      autorNombre: autor.data.nombre,
      fecha: poema.data.fecha,
    };
  } else if (tipo === 'entrada' && destacadoCfg.data.entrada_referida) {
    const entrada = await getEntry(destacadoCfg.data.entrada_referida);
    if (!entrada.data.ilustracion) {
      throw new Error(
        `[destacado] La entrada "${entrada.data.titulo}" no tiene ilustración. ` +
          `El destacado activo requiere imagen. Añade una ilustración o cambia el destacado.`,
      );
    }
    destacado = {
      cintillo,
      imagen: entrada.data.ilustracion,
      alt: '',
      titulo: entrada.data.titulo,
      href: `/entradas/${entrada.id}/`,
      cta: 'Leer la entrada',
      resumen: entrada.data.resumen,
      autorNombre: entrada.data.curador,
      fecha: entrada.data.fecha,
    };
  } else if (tipo === 'autor' && destacadoCfg.data.autor_referido) {
    const autor = await getEntry(destacadoCfg.data.autor_referido);
    if (!autor.data.imagen) {
      throw new Error(
        `[destacado] El autor "${autor.data.nombre}" no tiene retrato. ` +
          `El destacado activo requiere imagen. Añade un retrato o cambia el destacado.`,
      );
    }
    const aniosAutor =
      autor.data.nacimiento && autor.data.muerte
        ? `${autor.data.nacimiento}–${autor.data.muerte}`
        : undefined;
    destacado = {
      cintillo,
      imagen: autor.data.imagen,
      alt: `Retrato de ${autor.data.nombre}`,
      titulo: autor.data.nombre,
      href: `/autores/${autor.id}/`,
      cta: 'Ver la ficha',
      nacionalidad: autor.data.nacionalidad,
      anios: aniosAutor,
    };
  }
}
---

<Base titulo={`${SITE_TITLE} · ${home.data.titulo}`} descripcion={home.data.descripcion}>
  <JsonLd slot="head" data={buildWebSiteJsonLd()} />

  <section class="hero">
    <div class="rayos" aria-hidden="true"></div>
    <p class="antetitulo">{home.data.subtitulo}</p>
    <h1>{SITE_TITLE}</h1>
    <div class="divisor-rombo" role="presentation">
      <span class="divisor-rombo-pieza"></span>
      <span class="divisor-rombo-diamante"></span>
      <span class="divisor-rombo-pieza"></span>
    </div>
  </section>

  {destacado && (
    <Destacado
      cintillo={destacado.cintillo}
      imagen={destacado.imagen}
      alt={destacado.alt}
      titulo={destacado.titulo}
      href={destacado.href}
      cta={destacado.cta}
      resumen={destacado.resumen}
    >
      <Fragment slot="submeta">
        {destacado.autorNombre && destacado.fecha && (
          <p>por {destacado.autorNombre} · <FormattedDate date={destacado.fecha} /></p>
        )}
        {!destacado.autorNombre && destacado.fecha && (
          <p><FormattedDate date={destacado.fecha} /></p>
        )}
        {(destacado.nacionalidad || destacado.anios) && (
          <p>{[destacado.nacionalidad, destacado.anios].filter(Boolean).join(' · ')}</p>
        )}
      </Fragment>
    </Destacado>
  )}

  {ultimos.length > 0 && (
    <section class="seccion-poemas" aria-labelledby="ultimos-titulo">
      <h2 id="ultimos-titulo" class="seccion-titulo">Últimos poemas</h2>
      <ul class="poemas">
        {ultimos.map((poema) => (
          <li>
            <PoemaCard
              poema={poema}
              autorNombre={autoresPorId.get(poema.data.autor.id) ?? ''}
            />
          </li>
        ))}
      </ul>
      <p class="ver-todo">
        <a href="/poemas/">Ver todo el catálogo</a>
      </p>
    </section>
  )}

  <section class="seccion-explorar" aria-labelledby="explorar-titulo">
    <p id="explorar-titulo" class="eyebrow">— Explorar —</p>
    <ul class="exploracion">
      <li>
        <a href="/poemas/">
          <span class="numeral" aria-hidden="true">I</span>
          <h3 class="titulo-explorar">Catálogo</h3>
          <p class="descripcion-explorar">Todos los poemas.</p>
        </a>
      </li>
      <li>
        <a href="/autores/">
          <span class="numeral" aria-hidden="true">II</span>
          <h3 class="titulo-explorar">Autores</h3>
          <p class="descripcion-explorar">Clásicos y colaboradores.</p>
        </a>
      </li>
      <li>
        <button type="button" class="explorar-trigger" data-buscador-trigger>
          <span class="numeral" aria-hidden="true">III</span>
          <h3 class="titulo-explorar">Búsqueda</h3>
          <p class="descripcion-explorar">Por título o autor.</p>
        </button>
      </li>
      <li>
        <a href="/colaborar/">
          <span class="numeral" aria-hidden="true">IV</span>
          <h3 class="titulo-explorar">Colaborar</h3>
          <p class="descripcion-explorar">¿Escribes poesía?</p>
        </a>
      </li>
    </ul>
  </section>
</Base>

<style>
  /* ── Héroe ────────────────────────────────────────────────────────── */
  .hero {
    position: relative;
    text-align: center;
    margin-bottom: var(--space-2xl);
    padding-block: var(--space-2xl);
    overflow: hidden;
  }
  /* Líneas radiantes Art Déco: rayos finos de oro emanando tras el título,
     enmascarados con degradado radial para desvanecerse en los bordes.
     CSS puro, sin SVG. Faint by design. */
  .hero .rayos {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background: repeating-conic-gradient(
      from 0deg at 50% 42%,
      color-mix(in srgb, var(--oro) 32%, transparent) 0deg 0.4deg,
      transparent 0.4deg 9deg
    );
    -webkit-mask-image: radial-gradient(ellipse 58% 62% at 50% 42%, #000 0%, transparent 70%);
    mask-image: radial-gradient(ellipse 58% 62% at 50% 42%, #000 0%, transparent 70%);
    opacity: 0.55;
  }
  .hero > :not(.rayos) {
    position: relative;
    z-index: 1;
  }

  .antetitulo {
    font-family: var(--font-meta);
    font-size: var(--fs-xs);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-widest);
    text-transform: uppercase;
    color: var(--oro-texto);
    margin: 0 0 var(--space-sm);
  }

  .hero h1 {
    margin: 0 0 var(--space-md);
    font-size: var(--fs-4xl);
    text-wrap: balance;
  }

  /* ── Divisor de rombo (mismo lenguaje que la página de poema) ──────── */
  .divisor-rombo {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-sm);
    margin: 0 auto;
    max-width: 80%;
  }
  .divisor-rombo-pieza {
    flex: 1;
    height: 0;
    border-top: var(--rule-hairline) solid var(--oro);
    max-width: 8rem;
  }
  .divisor-rombo-diamante {
    width: 0.6rem;
    height: 0.6rem;
    flex-shrink: 0;
    transform: rotate(45deg);
    border: 1px solid var(--oro);
    background: color-mix(in srgb, var(--oro) 30%, transparent);
  }

  /* ── Secciones ────────────────────────────────────────────────────── */
  .seccion-poemas {
    margin-bottom: var(--space-2xl);
  }
  .seccion-titulo {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-md);
    font-size: var(--fs-xl);
    margin: 0 0 var(--space-xl);
  }
  .seccion-titulo::before,
  .seccion-titulo::after {
    content: '';
    height: 0;
    border-top: var(--rule-hairline) solid var(--oro);
    width: clamp(2rem, 12%, 6rem);
  }
  ul.poemas {
    list-style: none;
    padding: 0;
    margin: 0 auto;
    max-width: var(--measure-grid);
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0;
    border-top: 1px solid var(--line);
    border-left: 1px solid var(--line);
  }
  .ver-todo {
    text-align: center;
    margin: var(--space-2xl) 0 0;
  }
  .ver-todo a {
    font-family: var(--font-meta);
    font-size: var(--fs-2xs);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-wider);
    text-transform: uppercase;
    color: var(--oro-texto);
    text-decoration: none;
    border-bottom: 1px solid color-mix(in srgb, var(--oro) 45%, transparent);
    padding-bottom: 0.2em;
  }
  .ver-todo a:hover,
  .ver-todo a:focus-visible {
    border-bottom-color: var(--oro);
  }

  .seccion-explorar {
    text-align: center;
  }
  .eyebrow {
    font-family: var(--font-meta);
    font-size: var(--fs-3xs);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-widest);
    text-transform: uppercase;
    color: var(--oro-texto);
    max-width: none;
    margin: 0 0 var(--space-2xs);
  }
  .seccion-explorar .seccion-titulo {
    margin: 0 0 var(--space-xl);
  }
  ul.exploracion {
    list-style: none;
    padding: 0;
    margin: 0;
    max-width: none;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    column-gap: var(--space-xl);
    row-gap: var(--space-lg);
  }
  ul.exploracion a,
  ul.exploracion .explorar-trigger {
    display: block;
    width: 100%;
    text-decoration: none;
    color: inherit;
    padding: var(--space-md) 0;
    background: transparent;
    border: 0;
    font: inherit;
    text-align: inherit;
    cursor: pointer;
  }
  .numeral {
    display: block;
    font-family: var(--font-display);
    font-size: var(--fs-3xs);
    font-weight: var(--fw-bold);
    letter-spacing: var(--ls-wide);
    color: var(--oro-texto);
    margin: 0 0 var(--space-2xs);
  }
  .titulo-explorar {
    font-family: var(--font-display);
    font-size: var(--fs-sm);
    font-weight: var(--fw-bold);
    letter-spacing: var(--ls-wide);
    line-height: var(--lh-snug);
    margin: 0 0 var(--space-2xs);
    color: var(--text);
    text-transform: uppercase;
  }
  ul.exploracion a:hover .titulo-explorar,
  ul.exploracion a:focus-visible .titulo-explorar,
  ul.exploracion .explorar-trigger:hover .titulo-explorar,
  ul.exploracion .explorar-trigger:focus-visible .titulo-explorar {
    color: var(--oro-texto);
  }
  .descripcion-explorar {
    font-family: var(--font-body);
    font-style: italic;
    font-size: var(--fs-sm);
    color: var(--text-soft);
    margin: 0;
  }

  @media (max-width: 900px) {
    ul.exploracion {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: var(--space-2xl);
    }
  }
  @media (max-width: 720px) {
    ul.exploracion {
      grid-template-columns: 1fr;
      row-gap: var(--space-xl);
    }
  }
  @media (max-width: 680px) {
    ul.poemas {
      grid-template-columns: 1fr;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero .rayos { opacity: 0.4; }
  }
</style>
