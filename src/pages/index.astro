---
import Base from '../layouts/Base.astro';
---

<Base titulo="Inicio">
  <section class="hero">
    <h1>EL POEMARIO</h1>
    <p class="lema">
      Antología viva de la poesía en lengua castellana
    </p>
    <hr class="ornate" />
    <p class="intro">
      Un breviario de versos y voces, en construcción.
    </p>
  </section>
</Base>

<style>
  .hero {
    text-align: center;
    padding: 3rem 0;
  }
  .hero h1 {
    font-size: 5rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    line-height: 1.05;
    color: var(--text);
    margin: 0;
  }
  .lema {
    font-style: italic;
    color: var(--text-soft);
    font-size: 1.2rem;
    margin: 1rem 0 2rem;
  }
  .intro {
    color: var(--text);
  }
</style>