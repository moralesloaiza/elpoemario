---
import { getCollection, getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import JsonLd from '../components/JsonLd.astro';
import HeroInmersivo from '../components/HeroInmersivo.astro';
import FilaPoema from '../components/FilaPoema.astro';
import { FOCO_RETRATO, SITE_TITLE, SPOTIFY_SHOW_URL } from '../consts';
import { getPagina } from '../utils/paginas';
import { buildWebSiteJsonLd } from '../utils/jsonld';
import type { ImageMetadata } from 'astro';

// Home hero text from src/content/paginas/home.md (editable in Decap).
// `rotulo` is the short antetitulo above the heading; `titulo` is the long
// descriptor (browser <title> suffix / og:title), not rendered visibly;
// `subtitulo` is the italic tagline, which now IS the page <h1> (the body no
// longer repeats "El Poemario" — the wordmark lives in the masthead — but the
// page keeps a real h1 for SEO/a11y, falling back to SITE_TITLE if empty);
// `lema` is an optional secondary italic line below.
const home = await getPagina('home');

// Latest non-draft poems, newest first, capped at 6.
const ultimos = (await getCollection('poemas', ({ data }) => !data.borrador))
  .sort((a, b) => b.data.fecha.valueOf() - a.data.fecha.valueOf())
  .slice(0, 6);

// Author id->name map, so the grid renders authors without per-row awaits.
const autoresLista = await getCollection('autores');
const autoresPorId = new Map(autoresLista.map((a) => [a.id, a.data.nombre]));

// --- Destacado (curatorial singleton) ---
// Polymorphic: the referenced item can be a poema, an entrada or an autor.
// We resolve the reference here and validate the target has an image — Zod
// cannot do cross-collection lookups, so this validation lives at build time.
const destacadoEntries = await getCollection('destacado');
const destacadoCfg = destacadoEntries[0]; // singleton

type DestacadoRender = {
  cintillo: string;
  titulo: string;
  href: string;
  cta: string;
  imagen: ImageMetadata;
  /* Encuadre vertical de la ilustración en el hero. Viaja con la imagen: el
     `foco` que el curador eligió para el poema/entrada/autor vale igual aquí,
     porque el hero de portada usa el mismo recorte que el de su ficha. */
  foco?: number;
  byline?: string;
  versos?: string[];
  resumen?: string;
};

let destacado: DestacadoRender | null = null;

if (destacadoCfg && destacadoCfg.data.activo) {
  const { tipo, cintillo } = destacadoCfg.data;

  if (tipo === 'poema' && destacadoCfg.data.poema_referido) {
    const poema = await getEntry(destacadoCfg.data.poema_referido);
    if (!poema.data.ilustracion) {
      throw new Error(
        `Destacado activo referencia el poema "${poema.id}" sin \`ilustracion\`. La imagen es obligatoria para destacar.`,
      );
    }
    const autor = await getEntry(poema.data.autor);
    // Verse extract is curator-set on the destacado singleton: one verse per
    // line. Falls back to no extract if the field is empty.
    const versos = (destacadoCfg.data.extracto ?? '')
      .split(/\r?\n/)
      .map((linea) => linea.trim())
      .filter(Boolean);
    destacado = {
      cintillo,
      titulo: poema.data.titulo,
      href: `/poemas/${poema.id}/`,
      cta: 'Leer el poema',
      imagen: poema.data.ilustracion,
      foco: poema.data.foco,
      byline: autor.data.nombre,
      versos,
    };
  } else if (tipo === 'entrada' && destacadoCfg.data.entrada_referida) {
    const entrada = await getEntry(destacadoCfg.data.entrada_referida);
    if (!entrada.data.ilustracion) {
      throw new Error(
        `Destacado activo referencia la entrada "${entrada.id}" sin \`ilustracion\`. La imagen es obligatoria para destacar.`,
      );
    }
    destacado = {
      cintillo,
      titulo: entrada.data.titulo,
      href: `/entradas/${entrada.id}/`,
      cta: 'Leer la entrada',
      imagen: entrada.data.ilustracion,
      foco: entrada.data.foco,
      byline: entrada.data.curador,
      resumen: entrada.data.resumen,
    };
  } else if (tipo === 'autor' && destacadoCfg.data.autor_referido) {
    const autor = await getEntry(destacadoCfg.data.autor_referido);
    if (!autor.data.imagen) {
      throw new Error(
        `Destacado activo referencia al autor "${autor.id}" sin \`imagen\`. La imagen es obligatoria para destacar.`,
      );
    }
    const aniosAutor =
      autor.data.nacimiento && autor.data.muerte
        ? `${autor.data.nacimiento}–${autor.data.muerte}`
        : undefined;
    destacado = {
      cintillo,
      titulo: autor.data.nombre,
      href: `/autores/${autor.id}/`,
      cta: 'Ver la ficha',
      imagen: autor.data.imagen,
      // Retrato, no ilustración: default propio, y el mismo que usa su ficha.
      foco: autor.data.foco ?? FOCO_RETRATO,
      byline: [autor.data.nacionalidad, aniosAutor].filter(Boolean).join(' · ') || undefined,
      resumen: autor.data.descripcion,
    };
  }
}

// Decisión: el Inicio SIEMPRE lleva un destacado activo con imagen — es el hero
// inmersivo de la portada (handoff 3A). Sin destacado no hay hero, así que se
// exige a nivel de build con un error claro.
if (!destacado) {
  throw new Error(
    'El Inicio requiere un destacado activo con imagen (es el hero de portada). ' +
      'Activa uno en src/content/destacado (campo `activo: true` y una referencia con `ilustracion`/`imagen`).',
  );
}

// Extracto del hero: versos (poema) o resumen (entrada/autor), como en el
// bloque destacado original.
const tieneVersos = Array.isArray(destacado.versos) && destacado.versos.length > 0;
---

<Base titulo={`${SITE_TITLE} · ${home.data.titulo}`} descripcion={home.data.descripcion} heroInmersivo>
  <JsonLd slot="head" data={buildWebSiteJsonLd()} />

  {/* Hero de portada (handoff 3A): la ilustración del destacado a sangre, con la
      nav flotando encima (Base) y el bloque del destacado anclado abajo a la
      izquierda. El título del destacado es el <h1> semántico de la portada
      (SEO/a11y); el tagline se retiró para dar aire al hero. */}
  <HeroInmersivo slot="hero" imagen={destacado.imagen} foco={destacado.foco} align="left" maxAncho="40rem">
    <p class="hero-eyebrow">{destacado.cintillo}</p>
    <h1 class="hero-titulo"><a href={destacado.href}>{destacado.titulo}</a></h1>
    {destacado.byline && <p class="hero-byline">{destacado.byline}</p>}
    {tieneVersos ? (
      <div class="home-hero-cita">
        {destacado.versos!.map((verso) => <span>{verso}</span>)}
      </div>
    ) : (
      destacado.resumen && <p class="home-hero-sumario">{destacado.resumen}</p>
    )}
    <a class="home-hero-cta" href={destacado.href}>{destacado.cta}</a>
  </HeroInmersivo>

  {ultimos.length > 0 && (
    <section class="seccion-poemas" aria-labelledby="ultimos-titulo">
      <div class="seccion-cab">
        <h2 id="ultimos-titulo" class="seccion-titulo">Últimos poemas</h2>
        <a class="ver-todo" href="/poemas/">Ver todo el catálogo →</a>
      </div>
      <ul class="lista-poemas">
        {ultimos.map((poema, i) => (
          <FilaPoema
            poema={poema}
            autorNombre={autoresPorId.get(poema.data.autor.id) ?? ''}
            indice={i + 1}
          />
        ))}
      </ul>
    </section>
  )}

  {home.data.taller_titulo && (
    <section class="seccion-taller" aria-labelledby="taller-titulo">
      <div class="taller-card">
        <div class="taller-card-texto">
          {home.data.taller_eyebrow && <span class="taller-eyebrow">{home.data.taller_eyebrow}</span>}
          <h2 id="taller-titulo" class="taller-titulo">{home.data.taller_titulo}</h2>
        </div>
        <a class="taller-boton" href="/taller/">{home.data.taller_cta ?? 'Abrir el taller'}</a>
      </div>
    </section>
  )}

  <nav class="descubrir-bar" aria-label="Descubrir por facetas">
    <a class="descubrir-celda" href="/tipos/">
      <span class="descubrir-eyebrow">Descubrir</span>
      <span class="descubrir-nombre">Por forma</span>
    </a>
    <a class="descubrir-celda" href="/temas/">
      <span class="descubrir-eyebrow">Descubrir</span>
      <span class="descubrir-nombre">Por tema</span>
    </a>
    <a class="descubrir-celda" href="/siglos/">
      <span class="descubrir-eyebrow">Descubrir</span>
      <span class="descubrir-nombre">Por siglo</span>
    </a>
    <a class="descubrir-celda" href="/nacionalidades/">
      <span class="descubrir-eyebrow">Descubrir</span>
      <span class="descubrir-nombre">Por país</span>
    </a>
  </nav>

  <section class="seccion-podcast">
    <div class="podcast-fila">
      <h2 class="podcast-texto">
        <span class="podcast-eyebrow">{home.data.podcast_titulo}</span>
        <span class="podcast-desc">{home.data.podcast_eyebrow}</span>
      </h2>
      <a class="podcast-boton" href={SPOTIFY_SHOW_URL} target="_blank" rel="noopener">
        {home.data.podcast_cta}
      </a>
    </div>
  </section>
</Base>

<style>
  /* ── Hero de portada (3A): contenido del destacado sobre la ilustración ──
     El shell (imagen, degradado, posición, alineación) lo aporta HeroInmersivo;
     el eyebrow/título/autor usan las utilidades globales .hero-* (tokens.css).
     Aquí van los roles propios del destacado (epígrafe, cita, sumario, CTA), en
     tokens --hero-*, que siguen al tema día/noche. */
  /* Extracto en verso (destacado = poema): una línea por verso. */
  .home-hero-cita {
    font-family: var(--font-body);
    font-style: italic;
    font-size: var(--fs-lg);
    line-height: var(--lh-snug);
    color: var(--hero-ink-soft);
    margin: var(--space-sm) 0 var(--space-lg);
  }
  .home-hero-cita span {
    display: block;
  }
  /* Extracto en prosa (destacado = entrada / autor). */
  .home-hero-sumario {
    font-family: var(--font-prose);
    font-size: var(--fs-md);
    line-height: var(--lh-prosa);
    color: var(--hero-ink-soft);
    margin: var(--space-sm) 0 var(--space-lg);
  }
  /* CTA sólido (handoff 3A); hover a contorno. Usa los tokens de botón del tema
     en vez de un par fijo: en noche coinciden con el oro/tinta de siempre, y en
     día evitan el par que salía de --hero-rule + tinta oscura (2.3:1). */
  .home-hero-cta {
    display: inline-block;
    font-family: var(--font-meta);
    font-size: var(--fs-2xs);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-wider);
    text-transform: uppercase;
    color: var(--btn-ink);
    background: var(--btn-bg);
    padding: 0.85em 1.75em;
    border: 1px solid var(--btn-bg);
    text-decoration: none;
    transition: background var(--dur-fast) var(--ease-standard),
      color var(--dur-fast) var(--ease-standard);
  }
  .home-hero-cta:hover,
  .home-hero-cta:focus-visible {
    background: transparent;
    color: var(--hero-accent);
    border-bottom: 1px solid var(--hero-rule);
  }

  /* ── Secciones ─────────────────────────────────────────────────────── */
  /* El cuerpo arranca tras el hero (Base quita el padding superior); se recupera
     el respiro aquí. */
  .seccion-poemas {
    margin: var(--space-2xl) 0;
  }
  /* Cabecera de sección: título a la izquierda, «ver todo» a la derecha
     (handoff). */
  .seccion-cab {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-md);
    margin-bottom: var(--space-lg);
  }
  .seccion-titulo {
    font-family: var(--font-body);
    font-size: var(--fs-xl);
    font-weight: 500;
    text-transform: none;
    letter-spacing: 0;
    margin: 0;
    color: var(--text);
  }
  .ver-todo {
    font-family: var(--font-meta);
    font-size: var(--fs-3xs);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-wider);
    text-transform: uppercase;
    color: var(--oro-texto);
    text-decoration: none;
    white-space: nowrap;
    border-bottom: none;
  }
  .ver-todo:hover,
  .ver-todo:focus-visible {
    color: var(--oro);
    border-bottom: none;
  }

  /* Índice «Últimos poemas» como lista de filas compartidas (FilaPoema): nº ·
     título · autor · etiqueta. Cada fila trae su propio filete superior. */
  .lista-poemas {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* ── Franja «Novedad»: El Taller. Tarjeta con borde oro + botón sólido,
        para leerse como destacado (a diferencia de la fila mínima del pódcast). */
  .seccion-taller {
    margin: var(--space-2xl) 0;
  }
  .taller-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-lg);
    background: var(--mat);
    border: 1px solid var(--oro);
    padding: var(--space-lg) var(--space-xl);
  }
  .taller-card-texto {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
  }
  .taller-eyebrow {
    font-family: var(--font-meta);
    font-size: var(--fs-3xs);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-widest);
    text-transform: uppercase;
    color: var(--oro-texto);
  }
  .taller-titulo {
    margin: 0;
    font-family: var(--font-body);
    font-weight: 500;
    font-size: var(--fs-lg);
    text-transform: none;
    letter-spacing: 0;
    color: var(--text);
    text-wrap: balance;
  }
  .taller-boton {
    flex: none;
    font-family: var(--font-meta);
    font-size: var(--fs-2xs);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-wider);
    text-transform: uppercase;
    color: var(--btn-ink);
    background: var(--btn-bg);
    padding: 0.85em 1.75em;
    border: 1px solid var(--btn-bg);
    text-decoration: none;
    transition: background var(--dur-fast) var(--ease-standard),
      color var(--dur-fast) var(--ease-standard),
      border-color var(--dur-fast) var(--ease-standard);
  }
  .taller-boton:hover,
  .taller-boton:focus-visible {
    background: transparent;
    color: var(--oro);
    border-color: var(--oro);
  }
  @media (max-width: 680px) {
    .taller-card {
      flex-direction: column;
      align-items: flex-start;
    }
  }

  /* ── Barra «Descubrir»: 4 celdas con borde (handoff) ───────────────── */
  .descubrir-bar {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border: 1px solid var(--rule);
    margin: var(--space-2xl) 0;
  }
  .descubrir-celda {
    padding: var(--space-lg);
    text-align: center;
    text-decoration: none;
    border-right: 1px solid var(--rule);
    border-bottom: none;
    transition: background-color var(--dur-fast) var(--ease-standard);
  }
  .descubrir-celda:last-child {
    border-right: none;
  }
  .descubrir-celda:hover,
  .descubrir-celda:focus-visible {
    background-color: var(--hover-tint);
    border-bottom: none;
  }
  .descubrir-eyebrow {
    display: block;
    font-family: var(--font-meta);
    font-size: var(--fs-3xs);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-wider);
    text-transform: uppercase;
    color: var(--oro-texto);
    margin-bottom: var(--space-2xs);
  }
  .descubrir-nombre {
    display: block;
    font-family: var(--font-body);
    font-size: var(--fs-lg);
    color: var(--text);
  }
  .descubrir-celda:hover .descubrir-nombre,
  .descubrir-celda:focus-visible .descubrir-nombre {
    color: var(--oro-texto);
  }

  /* ── Pódcast «En voz alta»: fila con botón fantasma (handoff) ───────── */
  .seccion-podcast {
    margin-top: var(--space-2xl);
  }
  .podcast-fila {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-lg);
    padding: var(--space-lg) 0;
    border-top: 1px solid var(--rule);
  }
  .podcast-texto {
    margin: 0;
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: var(--space-sm) var(--space-md);
  }
  .podcast-eyebrow {
    font-family: var(--font-meta);
    font-size: var(--fs-3xs);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-widest);
    text-transform: uppercase;
    color: var(--oro-texto);
  }
  .podcast-desc {
    font-family: var(--font-body);
    font-weight: 500;
    font-size: var(--fs-lg);
    color: var(--text);
  }
  /* Botón fantasma: contorno en tinta que se rellena al hover. */
  .podcast-boton {
    flex: none;
    font-family: var(--font-meta);
    font-size: var(--fs-2xs);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-wider);
    text-transform: uppercase;
    color: var(--text);
    background: transparent;
    border: 1px solid var(--text);
    padding: 0.7em 1.5em;
    text-decoration: none;
    transition: background var(--dur-fast) var(--ease-standard),
      color var(--dur-fast) var(--ease-standard);
  }
  .podcast-boton:hover,
  .podcast-boton:focus-visible {
    background: var(--text);
    color: var(--bg);
    border-bottom: 1px solid var(--text);
  }

  /* En móvil el hero de portada se compacta: el extracto (resumen/verso) se
     oculta para que el bloque quepa sin empujar demasiado el cuerpo. El texto
     completo vive en la página enlazada por el título y el CTA. */
  @media (max-width: 700px) {
    .home-hero-cita,
    .home-hero-sumario {
      display: none;
    }
  }

  @media (max-width: 680px) {
    .descubrir-bar {
      grid-template-columns: repeat(2, 1fr);
    }
    .descubrir-celda {
      border-right: 1px solid var(--rule);
      border-bottom: 1px solid var(--rule);
    }
    .descubrir-celda:nth-child(2n) {
      border-right: none;
    }
    .descubrir-celda:nth-child(n + 3) {
      border-bottom: none;
    }
    .podcast-fila {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
