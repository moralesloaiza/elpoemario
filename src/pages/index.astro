---
import { getCollection, getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import JsonLd from '../components/JsonLd.astro';
import Destacado from '../components/Destacado.astro';
import PoemaCard from '../components/PoemaCard.astro';
import { SITE_TITLE, SPOTIFY_SHOW_URL } from '../consts';
import { getPagina } from '../utils/paginas';
import { buildWebSiteJsonLd } from '../utils/jsonld';

// Home hero text from src/content/paginas/home.md (editable in Decap).
// `rotulo` is the short antetitulo above the h1; `titulo` is the long
// descriptor (browser <title> suffix / og:title) and is not rendered
// visibly; `subtitulo` is the real visible subtitle under the h1; `lema`
// is the italic tagline further below. The visible h1 is SITE_TITLE.
const home = await getPagina('home');

// Latest non-draft poems, newest first, capped at 6.
const ultimos = (await getCollection('poemas', ({ data }) => !data.borrador))
  .sort((a, b) => b.data.fecha.valueOf() - a.data.fecha.valueOf())
  .slice(0, 6);

// Author id->name map, so the grid renders authors without per-row awaits.
const autoresLista = await getCollection('autores');
const autoresPorId = new Map(autoresLista.map((a) => [a.id, a.data.nombre]));

// --- Destacado (curatorial singleton) ---
// Polymorphic: the referenced item can be a poema, an entrada or an autor.
// We resolve the reference here and validate the target has an image — Zod
// cannot do cross-collection lookups, so this validation lives at build time.
const destacadoEntries = await getCollection('destacado');
const destacadoCfg = destacadoEntries[0]; // singleton

type DestacadoRender = {
  cintillo: string;
  titulo: string;
  href: string;
  cta: string;
  byline?: string;
  versos?: string[];
  resumen?: string;
};

let destacado: DestacadoRender | null = null;

if (destacadoCfg && destacadoCfg.data.activo) {
  const { tipo, cintillo } = destacadoCfg.data;

  if (tipo === 'poema' && destacadoCfg.data.poema_referido) {
    const poema = await getEntry(destacadoCfg.data.poema_referido);
    const autor = await getEntry(poema.data.autor);
    // Verse extract is curator-set on the destacado singleton: one verse per
    // line. Falls back to no extract if the field is empty.
    const versos = (destacadoCfg.data.extracto ?? '')
      .split(/\r?\n/)
      .map((linea) => linea.trim())
      .filter(Boolean);
    destacado = {
      cintillo,
      titulo: poema.data.titulo,
      href: `/poemas/${poema.id}/`,
      cta: 'Leer el poema',
      byline: autor.data.nombre,
      versos,
    };
  } else if (tipo === 'entrada' && destacadoCfg.data.entrada_referida) {
    const entrada = await getEntry(destacadoCfg.data.entrada_referida);
    destacado = {
      cintillo,
      titulo: entrada.data.titulo,
      href: `/entradas/${entrada.id}/`,
      cta: 'Leer la entrada',
      byline: entrada.data.curador,
      resumen: entrada.data.resumen,
    };
  } else if (tipo === 'autor' && destacadoCfg.data.autor_referido) {
    const autor = await getEntry(destacadoCfg.data.autor_referido);
    const aniosAutor =
      autor.data.nacimiento && autor.data.muerte
        ? `${autor.data.nacimiento}–${autor.data.muerte}`
        : undefined;
    destacado = {
      cintillo,
      titulo: autor.data.nombre,
      href: `/autores/${autor.id}/`,
      cta: 'Ver la ficha',
      byline: [autor.data.nacionalidad, aniosAutor].filter(Boolean).join(' · ') || undefined,
      resumen: autor.data.descripcion,
    };
  }
}
---

<Base titulo={`${SITE_TITLE} · ${home.data.titulo}`} descripcion={home.data.descripcion}>
  <JsonLd slot="head" data={buildWebSiteJsonLd()} />

  <section class="hero">
    {home.data.rotulo && <p class="antetitulo">{home.data.rotulo}</p>}
    <h1>{SITE_TITLE}</h1>
    {home.data.subtitulo && <p class="subtitulo">{home.data.subtitulo}</p>}
    {home.data.lema && <p class="lema">{home.data.lema}</p>}
    <div class="divisor" aria-hidden="true"><span></span><span></span><span></span></div>
  </section>

  {destacado && (
    <Destacado
      cintillo={destacado.cintillo}
      titulo={destacado.titulo}
      href={destacado.href}
      cta={destacado.cta}
      byline={destacado.byline}
      versos={destacado.versos}
      resumen={destacado.resumen}
    />
  )}

  {ultimos.length > 0 && (
    <section class="seccion-poemas" aria-labelledby="ultimos-titulo">
      <h2 id="ultimos-titulo" class="seccion-titulo">Últimos poemas</h2>
      <ul class="poemas">
        {ultimos.map((poema) => (
          <li>
            <PoemaCard
              poema={poema}
              autorNombre={autoresPorId.get(poema.data.autor.id) ?? ''}
            />
          </li>
        ))}
      </ul>
      <p class="ver-todo">
        <a href="/poemas/">Ver todo el catálogo</a>
      </p>
    </section>
  )}

  <section class="seccion-podcast" aria-labelledby="podcast-titulo">
    <h2 id="podcast-titulo" class="seccion-titulo">El Poemario en voz alta</h2>
    <p class="podcast-subtitulo">Nuestro pódcast: cada selección, leída para la noche</p>
    <a class="podcast" href={SPOTIFY_SHOW_URL} target="_blank" rel="noopener">
      <span class="podcast-play" aria-hidden="true">
        <svg viewBox="0 0 48 48" width="48" height="48" xmlns="http://www.w3.org/2000/svg">
          <circle cx="24" cy="24" r="22" fill="none" stroke="currentColor" stroke-width="1.5" />
          <polygon points="20,16 20,32 34,24" fill="currentColor" />
        </svg>
      </span>
      <span class="podcast-cuerpo">
        <span class="podcast-eyebrow">Pódcast · Spotify</span>
        <span class="podcast-titulo">Escuchar El Poemario</span>
        <span class="podcast-glosa">Don Alejandro lee la antología en voz alta.</span>
      </span>
      <span class="podcast-ext" aria-hidden="true">↗</span>
    </a>
  </section>
</Base>

<style>
  /* ── Héroe ─────────────────────────────────────────────────────────── */
  .hero {
    position: relative;
    text-align: center;
    margin-bottom: 0;
    padding-top: var(--space-2xl);
    padding-bottom: var(--space-lg);
  }

  .antetitulo {
    font-family: var(--font-meta);
    font-size: var(--fs-xs);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-widest);
    text-transform: uppercase;
    color: var(--oro-texto);
    margin: 0 0 var(--space-sm);
  }

  .hero h1 {
    margin: 0 0 var(--space-md);
    font-size: var(--fs-3xl);
    text-wrap: balance;
  }

  /* Tagline en cursiva bajo el título (editable: home.lema). */
  .lema {
    font-family: var(--font-body);
    font-style: italic;
    font-size: var(--fs-lg);
    line-height: var(--lh-snug);
    color: var(--text-soft);
    max-width: var(--measure-narrow);
    margin: 0 auto var(--space-md);
  }

  /* Overrides solo-Inicio: no tocar .subtitulo ni .divisor globales */
  .subtitulo {
    font-size: 1.25rem; /* 20px, +2px sobre --fs-md */
  }
  .hero .divisor {
    margin-bottom: var(--space-lg); /* 24px, era 48px */
  }

  /* ── Secciones ─────────────────────────────────────────────────────── */
  .seccion-poemas {
    margin-bottom: var(--space-2xl);
  }
  .seccion-titulo {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-md);
    font-size: var(--fs-xl);
    margin: 0 0 var(--space-xl);
  }
  .seccion-titulo::before,
  .seccion-titulo::after {
    content: '';
    height: 0;
    border-top: var(--rule-hairline) solid var(--oro);
    width: clamp(2rem, 12%, 6rem);
  }
  ul.poemas {
    list-style: none;
    padding: 0;
    margin: 0 auto;
    max-width: var(--measure-grid);
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0;
    border-top: 1px solid var(--line);
    border-left: 1px solid var(--line);
  }
  ul.poemas > li {
    display: grid;
  }
  .ver-todo {
    text-align: center;
    margin: var(--space-2xl) 0 0;
  }
  .ver-todo a {
    font-family: var(--font-meta);
    font-size: var(--fs-2xs);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-wider);
    text-transform: uppercase;
    color: var(--oro-texto);
    text-decoration: none;
    border-bottom: 1px solid color-mix(in srgb, var(--oro) 45%, transparent);
    padding-bottom: 0.2em;
  }
  .ver-todo a:hover,
  .ver-todo a:focus-visible {
    border-bottom-color: var(--oro);
  }

  /* ── Pódcast · El Poemario en voz alta ─────────────────────────────── */
  .seccion-podcast {
    text-align: center;
  }
  .podcast-subtitulo {
    font-family: var(--font-body);
    font-style: italic;
    font-size: var(--fs-md);
    color: var(--text-muted);
    margin: calc(-1 * var(--space-md)) 0 var(--space-xl);
  }
  .podcast {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
    max-width: var(--measure-narrow);
    margin: 0 auto;
    text-align: left;
    text-decoration: none;
    border: 1px solid var(--oro-suave);
    padding: var(--space-lg) var(--space-xl);
    transition: border-color var(--dur-fast) var(--ease-standard),
                background var(--dur-fast) var(--ease-standard);
  }
  .podcast:hover,
  .podcast:focus-visible {
    border-color: var(--oro);
    background: color-mix(in srgb, var(--oro) 5%, transparent);
  }
  .podcast-play {
    flex: none;
    display: inline-flex;
    line-height: 0;
    color: var(--oro-texto);
  }
  .podcast-play svg {
    width: 48px;
    height: 48px;
  }
  .podcast-cuerpo {
    flex: 1;
    display: block;
  }
  .podcast-eyebrow {
    display: block;
    font-family: var(--font-meta);
    font-size: var(--fs-3xs);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-wider);
    text-transform: uppercase;
    color: var(--oro-texto);
    margin: 0 0 var(--space-2xs);
  }
  .podcast-titulo {
    display: block;
    font-family: var(--font-display);
    font-size: var(--fs-lg);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-wide);
    color: var(--text);
  }
  .podcast:hover .podcast-titulo,
  .podcast:focus-visible .podcast-titulo {
    color: var(--oro-texto);
  }
  .podcast-glosa {
    display: block;
    font-family: var(--font-body);
    font-style: italic;
    font-size: var(--fs-md);
    color: var(--text-soft);
    margin-top: var(--space-2xs);
  }
  .podcast-ext {
    flex: none;
    font-family: var(--font-display);
    font-size: var(--fs-md);
    color: var(--oro-texto);
  }

  @media (max-width: 680px) {
    ul.poemas {
      grid-template-columns: 1fr;
    }
    .podcast {
      flex-direction: column;
      text-align: center;
      gap: var(--space-md);
    }
    .podcast-cuerpo {
      text-align: center;
    }
    .podcast-ext {
      display: none;
    }
  }
</style>
