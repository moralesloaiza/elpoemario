---
import Base from '../layouts/Base.astro';
import JsonLd from '../components/JsonLd.astro';
import { SITE_TITLE, SITE_SUBTITLE, SITE_TAGLINE } from '../consts';
import { buildWebSiteJsonLd } from '../utils/jsonld';
---

<Base titulo={`${SITE_TITLE} · ${SITE_TAGLINE}`}>
  <JsonLd slot="head" data={buildWebSiteJsonLd()} />

  <section class="hero">
    <h1>{SITE_TITLE}</h1>
    <p class="subtitulo">{SITE_SUBTITLE}</p>
  </section>
</Base>

<style>
  .hero {
    text-align: center;
    margin-bottom: var(--space-2xl);
  }
  .hero h1 {
    margin: 0 0 var(--space-md);
    font-size: var(--fs-4xl);
    text-wrap: balance;
  }
  .subtitulo {
    font-family: var(--font-body);
    font-style: italic;
    font-size: var(--fs-lg);
    line-height: var(--lh-snug);
    color: var(--text-soft);
    max-width: var(--measure-narrow);
    margin: 0 auto;
  }
</style>