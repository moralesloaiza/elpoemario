---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import AutorCard from '../../components/AutorCard.astro';
import ExplorarAutoresPor from '../../components/ExplorarAutoresPor.astro';
import { SITE_TITLE } from '../../consts';
import { getPagina } from '../../utils/paginas';

const autores = await getCollection('autores');
const poemas = await getCollection('poemas', ({ data }) => !data.borrador);

// Count published poems per author. `p.data.autor` is a reference()
// ({ collection, id }) in El Poemario — NOT a string like in El Fabulario.
// Index by `.id` (the file slug) to get a stable string key.
const conteoPorId = new Map<string, number>();
for (const p of poemas) {
  const k = p.data.autor.id;
  conteoPorId.set(k, (conteoPorId.get(k) ?? 0) + 1);
}

// Enrich + sort: poem count desc, alphabetical by name as tiebreak (es locale).
// Mirrors El Fabulario's /autores/ ordering. Classics and collaborators are
// not separated visually; the rubric in each AutorCard surfaces tipo inline.
// Director is pinned to the end of the listing, outside the poem-count
// ranking — a role marker, not a corpus comparable to the classics.
// Everyone else: poem count desc, then alphabetical (es locale).
const autoresConConteo = autores
  .map((a) => ({
    ...a,
    conteo: conteoPorId.get(a.id) ?? 0,
  }))
  .sort((a, b) => {
    const aDir = a.data.tipo === 'director' ? 1 : 0;
    const bDir = b.data.tipo === 'director' ? 1 : 0;
    if (aDir !== bDir) return aDir - bDir;
    if (b.conteo !== a.conteo) return b.conteo - a.conteo;
    return a.data.nombre.localeCompare(b.data.nombre, 'es');
  });

const pagina = await getPagina('autores');
---

<Base
  titulo={`${pagina.data.titulo} · ${SITE_TITLE}`}
  descripcion={pagina.data.descripcion}
>
  <article class="page indice" lang="es">
    <header class="title">
      <h1>{pagina.data.titulo}</h1>
      <p class="subtitulo">{pagina.data.subtitulo}</p>
    </header>

    <hr class="ornate" />
    <ExplorarAutoresPor />
    {autoresConConteo.length === 0 ? (
      <p class="vacio">Aún no hay autores en El Poemario.</p>
    ) : (
      <ul class="lista">
        {autoresConConteo.map((a) => (
          <li class="item">
            <AutorCard autor={a} conteo={a.conteo} />
          </li>
        ))}
      </ul>
    )}
  </article>
</Base>

<style>
  .indice {
  }
  .title {
    text-align: center;
    margin-bottom: var(--space-md);
  }
  .title h1 {
    margin: 0 0 var(--space-sm);
    font-size: var(--fs-3xl);
  }
  .subtitulo {
    font-family: var(--font-body);
    font-style: italic;
    font-size: var(--fs-md);
    color: var(--text-soft);
    max-width: var(--measure-narrow);
    margin: 0 auto;
  }

  .vacio {
    text-align: center;
    font-family: var(--font-body);
    font-style: italic;
    color: var(--text-soft);
    margin: var(--space-2xl) auto;
  }

  /* Bordered text-cell grid: 3 cols, single 680px breakpoint to 1 col,
     confined to the reading column. See PR-R1. */
  .lista {
    list-style: none;
    padding: 0;
    margin: var(--space-2xl) auto 0;
    max-width: var(--measure-grid);
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0;
    border-top: 1px solid var(--line);
    border-left: 1px solid var(--line);
  }
  @media (max-width: 680px) {
    .lista {
      grid-template-columns: 1fr;
    }
  }
  .item {
    margin: 0;
    display: grid;
  }
</style>