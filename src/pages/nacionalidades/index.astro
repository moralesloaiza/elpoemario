---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ChipsFacetas from '../../components/ChipsFacetas.astro';
import GrillaTerminos from '../../components/GrillaTerminos.astro';
import {
  NACIONALIDADES_DISPLAY,
  paisASlug,
  type Nacionalidad,
} from '../../utils/taxonomia';

import { SITE_TITLE } from '../../consts';
import { getPagina } from '../../utils/paginas';

const autores = await getCollection('autores');

// By-origin axis. An author with `lengua_original` is EXCLUDED from their
// country and counted under the final "otras lenguas" tile instead (rule of
// presentation, not of data — `nacionalidad` is preserved). Authors without
// any `nacionalidad` (e.g. anonimo) drop off this axis entirely; they still
// appear under /siglos/.
const conteoPais = new Map<Nacionalidad, number>();
let conteoOtrasLenguas = 0;

for (const a of autores) {
  if (a.data.lengua_original) {
    conteoOtrasLenguas += 1;
    continue;
  }
  const pais = a.data.nacionalidad;
  if (!pais) continue;
  conteoPais.set(pais, (conteoPais.get(pais) ?? 0) + 1);
}

// Country tiles: count desc, alphabetical (es) on the gentilicio as tiebreak.
const capitalizar = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);

const tiles = Array.from(conteoPais.entries())
  .map(([pais, n]) => ({
    href: `/nacionalidades/${paisASlug(pais)}/`,
    display: capitalizar(NACIONALIDADES_DISPLAY[pais]),
    conteo: n,
  }))
  .sort((a, b) => {
    if (b.conteo !== a.conteo) return b.conteo - a.conteo;
    return a.display.localeCompare(b.display, 'es');
  });

// "Otras lenguas" is always pinned last, regardless of count.
if (conteoOtrasLenguas > 0) {
  tiles.push({
    href: '/nacionalidades/otras-lenguas/',
    display: 'En otras lenguas',
    conteo: conteoOtrasLenguas,
  });
}

const pagina = await getPagina('nacionalidades');
---

<Base
  titulo={`${pagina.data.titulo} · ${SITE_TITLE}`}
  descripcion={pagina.data.descripcion}
>
  <div class="indice">
    <header class="title">
      {pagina.data.rotulo && <p class="rotulo">{pagina.data.rotulo}</p>}
      <h1>{pagina.data.titulo}</h1>
      <p class="subtitulo">{pagina.data.subtitulo}</p>
    </header>

    <ChipsFacetas activa="pais" />

    <GrillaTerminos items={tiles} unidad="poeta" />
  </div>
</Base>

<style>
  .title {
    text-align: center;
    margin-bottom: var(--space-md);
  }
  .title h1 {
    margin: 0;
    font-size: var(--fs-3xl);
  }
</style>