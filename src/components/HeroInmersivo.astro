---
// Shell compartido del hero inmersivo (handoff «inmersivo», pantallas 3A/4a/4c).
// Ilustración a sangre con la nav flotando encima (la aporta Base vía
// `heroInmersivo` + `slot="hero"`) y un degradado oscuro sobre el que se ancla,
// abajo, el bloque de título. Este componente NO incluye la nav: solo la imagen,
// el degradado y el contenedor posicionado del contenido, que llega por `<slot>`.
//
// El contenido (eyebrow, título, autor…) lo pinta la página con las utilidades
// tipográficas del hero definidas en tokens.css (.hero-eyebrow, .hero-titulo,
// .hero-byline, .hero-lede) más lo que necesite en local; su color sale de los
// tokens --hero-*, que siguen al tema (tinta clara sobre velo oscuro de noche,
// tinta oscura sobre velo de papel de día).
//
// Uso:
//   <HeroInmersivo slot="hero" imagen={img} align="left" maxAncho="54rem">
//     <p class="hero-eyebrow">…</p>
//     <h1 class="hero-titulo">…</h1>
//   </HeroInmersivo>
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  imagen: ImageMetadata;
  /* Texto alternativo. Por defecto vacío: la ilustración acompaña al título,
     que ya comunica el contenido (misma decisión que en el resto del sitio). */
  alt?: string;
  /* Punto focal vertical, en % desde arriba (0–100). El hero muestra una franja
     8:3 de una ilustración 3:2: sobreviven 576 de 1024 filas, y este valor
     reparte las 448 descartadas entre arriba y abajo. Viene del campo `foco` de
     la colección (editable en Decap por ilustración).

     Sin valor, 8. El handoff traía 30, pero las ilustraciones del catálogo están
     compuestas con la figura en la mitad alta del 3:2 y a 30 se les cortaban las
     cabezas (con 30 se recortan 134px por arriba; con 8, 36px). Los retratos de
     autor usan su propio default, FOCO_RETRATO en consts.ts. */
  foco?: number;
  /* Alineación del bloque de título: centrado (poema) o a la izquierda
     (entrada, inicio). */
  align?: 'center' | 'left';
  /* Ancho máximo del bloque de contenido (p. ej. '54rem'). Sin valor, ocupa el
     contenedor de página. Útil sobre todo con align="left". */
  maxAncho?: string;
}

const {
  imagen,
  alt = '',
  foco = 8,
  align = 'center',
  maxAncho,
} = Astro.props;

/* El eje horizontal queda siempre centrado: en escritorio el recorte es
   exclusivamente vertical (el contenedor es más ancho que la imagen en
   proporción), y en móvil las ilustraciones son composiciones centradas. */
const objectPosition = `center ${foco}%`;
---

<div class="hi-shell">
  <Image
    src={imagen}
    alt={alt}
    class="hi-img"
    style={`--hi-obj-pos:${objectPosition}`}
    widths={[768, 1280, 1920]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
    decoding="async"
  />
  <div class="hi-degradado" aria-hidden="true"></div>
  <div class="hi-contenido page">
    <div class="hi-bloque" data-align={align} style={maxAncho ? `max-width:${maxAncho}` : undefined}>
      <slot />
    </div>
  </div>
</div>

<style>
  /* Shell flexible: `min-height` (no `height` fija) + contenido en flujo anclado
     abajo con `align-items:flex-end`. Así, si el contenido es más alto que el
     mínimo (p. ej. el Inicio en móvil), el hero CRECE en vez de recortarlo con
     `overflow:hidden`. La imagen va detrás (absolute inset:0, cover).

     Altura ligada al ANCHO (37.5vw = franja 8:3), no a la altura de pantalla.
     Antes era `72vh`, y como el ancho es 100vw eso dejaba la PROPORCIÓN del
     recorte a merced del viewport: 2.50:1 en un portátil, 2.72:1 en 1080p,
     3.12:1 en un 1440p. Las ilustraciones son todas 3:2 (1.50:1), así que cada
     pantalla se comía una franja distinta y no había un encuadre que fuera
     correcto en todas — de ahí que `foco` no habría servido de nada sin esto.
     Con 37.5vw la franja es 8:3 (2.67:1) en cualquier escritorio entre ~1387px
     y 2560px de ancho, y el encuadre elegido se ve igual en todos.

     Los otros dos términos son topes, no el caso normal:
     · `78vh` protege al portátil ancho y bajo (1920×768: 720px sería el 94% del
       viewport y el cuerpo quedaría entero bajo el pliegue → se queda en 599px).
       Sólo actúa si el viewport es más apaisado que 2.08:1.
     · el suelo de 520px gobierna móvil y tablet, donde 37.5vw es minúsculo. De
       paso elimina el `vh` en móvil, que hacía saltar el hero al aparecer y
       desaparecer la barra del navegador con el scroll. */
  .hi-shell {
    position: relative;
    display: flex;
    align-items: flex-end;
    box-sizing: border-box;
    min-height: clamp(520px, min(37.5vw, 78vh), 960px);
    /* Reserva sitio a la nav flotante (va superpuesta arriba): si el contenido
       crece hasta la cima —pantalla baja, título largo—, se detiene bajo el
       masthead en vez de quedar debajo de él. Aplica a todos los tamaños. */
    padding-top: calc(var(--space-2xl) * 2);
    overflow: hidden;
  }
  /* El filtro va por tema (--hero-img-filtro): de noche baja el brillo, de día
     levanta los negros bajando el contraste. No es solo ambiente — es lo que
     sostiene el contraste AA del texto sin tener que tapar la ilustración con
     más velo (ver tokens.css). */
  .hi-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--hi-obj-pos, center 30%);
    filter: var(--hero-img-filtro);
  }
  .hi-degradado {
    position: absolute;
    inset: 0;
    background: var(--hero-gradiente);
  }
  /* Bloque de contenido sobre la imagen, dentro del contenedor de página
     (.page aporta max-width + margen auto + gutter lateral). */
  .hi-contenido {
    position: relative;
    z-index: 1;
    width: 100%;
    padding-bottom: var(--space-2xl);
  }
  .hi-bloque[data-align='center'] {
    margin-inline: auto;
    text-align: center;
  }
  .hi-bloque[data-align='left'] {
    margin-inline: 0;
    text-align: left;
  }
</style>
