---
// Renders a navigation link with .active class when the current route
// matches. Compares pathname against href; trailing slashes normalized.
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'>;

const { href, class: className, ...props } = Astro.props;

// Quita el prefijo base sólo cuando lo es de verdad. Con BASE_URL = '/', un
// `.replace(BASE_URL, '')` se comía la primera barra del pathname ('/poemas/'
// → 'poemas/') y ninguna comparación casaba nunca.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const rawPath = Astro.url.pathname;
const pathname = (base && rawPath.startsWith(base) ? rawPath.slice(base.length) : rawPath) || '/';

// Compara con barra final en ambos lados: '/poemas' ≡ '/poemas/'.
const conBarra = (ruta: string) => (ruta.endsWith('/') ? ruta : ruta + '/');
const rutaActual = conBarra(pathname);
// Primer segmento: marca la sección también en las páginas de detalle
// ('/poemas/nocturno/' resalta «Poemas»). En la portada queda '/'.
const seccionActual = conBarra('/' + (pathname.match(/[^\/]+/g)?.[0] ?? ''));
const rutaEnlace = conBarra(String(href ?? '/'));

const isActive = rutaEnlace === rutaActual || rutaEnlace === seccionActual;
---

<a href={href} class:list={[className, { active: isActive }]} {...props}>
  <slot />
</a>