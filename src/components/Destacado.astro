---
// Home featured block (singleton). Full-bleed image (no frame) above the
// cintillo, then the same two body modes as before:
//   - poema:   a curated verse extract (one <div> per line)
//   - entrada / autor: a prose paragraph (resumen / descripcion)
// Both render at the same large reading size; only block-of-lines vs
// paragraph differs. Image made mandatory in the PR that reverted PR-R2.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  cintillo: string;
  titulo: string;
  href: string;
  cta: string;
  imagen: ImageMetadata;
  byline?: string;
  versos?: string[];
  resumen?: string;
}

const { cintillo, titulo, href, cta, imagen, byline, versos, resumen } = Astro.props;
const tieneVersos = Array.isArray(versos) && versos.length > 0;
---

<section class="destacado-seccion" aria-label="Destacado de la curaduría">
  <figure class="destacado-imagen">
    <Image src={imagen} alt="" loading="eager" decoding="async" width={1200} height={800} />
  </figure>

  <p class="cintillo" aria-hidden="true">{cintillo}</p>

  <article class="destacado">
    <h2 class="destacado-titulo">
      <a href={href}>{titulo}</a>
    </h2>

    {byline && <p class="destacado-byline">{byline}</p>}

    {tieneVersos ? (
      <div class="destacado-versos">
        {versos!.map((verso) => <div>{verso}</div>)}
      </div>
    ) : (
      resumen && <p class="destacado-resumen">{resumen}</p>
    )}

    <a class="destacado-cta" href={href}>{cta}</a>
  </article>
</section>

<style>
  .destacado-seccion {
    margin-top: var(--space-lg);
    margin-bottom: var(--space-2xl);
    text-align: center;
  }

  /* Antetítulo «Poema del día» / «De la bitácora …»: versalita oro centrada. */
  .destacado-imagen {
    max-width: var(--measure-wide);
    margin: 0 auto var(--space-lg);
  }
  .destacado-imagen img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }

  .cintillo {
    font-family: var(--font-meta);
    font-size: var(--fs-2xs);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-widest);
    text-transform: uppercase;
    color: var(--oro-texto);
    margin: 0 0 var(--space-lg);
  }

  .destacado {
    /* Block-link positioning context for the title overlay. */
    position: relative;
    max-width: var(--measure-wide);
    margin-inline: auto;
  }

  .destacado-titulo {
    font-family: var(--font-display);
    font-size: var(--fs-2xl);
    font-weight: var(--fw-bold);
    letter-spacing: var(--ls-wide);
    line-height: var(--lh-snug);
    text-transform: uppercase;
    text-wrap: balance;
    max-width: min(var(--measure-narrow), 100%);
    margin: 0 auto;
    color: var(--text);
  }
  .destacado-titulo a {
    text-decoration: none;
    color: inherit;
    border-bottom: 0;
  }
  .destacado:has(.destacado-titulo a:hover) .destacado-titulo,
  .destacado:has(.destacado-titulo a:focus-visible) .destacado-titulo {
    color: var(--oro-texto);
  }

  .destacado-byline {
    font-family: var(--font-body);
    font-style: italic;
    font-weight: var(--fw-semibold);
    font-size: var(--fs-md);
    color: var(--oro-texto);
    margin: var(--space-sm) 0 0;
  }

  /* Verse extract: block, shrink-to-fit width, centered via margin auto,
     lines left-aligned. display:block (no inline-block) para que el CTA
     de abajo quede garantizado en su propia línea. */
  .destacado-versos {
    display: block;
    width: fit-content;
    text-align: left;
    max-width: min(var(--measure-narrow), 100%);
    margin: var(--space-xl) auto 0;
    font-family: var(--font-body);
    font-weight: var(--font-body-weight);
    font-size: var(--fs-poema);
    line-height: var(--lh-poema);
    color: var(--verse);
  }

  /* Prose extract (entrada / autor): same reading size, paragraph flow.
     Bloque centrado via margin auto; texto alineado a la izquierda
     (no hereda el text-align:center de .destacado-seccion). */
  .destacado-resumen {
    max-width: min(var(--measure-narrow), 100%);
    margin: var(--space-xl) auto 0;
    text-align: left;
    font-family: var(--font-body);
    font-weight: var(--font-body-weight);
    font-size: var(--fs-poema);
    line-height: var(--lh-poema);
    color: var(--verse);
  }

  /* CTA primario en tinta solida (handoff): fondo --btn-bg, texto --btn-ink.
     En dia = tinta azul-noche sobre crema; en noche = oro sobre oscuro.
     Hover invierte a contorno (borde siempre presente: sin salto geometrico). */
  .destacado-cta {
    display: inline-block;
    margin-top: var(--space-xl);
    font-family: var(--font-meta);
    font-size: var(--fs-2xs);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-wider);
    text-transform: uppercase;
    color: var(--btn-ink);
    background: var(--btn-bg);
    padding: 0.85em 1.75em;
    border: 1px solid var(--btn-bg);
    text-decoration: none;
    transition: background var(--dur-fast) var(--ease-standard),
      color var(--dur-fast) var(--ease-standard);
  }
  .destacado-cta:hover,
  .destacado-cta:focus-visible {
    background: transparent;
    color: var(--btn-bg);
    border-bottom: 1px solid var(--btn-bg);
  }

  @media (max-width: 720px) {
    .destacado-titulo {
      font-size: var(--fs-xl);
    }
  }
</style>
