---
// Home featured block (singleton). No image: a centered, single-column
// treatment. Two body modes:
//   - poema:   a curated verse extract (one <div> per line)
//   - entrada / autor: a prose paragraph (resumen / descripcion)
// Both render at the same large reading size; only block-of-lines vs
// paragraph differs. (PR-R2 of the redesign plan.)
interface Props {
  cintillo: string;
  titulo: string;
  href: string;
  cta: string;
  byline?: string;
  versos?: string[];
  resumen?: string;
}

const { cintillo, titulo, href, cta, byline, versos, resumen } = Astro.props;
const tieneVersos = Array.isArray(versos) && versos.length > 0;
---

<section class="destacado-seccion" aria-label="Destacado de la curaduría">
  <p class="cintillo" aria-hidden="true">{cintillo}</p>

  <article class="destacado">
    <h2 class="destacado-titulo">
      <a href={href}>{titulo}</a>
    </h2>

    {byline && <p class="destacado-byline">{byline}</p>}

    {tieneVersos ? (
      <div class="destacado-versos">
        {versos!.map((verso) => <div>{verso}</div>)}
      </div>
    ) : (
      resumen && <p class="destacado-resumen">{resumen}</p>
    )}

    <a class="destacado-cta" href={href}>{cta}<span class="galon galon--der" aria-hidden="true"></span></a>
  </article>
</section>

<style>
  .destacado-seccion {
    margin-top: var(--space-lg);
    margin-bottom: var(--space-2xl);
    text-align: center;
  }

  /* Antetítulo «Poema del día» / «De la bitácora …»: versalita oro centrada. */
  .cintillo {
    font-family: var(--font-meta);
    font-size: var(--fs-2xs);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-widest);
    text-transform: uppercase;
    color: var(--oro-texto);
    margin: 0 0 var(--space-lg);
  }

  .destacado {
    /* Block-link positioning context for the title overlay. */
    position: relative;
  }

  .destacado-titulo {
    font-family: var(--font-display);
    font-size: var(--fs-2xl);
    font-weight: var(--fw-bold);
    letter-spacing: var(--ls-wide);
    line-height: var(--lh-snug);
    text-transform: uppercase;
    text-wrap: balance;
    margin: 0;
    color: var(--text);
  }
  .destacado-titulo a {
    text-decoration: none;
    color: inherit;
    border-bottom: 0;
  }
  .destacado:has(.destacado-titulo a:hover) .destacado-titulo,
  .destacado:has(.destacado-titulo a:focus-visible) .destacado-titulo {
    color: var(--oro-texto);
  }

  .destacado-byline {
    font-family: var(--font-body);
    font-style: italic;
    font-weight: var(--fw-semibold);
    font-size: var(--fs-md);
    color: var(--oro-texto);
    margin: var(--space-sm) 0 0;
  }

  /* Verse extract: centered inline-block, lines left-aligned, verse type. */
  .destacado-versos {
    display: inline-block;
    text-align: left;
    max-width: min(var(--measure-narrow), 100%);
    margin: var(--space-xl) 0 0;
    font-family: var(--font-body);
    font-weight: var(--font-body-weight);
    font-size: var(--fs-poema);
    line-height: var(--lh-poema);
    color: var(--verse);
  }

  /* Prose extract (entrada / autor): same reading size, paragraph flow. */
  .destacado-resumen {
    max-width: min(var(--measure-narrow), 100%);
    margin: var(--space-xl) auto 0;
    font-family: var(--font-body);
    font-weight: var(--font-body-weight);
    font-size: var(--fs-poema);
    line-height: var(--lh-poema);
    color: var(--verse);
  }

  .destacado-cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    margin-top: var(--space-xl);
    font-family: var(--font-meta);
    font-size: var(--fs-2xs);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-wider);
    text-transform: uppercase;
    color: var(--oro-texto);
    text-decoration: none;
    border-bottom: none;
  }
  .destacado-cta .galon {
    transition: transform var(--dur-fast) var(--ease-standard);
  }
  .destacado-cta:hover,
  .destacado-cta:focus-visible {
    color: var(--oro);
    border-bottom: none;
  }
  .destacado-cta:hover .galon,
  .destacado-cta:focus-visible .galon {
    transform: translateX(3px);
  }

  @media (max-width: 720px) {
    .destacado-titulo {
      font-size: var(--fs-xl);
    }
  }
</style>
