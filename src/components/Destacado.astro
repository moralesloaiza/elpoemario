---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  cintillo: string;
  imagen: ImageMetadata;
  alt?: string;
  titulo: string;
  href: string;
  cta: string;
  resumen?: string;
}

const { cintillo, imagen, alt = '', titulo, href, cta, resumen } = Astro.props;
---

<section class="destacado-seccion" aria-label="Destacado de la curaduría">
  <p class="cintillo" aria-hidden="true">
    <span class="cintillo-texto">{cintillo}</span>
    <span class="cintillo-linea"></span>
  </p>

  <article class="destacado">
    <figure class="destacado-img">
      <Image src={imagen} alt={alt} width={1400} height={933} loading="eager" />
    </figure>

    <div class="destacado-meta">
      <h2 class="destacado-titulo">
        <a href={href}>{titulo}</a>
      </h2>

      {resumen && <p class="destacado-resumen">{resumen}</p>}

      <div class="destacado-submeta">
        <slot name="submeta" />
      </div>

      <a class="destacado-cta" href={href}>{cta}</a>
    </div>
  </article>
</section>

<style>
  .destacado-seccion {
    margin-block: var(--space-2xl);
    max-width: var(--measure-wide);
    margin-inline: auto;
  }

  /* Antetítulo «EN PORTADA» con filete que se extiende a la derecha */
  .cintillo {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    margin: 0 0 var(--space-lg);
  }
  .cintillo-texto {
    font-family: var(--font-meta);
    font-size: var(--fs-3xs);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-widest);
    text-transform: uppercase;
    color: var(--oro-texto);
    white-space: nowrap;
  }
  .cintillo-linea {
    flex: 1;
    height: 0;
    border-top: var(--rule-hairline) solid var(--oro);
  }

  /* Dos columnas: imagen | texto. Sin marco. */
  .destacado {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-2xl);
    align-items: start;
  }

  .destacado-img {
    margin: 0;
    aspect-ratio: 3 / 2;
    overflow: hidden;
  }
  .destacado-img :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--dur-fast) var(--ease-standard);
  }
  .destacado:has(.destacado-titulo a:hover) .destacado-img :global(img),
  .destacado:has(.destacado-titulo a:focus-visible) .destacado-img :global(img) {
    transform: scale(1.02);
  }

  .destacado-meta {
    text-align: left;
  }

  .destacado-titulo {
    font-family: var(--font-display);
    font-size: var(--fs-2xl);
    font-weight: var(--fw-bold);
    letter-spacing: var(--ls-wide);
    line-height: var(--lh-snug);
    text-wrap: balance;
    margin: 0 0 var(--space-md);
    color: var(--cian);
  }
  .destacado-titulo a {
    text-decoration: none;
    color: inherit;
    border-bottom: 0;
  }
  .destacado:has(.destacado-titulo a:hover) .destacado-titulo,
  .destacado:has(.destacado-titulo a:focus-visible) .destacado-titulo {
    color: var(--oro-texto);
  }

  .destacado-resumen {
    font-family: var(--font-body);
    font-style: italic;
    font-size: var(--fs-md);
    line-height: var(--lh-snug);
    color: var(--text);
    margin: 0 0 var(--space-md);
  }

  /* Crédito en versalita oro (Josefin), no en cursiva */
  .destacado-submeta {
    font-family: var(--font-meta);
    font-size: var(--fs-2xs);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-wide);
    text-transform: uppercase;
    color: var(--oro-texto);
    margin: 0 0 var(--space-lg);
  }
  .destacado-submeta :global(p) {
    margin: 0;
  }

  /* CTA con caja de filete oro */
  .destacado-cta {
    display: inline-block;
    font-family: var(--font-meta);
    font-size: var(--fs-2xs);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-wider);
    text-transform: uppercase;
    color: var(--oro-texto);
    text-decoration: none;
    border: 1px solid var(--oro);
    border-bottom: 1px solid var(--oro);
    padding: 0.85em 1.75em;
    transition: background var(--dur-fast) var(--ease-standard),
      color var(--dur-fast) var(--ease-standard);
  }
  .destacado-cta:hover,
  .destacado-cta:focus-visible {
    background: var(--oro);
    color: var(--bg);
  }

  @media (max-width: 720px) {
    .destacado {
      grid-template-columns: 1fr;
      gap: var(--space-lg);
    }
    .destacado-titulo {
      font-size: var(--fs-xl);
    }
  }
</style>
