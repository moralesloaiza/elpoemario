---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  cintillo: string;
  imagen: ImageMetadata;
  alt?: string;
  titulo: string;
  href: string;
}

const { cintillo, imagen, alt = '', titulo, href } = Astro.props;
---

<section class="destacado-seccion" aria-label="Destacado de la curaduría">
  <article class="destacado">
    <figure class="destacado-img">
      <Image src={imagen} alt={alt} width={1400} height={933} loading="eager" />
    </figure>
    <div class="destacado-meta">
      <p class="cintillo">{cintillo}</p>
      <h2 class="destacado-titulo">
        <a href={href}>{titulo}</a>
      </h2>
      <div class="destacado-submeta">
        <slot name="submeta" />
      </div>
    </div>
  </article>
</section>

<style>
  .destacado-seccion {
    margin-block: var(--space-2xl);
  }

  .destacado {
    position: relative;
    max-width: var(--measure);
    margin-inline: auto;
    text-align: center;
  }

  .destacado-img {
    width: 100%;
    margin: 0 0 var(--space-lg);
    aspect-ratio: 3 / 2;
    overflow: hidden;
  }
  .destacado-img :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--dur-fast) var(--ease-standard);
  }
  .destacado:has(.destacado-titulo a:hover) .destacado-img :global(img),
  .destacado:has(.destacado-titulo a:focus-visible) .destacado-img :global(img) {
    transform: scale(1.02);
  }

  .destacado-meta {
    text-align: center;
  }

  .cintillo {
    font-family: var(--font-display);
    font-size: var(--fs-3xs);
    font-weight: var(--fw-bold);
    letter-spacing: var(--ls-widest);
    text-transform: uppercase;
    color: var(--oro-texto);
    margin: 0 0 var(--space-sm);
  }

  .destacado-titulo {
    font-family: var(--font-display);
    font-size: var(--fs-2xl);
    font-weight: var(--fw-bold);
    letter-spacing: var(--ls-wider);
    line-height: var(--lh-snug);
    text-transform: uppercase;
    text-wrap: balance;
    margin: 0 0 var(--space-md);
    color: var(--text);
  }
  .destacado-titulo a {
    text-decoration: none;
    color: inherit;
    border-bottom: 0;
  }
  .destacado-titulo a::before {
    content: '';
    position: absolute;
    inset: 0;
  }
  .destacado:has(.destacado-titulo a:hover) .destacado-titulo,
  .destacado:has(.destacado-titulo a:focus-visible) .destacado-titulo {
    color: var(--oro-texto);
  }

  .destacado-submeta {
    font-family: var(--font-body);
    font-style: italic;
    font-size: var(--fs-md);
    color: var(--text-soft);
  }
  .destacado-submeta :global(p) {
    margin: 0;
  }

  @media (max-width: 720px) {
    .destacado-titulo {
      font-size: var(--fs-xl);
    }
  }
</style>