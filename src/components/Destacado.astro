---
// Home featured block (singleton). Editorial 2-column layout (handoff):
// text column (kicker, title, byline, extract, solid CTA) | framed image
// in a passe-partout (border --rule + padding over --mat), with hairline
// rules above and below the whole block. The body has two modes:
//   - poema:   a curated verse extract (one <div> per line)
//   - entrada / autor: a prose paragraph (resumen / descripcion)
// Image made mandatory in the PR that reverted PR-R2.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  cintillo: string;
  titulo: string;
  href: string;
  cta: string;
  imagen: ImageMetadata;
  byline?: string;
  versos?: string[];
  resumen?: string;
}

const { cintillo, titulo, href, cta, imagen, byline, versos, resumen } = Astro.props;
const tieneVersos = Array.isArray(versos) && versos.length > 0;
---

<section class="destacado-seccion" aria-label="Destacado de la curaduría">
  <div class="destacado-grid">
    <div class="destacado-texto">
      <p class="cintillo" aria-hidden="true">{cintillo}</p>

      <h2 class="destacado-titulo">
        <a href={href}>{titulo}</a>
      </h2>

      {byline && <p class="destacado-byline">{byline}</p>}

      {tieneVersos ? (
        <div class="destacado-versos">
          {versos!.map((verso) => <div>{verso}</div>)}
        </div>
      ) : (
        resumen && <p class="destacado-resumen">{resumen}</p>
      )}

      <a class="destacado-cta" href={href}>{cta}</a>
    </div>

    <figure class="destacado-imagen">
      <Image src={imagen} alt="" loading="eager" decoding="async" width={1200} height={800} />
    </figure>
  </div>
</section>

<style>
  .destacado-seccion {
    margin-block: var(--space-2xl);
  }

  /* Grid editorial: texto | imagen, con filetes arriba y abajo (handoff). */
  .destacado-grid {
    display: grid;
    grid-template-columns: 1fr 1.05fr;
    gap: var(--space-2xl);
    align-items: center;
    padding-block: var(--space-2xl);
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }

  .destacado-texto {
    text-align: left;
  }

  /* Kicker «Destacado de la bitácora»: versalita oro. */
  .cintillo {
    font-family: var(--font-meta);
    font-size: var(--fs-2xs);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-widest);
    text-transform: uppercase;
    color: var(--oro-texto);
    margin: 0 0 var(--space-md);
  }

  /* Titular en Cormorant caja mixta (handoff: los titulares van en Cormorant,
     no en Cinzel). */
  .destacado-titulo {
    font-family: var(--font-body);
    font-size: clamp(2rem, 1.5rem + 2vw, 3rem);
    font-weight: 500;
    letter-spacing: 0;
    line-height: 1.05;
    text-transform: none;
    text-wrap: balance;
    margin: 0 0 var(--space-xs);
    color: var(--text);
  }
  .destacado-titulo a {
    text-decoration: none;
    color: inherit;
    border-bottom: 0;
  }
  .destacado-titulo a:hover,
  .destacado-titulo a:focus-visible {
    color: var(--oro-texto);
    border-bottom: 0;
  }

  .destacado-byline {
    font-family: var(--font-body);
    font-style: italic;
    font-weight: var(--fw-semibold);
    font-size: var(--fs-md);
    color: var(--oro-texto);
    margin: 0 0 var(--space-md);
  }

  /* Extracto en verso (poema): bloque alineado a la izquierda. */
  .destacado-versos {
    font-family: var(--font-body);
    font-style: italic;
    font-weight: var(--font-body-weight);
    font-size: var(--fs-lg);
    line-height: var(--lh-snug);
    color: var(--text-muted);
    margin: 0 0 var(--space-lg);
  }

  /* Extracto en prosa (entrada / autor). */
  .destacado-resumen {
    font-family: var(--font-prose);
    font-size: var(--fs-md);
    line-height: var(--lh-relaxed);
    color: var(--text-soft);
    margin: 0 0 var(--space-lg);
  }

  /* CTA primario en tinta sólida (handoff): fondo --btn-bg, texto --btn-ink.
     Hover invierte a contorno; borde siempre presente (sin salto de caja). */
  .destacado-cta {
    display: inline-block;
    font-family: var(--font-meta);
    font-size: var(--fs-2xs);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-wider);
    text-transform: uppercase;
    color: var(--btn-ink);
    background: var(--btn-bg);
    padding: 0.85em 1.75em;
    border: 1px solid var(--btn-bg);
    text-decoration: none;
    transition: background var(--dur-fast) var(--ease-standard),
      color var(--dur-fast) var(--ease-standard);
  }
  .destacado-cta:hover,
  .destacado-cta:focus-visible {
    background: transparent;
    color: var(--btn-bg);
    border-bottom: 1px solid var(--btn-bg);
  }

  /* Imagen en passe-partout (handoff): borde --rule + padding sobre --mat. */
  .destacado-imagen {
    margin: 0;
    border: 1px solid var(--rule);
    padding: var(--space-xs);
    background: var(--mat);
  }
  .destacado-imagen img {
    display: block;
    width: 100%;
    height: 400px;
    object-fit: cover;
    object-position: center 28%;
  }

  @media (max-width: 720px) {
    .destacado-grid {
      grid-template-columns: 1fr;
      gap: var(--space-lg);
    }
    /* Imagen primero en móvil (gancho visual), luego el texto. */
    .destacado-imagen {
      order: -1;
    }
    .destacado-imagen img {
      height: 220px;
    }
  }
</style>
