---
/* ============================================================
   El Poemario · Ornamento: Luna Art-Déco
   Hermana nocturna del Sol de El Fabulario. Hereda color via
   currentColor. Override del tamaño con la prop `width`.
   ============================================================ */

interface Props {
  width?: string;
}

const { width = '100px' } = Astro.props;
---

<svg
  class="luna"
  viewBox="0 0 100 50"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
  style={`width: ${width};`}
>
  <!-- Horizonte -->
  <line x1="20" y1="48" x2="80" y2="48" stroke="currentColor" stroke-width="1.2" />

  <!-- Luna creciente al centro -->
  <path
    d="M 50 8 A 15 15 0 1 1 50 38 A 11 11 0 1 0 50 8 Z"
    fill="currentColor"
  />

  <!-- Estrellas dispersas -->
  <circle cx="22" cy="14" r="0.9" fill="currentColor" />
  <circle cx="78" cy="18" r="1.1" fill="currentColor" />
  <circle cx="30" cy="32" r="0.7" fill="currentColor" />
  <circle cx="72" cy="36" r="0.9" fill="currentColor" />
</svg>

<style>
  .luna {
    display: block;
    height: auto;
    margin: 0 auto var(--space-md);
    color: var(--oro);
  }
</style>