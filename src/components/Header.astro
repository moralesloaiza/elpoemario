---
import { SITE_TITLE } from '../consts';
import Buscador from './Buscador.astro';
import HeaderLink from './HeaderLink.astro';
import Logo from './Logo.astro';

interface Props {
  /* 'solido' (por defecto): masthead con fondo y regla, sobre <main>.
     'overlay': flotante y transparente sobre un hero inmersivo, con colores
     fijos claros (tokens --hero-*) legibles en día y noche. */
  variante?: 'solido' | 'overlay';
}

const { variante = 'solido' } = Astro.props;
---

<header class:list={{ overlay: variante === 'overlay' }}>
  <div class="page header-inner">
    <a href="/" class="brand" aria-label={`${SITE_TITLE} · inicio`}>
      <Logo tamano={40} />
      <span class="wordmark">{SITE_TITLE}</span>
    </a>

    <button
      type="button"
      class="nav-toggle"
      aria-expanded="false"
      aria-controls="nav-principal"
      aria-label="Abrir menú"
    >
      <span class="nav-toggle-barra" aria-hidden="true"></span>
      <span class="nav-toggle-barra" aria-hidden="true"></span>
      <span class="nav-toggle-barra" aria-hidden="true"></span>
    </button>

    <nav id="nav-principal" class="internal-links" aria-label="Navegación principal">
      <HeaderLink href="/">Inicio</HeaderLink>
      <HeaderLink href="/poemas/">Poemas</HeaderLink>
      <HeaderLink href="/autores/">Autores</HeaderLink>
      <HeaderLink href="/entradas/">Bitácora</HeaderLink>
      <HeaderLink href="/correspondencia/">Contacto</HeaderLink>
      <HeaderLink href="/sobre/">Acerca de</HeaderLink>
      <Buscador />
      <button
        type="button"
        class="tema-toggle"
        aria-pressed="false"
        aria-label="Cambiar entre modo noche y día"
      >
        <span class="tema-toggle-icono" aria-hidden="true">☀</span>
        <span class="tema-toggle-texto">Día</span>
      </button>
    </nav>
  </div>
</header>

<script is:inline>
  // Conmutador día/noche site-wide. El anti-flash de Base.astro ya fijó
  // data-theme antes del pintado; este script sincroniza la etiqueta del
  // botón (que anuncia el tema DESTINO) y persiste la elección.
  (function () {
    var btn = document.querySelector('.tema-toggle');
    if (!btn) return;
    var root = document.documentElement;
    var icono = btn.querySelector('.tema-toggle-icono');
    var texto = btn.querySelector('.tema-toggle-texto');
    function sync() {
      var esDia = root.getAttribute('data-theme') === 'day';
      btn.setAttribute('aria-pressed', esDia ? 'true' : 'false');
      if (icono) icono.textContent = esDia ? '☾' : '☀';
      if (texto) texto.textContent = esDia ? 'Noche' : 'Día';
    }
    sync();
    btn.addEventListener('click', function () {
      var esDia = root.getAttribute('data-theme') === 'day';
      if (esDia) {
        root.removeAttribute('data-theme');
        try { localStorage.setItem('poemario-theme', 'night'); } catch (e) {}
      } else {
        root.setAttribute('data-theme', 'day');
        try { localStorage.setItem('poemario-theme', 'day'); } catch (e) {}
      }
      sync();
    });
  })();

  // Menú hamburguesa (solo móvil). Despliega el nav completo bajo el masthead.
  (function () {
    var header = document.querySelector('header');
    var toggle = document.querySelector('.nav-toggle');
    var nav = document.getElementById('nav-principal');
    if (!header || !toggle || !nav) return;
    function setOpen(open) {
      header.classList.toggle('nav-abierto', open);
      toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
      toggle.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
    }
    toggle.addEventListener('click', function () {
      setOpen(!header.classList.contains('nav-abierto'));
    });
    // Al pulsar un enlace del menú, ciérralo (la navegación recarga la página,
    // pero esto cubre anclas y transiciones suaves).
    nav.addEventListener('click', function (e) {
      if (e.target.closest('a')) setOpen(false);
    });
    // Escape cierra el menú.
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && header.classList.contains('nav-abierto')) {
        setOpen(false);
        toggle.focus();
      }
    });
  })();
</script>

<style>
  /* Masthead editorial (handoff): fila horizontal, marca a la izquierda, nav a
     la derecha, separada por una regla fuerte 2px en tinta (--text). */
  header {
    background: var(--bg);
    border-bottom: 2px solid var(--text);
    position: relative;
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-lg);
    padding-block: var(--space-md);
  }

  /* Marca: logo-rombo + wordmark «El Poemario» (Cormorant). */
  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    text-decoration: none;
    color: var(--text);
    border-bottom: none;
    line-height: 0;
  }
  .brand:hover,
  .brand:focus-visible {
    border-bottom: none;
  }
  .brand :global(.logo-mark) {
    display: block;
    width: 40px;
    height: 40px;
    flex-shrink: 0;
    transition: transform var(--dur-fast) var(--ease-standard);
  }
  .brand:hover :global(.logo-mark),
  .brand:focus-visible :global(.logo-mark) {
    transform: scale(1.04);
  }
  .wordmark {
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 1.75rem;
    letter-spacing: var(--ls-wide);
    line-height: 1;
    color: var(--text);
    white-space: nowrap;
  }

  /* Nav fluida: el espaciado entre ítems crece con el ancho de pantalla para
     absorber la holgura del masthead. Con `gap` fijo, `space-between` amontonaba
     toda la holgura en un solo hueco entre el wordmark y el primer enlace (199px
     a 1920), muy visible cuando la nav flota sobre la ilustración del hero.
     El mínimo es el valor de siempre, así que por debajo de ~1200px no cambia
     nada y el punto de la hamburguesa (1040px) sigue siendo válido. */
  .internal-links {
    display: flex;
    gap: clamp(var(--space-lg), 2vw, 3rem);
    align-items: center;
  }
  /* Nav en versalita Cinzel; estados en oro. */
  .internal-links :global(a) {
    font-family: var(--font-meta);
    font-size: var(--fs-xs);
    font-weight: 500;
    letter-spacing: var(--ls-wider);
    text-transform: uppercase;
    color: var(--text);
    text-decoration: none;
    padding-block: var(--space-2xs);
    border-bottom: 2px solid transparent;
    transition: color var(--dur-fast) var(--ease-standard),
                border-color var(--dur-fast) var(--ease-standard);
  }
  .internal-links :global(a:hover),
  .internal-links :global(a:focus-visible) {
    color: var(--oro-texto);
  }
  .internal-links :global(a.active) {
    font-weight: var(--fw-semibold);
    color: var(--oro-texto);
    border-bottom-color: var(--oro-texto);
    text-decoration: none;
  }

  /* Conmutador día/noche · borde oro, versalita Cinzel como el nav. */
  .tema-toggle {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    background: transparent;
    border: var(--rule-hairline) solid var(--oro-suave);
    color: var(--oro-texto);
    font-family: var(--font-meta);
    font-size: var(--fs-xs);
    font-weight: 500;
    letter-spacing: var(--ls-wider);
    text-transform: uppercase;
    padding: var(--space-2xs) var(--space-sm);
    cursor: pointer;
    white-space: nowrap;
    transition:
      border-color var(--dur-fast) var(--ease-standard),
      color var(--dur-fast) var(--ease-standard);
  }
  .tema-toggle:hover,
  .tema-toggle:focus-visible {
    border-color: var(--oro);
    color: var(--oro);
  }
  .tema-toggle-icono {
    font-size: 1em;
    line-height: 1;
  }

  /* Botón hamburguesa · oculto en escritorio, visible en móvil. */
  .nav-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 40px;
    height: 40px;
    padding: 0;
    background: transparent;
    border: 0;
    cursor: pointer;
  }
  .nav-toggle-barra {
    display: block;
    width: 24px;
    height: 2px;
    margin-inline: auto;
    background: var(--text);
    transition: transform var(--dur-fast) var(--ease-standard),
                opacity var(--dur-fast) var(--ease-standard);
  }

  /* ---------- Móvil/tablet: nav tras la hamburguesa ----------
     Breakpoint a 1040px: la fila completa (wordmark + 6 enlaces + lupa +
     conmutador) necesita ~1014px para caber; por debajo desbordaba (franja
     muerta 861–1040px). A partir de aquí colapsa a hamburguesa. */
  @media (max-width: 1040px) {
    .nav-toggle {
      display: flex;
    }
    .internal-links {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-lg);
      background: var(--bg);
      border-bottom: 2px solid var(--text);
      padding: var(--space-lg) var(--space-container);
      z-index: 50;
    }
    header.nav-abierto .internal-links {
      display: flex;
    }
    /* Hamburguesa → aspa cuando el menú está abierto. */
    header.nav-abierto .nav-toggle-barra:nth-child(1) {
      transform: translateY(7px) rotate(45deg);
    }
    header.nav-abierto .nav-toggle-barra:nth-child(2) {
      opacity: 0;
    }
    header.nav-abierto .nav-toggle-barra:nth-child(3) {
      transform: translateY(-7px) rotate(-45deg);
    }
  }

  @media (max-width: 540px) {
    .brand :global(.logo-mark) {
      width: 32px;
      height: 32px;
    }
    .wordmark {
      font-size: 1.375rem;
    }
  }

  /* ═══ Variante overlay ════════════════════════════════════════════════
     Masthead flotante sobre el hero inmersivo: transparente, sin regla, con
     colores fijos claros (tokens --hero-*) que se leen igual en día y noche
     sobre el degradado oscuro. El JS (toggle, hamburguesa) es idéntico; solo
     cambia el tratamiento de color. */
  header.overlay {
    position: absolute;
    inset-inline: 0;
    top: 0;
    z-index: 3;
    background: transparent;
    border-bottom: 0;
  }
  /* Marca: wordmark en marfil; el rombo redefine --bg/--text locales para
     leerse como plaqueta marfil sobre oscuro con independencia del tema. */
  header.overlay .brand,
  header.overlay .wordmark {
    color: var(--hero-title);
  }
  header.overlay .brand :global(.logo-mark) {
    --bg: #10131a;
    --text: var(--hero-title);
  }
  /* Nav: enlaces en tinta clara; estados e ítem activo en oro vivo fijo. */
  header.overlay .internal-links :global(a) {
    color: var(--hero-ink);
  }
  header.overlay .internal-links :global(a:hover),
  header.overlay .internal-links :global(a:focus-visible) {
    color: var(--hero-accent);
  }
  header.overlay .internal-links :global(a.active) {
    color: var(--hero-accent);
    border-bottom-color: var(--hero-rule);
  }
  /* Conmutador día/noche. */
  header.overlay .tema-toggle {
    border-color: var(--hero-rule);
    color: var(--hero-accent);
  }
  header.overlay .tema-toggle:hover,
  header.overlay .tema-toggle:focus-visible {
    border-color: var(--hero-accent);
    color: var(--hero-title);
  }
  /* Lupa del buscador y barras de la hamburguesa en tinta clara. */
  header.overlay :global(.buscador-trigger) {
    color: var(--hero-ink);
  }
  header.overlay :global(.buscador-trigger:hover),
  header.overlay :global(.buscador-trigger:focus-visible) {
    color: var(--hero-accent);
  }
  header.overlay .nav-toggle-barra {
    background: var(--hero-ink);
  }
  /* Menú móvil desplegado: el panel absoluto necesita superficie propia (no
     puede ser transparente sobre la imagen). Fondo oscuro fijo + regla oro;
     los enlaces ya van en tinta clara. Mayor especificidad que la regla del
     media query base, así que basta con redefinir fondo y borde. */
  @media (max-width: 1040px) {
    header.overlay .internal-links {
      background: var(--hero-surface);
      border-bottom-color: var(--hero-rule);
    }
  }
</style>
