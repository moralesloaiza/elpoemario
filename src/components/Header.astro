---
import { SITE_TITLE } from '../consts';
import Buscador from './Buscador.astro';
import HeaderLink from './HeaderLink.astro';
import Logo from './Logo.astro';
---

<header>
  <div class="page header-inner">
    <a href="/" class="logo" aria-label={`${SITE_TITLE} · inicio`}>
      <Logo />
    </a>
    <nav class="internal-links" aria-label="Navegación principal">
      <HeaderLink href="/">Inicio</HeaderLink>
      <HeaderLink href="/poemas/">Poemas</HeaderLink>
      <HeaderLink href="/autores/">Autores</HeaderLink>
      <HeaderLink href="/entradas/">Bitácora</HeaderLink>
      <HeaderLink href="/correspondencia/">Contacto</HeaderLink>
      <HeaderLink href="/sobre/">Acerca de</HeaderLink>
      <Buscador />
      <button
        type="button"
        class="tema-toggle"
        aria-pressed="false"
        aria-label="Cambiar entre modo noche y día"
      >
        <span class="tema-toggle-icono" aria-hidden="true">☀</span>
        <span class="tema-toggle-texto">Día</span>
      </button>
    </nav>
  </div>
</header>

<script is:inline>
  // Conmutador día/noche site-wide. El anti-flash de Base.astro ya fijó
  // data-theme antes del pintado; este script sincroniza la etiqueta del
  // botón (que anuncia el tema DESTINO) y persiste la elección.
  (function () {
    var btn = document.querySelector('.tema-toggle');
    if (!btn) return;
    var root = document.documentElement;
    var icono = btn.querySelector('.tema-toggle-icono');
    var texto = btn.querySelector('.tema-toggle-texto');
    function sync() {
      var esDia = root.getAttribute('data-theme') === 'day';
      btn.setAttribute('aria-pressed', esDia ? 'true' : 'false');
      if (icono) icono.textContent = esDia ? '☾' : '☀';
      if (texto) texto.textContent = esDia ? 'Noche' : 'Día';
    }
    sync();
    btn.addEventListener('click', function () {
      var esDia = root.getAttribute('data-theme') === 'day';
      if (esDia) {
        root.removeAttribute('data-theme');
        try { localStorage.setItem('poemario-theme', 'night'); } catch (e) {}
      } else {
        root.setAttribute('data-theme', 'day');
        try { localStorage.setItem('poemario-theme', 'day'); } catch (e) {}
      }
      sync();
    });
  })();
</script>

<style>
  header {
    background: var(--bg);
    border-bottom: var(--rule-hairline) solid var(--oro);
    position: relative;
  }
  .header-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-md);
    padding-block: var(--space-lg);
    text-align: center;
  }
  .logo {
    text-decoration: none;
    color: var(--text);
    display: inline-block;
    line-height: 0;
    border-bottom: none;
  }
  .logo:hover,
  .logo:focus-visible {
    border-bottom: none;
  }
  .logo :global(.logo-mark) {
    display: block;
    width: 76px;
    height: 76px;
    transition: transform var(--dur-fast) var(--ease-standard);
  }
  .logo:hover :global(.logo-mark),
  .logo:focus-visible :global(.logo-mark) {
    transform: scale(1.04);
  }
  .internal-links {
    display: flex;
    gap: var(--space-lg);
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
  }
  /* Nav en versalita Cinzel; estados en oro. */
  .internal-links :global(a) {
    font-family: var(--font-meta);
    font-size: var(--fs-xs);
    font-weight: 500;
    letter-spacing: var(--ls-wider);
    text-transform: uppercase;
    color: var(--text);
    text-decoration: none;
    padding-block: var(--space-2xs);
    border-bottom: 2px solid transparent;
    transition: color var(--dur-fast) var(--ease-standard),
                border-color var(--dur-fast) var(--ease-standard);
  }
  .internal-links :global(a:hover),
  .internal-links :global(a:focus-visible) {
    color: var(--oro-texto);
  }
  .internal-links :global(a.active) {
    font-weight: var(--fw-semibold);
    color: var(--oro-texto);
    border-bottom-color: var(--oro);
    text-decoration: none;
  }
  /* Conmutador día/noche · borde oro, versalita Cinzel como el nav. */
  .tema-toggle {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    background: transparent;
    border: var(--rule-hairline) solid var(--oro-suave);
    color: var(--oro-texto);
    font-family: var(--font-meta);
    font-size: var(--fs-xs);
    font-weight: 500;
    letter-spacing: var(--ls-wider);
    text-transform: uppercase;
    padding: var(--space-2xs) var(--space-sm);
    cursor: pointer;
    transition:
      border-color var(--dur-fast) var(--ease-standard),
      color var(--dur-fast) var(--ease-standard);
  }
  .tema-toggle:hover,
  .tema-toggle:focus-visible {
    border-color: var(--oro);
    color: var(--oro);
  }
  .tema-toggle-icono {
    font-size: 1em;
    line-height: 1;
  }

  @media (max-width: 540px) {
    .logo :global(.logo-mark) {
      width: 64px;
      height: 64px;
    }
    .internal-links {
      gap: var(--space-md);
    }
  }
</style>