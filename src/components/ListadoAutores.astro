---
import type { CollectionEntry } from 'astro:content';
import AutorCard from './AutorCard.astro';
import ExplorarAutoresPor from './ExplorarAutoresPor.astro';

// Flat author grid for a single grouping leaf (one country, one century).
// Mirrors ListadoPoemasTaxonomia: a visible breadcrumb, rotulo + display
// header, ornate rule, a cross-axis "explorar por" link, the count heading,
// then the card grid. Reuses AutorCard verbatim — no per-axis variant. The
// /nacionalidades/otras-lenguas/ page renders its own sectioned layout and
// does not use this component.
//
// Grid spans the full page width (.page) like /autores/. An earlier version
// clamped the container to --measure (672px), which crammed the 3-column grid
// and shrank the cards; the clamp is reading-measure for prose, wrong for a
// card grid.
interface Props {
  rotulo: string;
  display: string;
  autores: CollectionEntry<'autores'>[];
  conteoPorId: Map<string, number>;
  contadorTexto: string;
  vacioTexto: string;
  // Breadcrumb + cross-axis link. ejeTitulo/ejeHref name the parent index;
  // `actual` tells ExplorarAutoresPor which self-link to omit.
  ejeTitulo: string;
  ejeHref: string;
  actual: 'siglos' | 'nacionalidades';
}

const {
  rotulo,
  display,
  autores,
  conteoPorId,
  contadorTexto,
  vacioTexto,
  ejeTitulo,
  ejeHref,
  actual,
} = Astro.props;
---

<article class="page indice" lang="es">
  <nav class="migas" aria-label="Ruta de navegación">
    <a href="/">Inicio</a>
    <span class="sep-diamante" aria-hidden="true"></span>
    <a href={ejeHref}>{ejeTitulo}</a>
    <span class="sep-diamante" aria-hidden="true"></span>
    <span class="actual" aria-current="page">{display}</span>
  </nav>

  <header class="title">
    <p class="rotulo">{rotulo}</p>
    <h1>{display}</h1>
  </header>

  <div class="divisor" aria-hidden="true"><span></span><span></span><span></span></div>

  <ExplorarAutoresPor actual={actual} />

  <section class="autores-de-grupo" aria-labelledby="lista-titulo">
    <h2 id="lista-titulo">{contadorTexto}</h2>

    {autores.length === 0 ? (
      <p class="vacio">{vacioTexto}</p>
    ) : (
      <ul class="lista">
        {autores.map((a) => (
          <li class="item">
            <AutorCard autor={a} conteo={conteoPorId.get(a.id) ?? 0} />
          </li>
        ))}
      </ul>
    )}
  </section>
</article>

<style>
  .indice {
    padding-block: var(--space-2xl);
  }

  /* ---------- Migas ---------- */
  .migas {
    display: flex;
    justify-content: center;
    align-items: baseline;
    flex-wrap: wrap;
    gap: var(--space-xs);
    font-family: var(--font-display);
    font-size: var(--fs-3xs);
    letter-spacing: var(--ls-wide);
    margin-bottom: var(--space-lg);
  }
  .migas a {
    color: var(--text-soft);
    text-decoration: none;
    border-bottom: 1px solid transparent;
  }
  .migas a:hover,
  .migas a:focus-visible {
    color: var(--oro-texto);
    border-bottom-color: currentColor;
  }
  .migas .sep-diamante {
    align-self: center;
    width: 5px;
    height: 5px;
    transform: rotate(45deg);
    background: color-mix(in srgb, var(--oro) 60%, transparent);
  }
  .migas .actual {
    color: var(--text-muted);
  }

  .title {
    text-align: center;
    margin-bottom: var(--space-lg);
  }
  .rotulo {
    font-family: var(--font-display);
    font-size: var(--fs-3xs);
    letter-spacing: var(--ls-widest);
    color: var(--oro-texto);
    text-transform: uppercase;
    margin: var(--space-sm) 0 var(--space-2xs);
  }
  .title h1 {
    margin: 0;
    font-size: var(--fs-3xl);
    text-wrap: balance;
  }
  .autores-de-grupo h2 {
    text-align: center;
    font-family: var(--font-display);
    font-size: var(--fs-md);
    letter-spacing: var(--ls-wide);
    color: var(--oro-texto);
    margin: var(--space-xl) 0 var(--space-lg);
  }
  .vacio {
    text-align: center;
    font-family: var(--font-body);
    font-style: italic;
    color: var(--text-soft);
    margin: var(--space-2xl) auto;
  }
  /* Author rows in a 2-column grid (handoff), gap 0 — each row carries its
     own bottom rule. Confined to the reading measure; collapses to 1 col on
     narrow viewports. */
  .lista {
    list-style: none;
    padding: 0;
    margin: var(--space-2xl) auto 0;
    max-width: var(--measure-grid);
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: var(--space-2xl);
    row-gap: 0;
  }
  @media (max-width: 640px) {
    .lista {
      grid-template-columns: 1fr;
    }
  }
  .item {
    margin: 0;
    display: grid;
  }
</style>