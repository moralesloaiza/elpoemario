---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import FormattedDate from './FormattedDate.astro';

// Shared "one entry in a list" row (handoff §6 editorial treatment). Renders an
// <li> that is a positioning context for the block-link overlay: the <a> wraps
// only the title, and its ::before extends the clickable area over the whole
// row. Serves both the bitácora index (/entradas/) and the cartas view
// (/entradas/cartas/):
//   passe-partout image (or title-initial fallback) | meta · título · remitente? · resumen · leer
interface Props {
  entrada: CollectionEntry<'entradas'>;
}

const { entrada } = Astro.props;
const kind = entrada.data.tipo === 'correspondencia' ? 'Carta' : 'Bitácora';
---

<li class="fila">
  <div class="fila-imagen" aria-hidden="true">
    {entrada.data.ilustracion ? (
      <Image
        src={entrada.data.ilustracion}
        alt=""
        width={480}
        loading="lazy"
        decoding="async"
      />
    ) : (
      <span class="fila-inicial">
        {entrada.data.titulo.trim().charAt(0).toUpperCase()}
      </span>
    )}
  </div>
  <div class="fila-texto">
    <p class="fila-meta">
      <FormattedDate date={entrada.data.fecha} />
      <span class="fila-meta-sep"> · </span>
      {kind}
    </p>
    <h3 class="fila-titulo">
      <a href={`/entradas/${entrada.id}/`}>{entrada.data.titulo}</a>
    </h3>
    {entrada.data.remitente && (
      <p class="fila-remitente">de {entrada.data.remitente}</p>
    )}
    {entrada.data.resumen && (
      <p class="fila-resumen">{entrada.data.resumen}</p>
    )}
    <span class="fila-leer">Leer la entrada →</span>
  </div>
</li>

<style>
  /* Entry row (handoff §6): framed image | text, whole row clickable via the
     title link's ::before overlay. Bottom hairline separates rows. */
  .fila {
    position: relative;
    display: grid;
    grid-template-columns: 0.9fr 2fr;
    gap: var(--space-xl);
    align-items: center;
    padding: var(--space-xl) 0;
    border-bottom: 1px solid var(--rule-soft);
    transition: background-color var(--dur-fast) var(--ease-standard);
  }
  .fila:has(.fila-titulo a:hover),
  .fila:has(.fila-titulo a:focus-visible) {
    background-color: var(--hover-tint);
  }

  /* Passe-partout frame: --mat backing + --rule hairline, no radius. */
  .fila-imagen {
    border: 1px solid var(--rule);
    background: var(--mat);
    padding: 7px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  .fila-imagen img {
    display: block;
    width: 100%;
    height: 180px;
    object-fit: cover;
    object-position: center 28%;
  }
  .fila-inicial {
    font-family: var(--font-body);
    font-size: var(--fs-3xl);
    font-weight: 500;
    color: var(--oro-texto);
    line-height: 1;
    padding-block: calc((180px - 1em) / 2);
  }

  .fila-texto {
    min-width: 0;
  }
  .fila-meta {
    font-family: var(--font-display);
    font-size: var(--fs-3xs);
    letter-spacing: var(--ls-wider);
    text-transform: uppercase;
    color: var(--oro-texto);
    margin: 0 0 var(--space-2xs);
  }
  .fila-meta-sep {
    color: var(--oro-suave);
  }
  .fila-titulo {
    font-family: var(--font-body);
    font-size: var(--fs-2xl);
    font-weight: 500;
    line-height: var(--lh-snug);
    color: var(--text);
    text-transform: none;
    letter-spacing: 0;
    margin: 0 0 var(--space-2xs);
    text-wrap: balance;
  }
  .fila-titulo a {
    text-decoration: none;
    color: inherit;
    border-bottom: none;
  }
  .fila-titulo a::before {
    content: "";
    position: absolute;
    inset: 0;
  }
  .fila:has(.fila-titulo a:hover) .fila-titulo,
  .fila:has(.fila-titulo a:focus-visible) .fila-titulo {
    color: var(--oro-texto);
  }
  .fila-remitente {
    font-family: var(--font-body);
    font-style: italic;
    font-size: var(--fs-sm);
    color: var(--text-soft);
    margin: 0 0 var(--space-2xs);
  }
  .fila-resumen {
    font-family: var(--font-prose);
    font-size: var(--fs-md);
    line-height: 1.62;
    color: var(--text-soft);
    margin: 0 0 var(--space-sm);
  }
  .fila-leer {
    font-family: var(--font-display);
    font-size: var(--fs-3xs);
    letter-spacing: var(--ls-wide);
    text-transform: uppercase;
    color: var(--oro-texto);
  }

  /* Móvil (handoff): imagen apilada sobre el texto, una columna. */
  @media (max-width: 640px) {
    .fila {
      grid-template-columns: 1fr;
      gap: var(--space-md);
    }
    .fila-imagen img {
      height: 200px;
    }
  }
</style>
