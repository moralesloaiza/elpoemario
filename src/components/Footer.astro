---
const today = new Date();
const startYear = 2026;
const yearLabel =
  today.getFullYear() === startYear
    ? `${startYear}`
    : `${startYear}-${today.getFullYear()}`;

const grupos = [
  {
    rotulo: 'Explorar',
    enlaces: [
      { href: '/poemas/', texto: 'Poemas' },
      { href: '/autores/', texto: 'Autores' },
      { href: '/entradas/', texto: 'Bitácora' },
    ],
  },
  {
    rotulo: 'Por forma y tema',
    enlaces: [
      { href: '/tipos/', texto: 'Formas' },
      { href: '/temas/', texto: 'Temas' },
    ],
  },
  {
    rotulo: 'Por autor',
    enlaces: [
      { href: '/siglos/', texto: 'Siglos' },
      { href: '/nacionalidades/', texto: 'Nacionalidades' },
    ],
  },
  {
    rotulo: 'El Poemario',
    enlaces: [
      { href: '/sobre/', texto: 'Acerca de' },
      { href: '/colaborar/', texto: 'Colaborar' },
      { href: '/buscar/', texto: 'Buscar' },
    ],
  },
];
---

<footer>
  <div class="page footer-inner">
    <nav class="footer-nav" aria-label="Mapa del sitio">
      {grupos.map((grupo, i) => (
        <div class="footer-grupo">
          <p class="footer-rotulo" id={`footer-grupo-${i}`}>{grupo.rotulo}</p>
          <ul class="footer-lista" aria-labelledby={`footer-grupo-${i}`}>
            {grupo.enlaces.map((enlace) => (
              <li><a href={enlace.href}>{enlace.texto}</a></li>
            ))}
          </ul>
        </div>
      ))}
    </nav>

    <div class="divisor" aria-hidden="true"><span></span><span></span><span></span></div>

    <p class="cita" lang="la">
      Omne tulit punctum qui miscuit utile dulci
    </p>
    <p class="cita-fuente">
      Horacio · Ars Poetica, 343
    </p>

    <p class="meta">
      © {yearLabel} El Poemario
    </p>
  </div>
</footer>

<style>
  footer {
    margin-top: var(--space-2xl);
    padding-block: var(--space-2xl);
    background: var(--bg-soft);
    border-top: var(--rule-hairline) solid var(--oro);
    position: relative;
  }
  .footer-inner {
    text-align: center;
  }

  /* ---------- Mapa del sitio ---------- */
  .footer-nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2xl);
    margin-bottom: var(--space-2xl);
  }
  .footer-grupo {
    min-width: 140px;
  }
  /* Rótulos de grupo: antetítulo versalita en Josefin Sans (rediseño). */
  .footer-rotulo {
    font-family: var(--font-meta);
    font-size: var(--fs-3xs);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-widest);
    text-transform: uppercase;
    color: var(--oro-texto);
    margin: 0 0 var(--space-sm);
  }
  .footer-lista {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
  }
  /* Enlaces en Cormorant caja mixta (como la maqueta). */
  .footer-lista a {
    font-family: var(--font-body);
    font-size: var(--fs-md);
    color: var(--text-soft);
    border-bottom: none;
  }
  .footer-lista a:hover,
  .footer-lista a:focus-visible {
    color: var(--oro-texto);
    border-bottom: none;
  }


  /* ---------- Cita y créditos ---------- */
  /* Itálica caja mixta, discreta: no debe pesar más que la nav. */
  .cita {
    font-family: var(--font-body);
    font-size: var(--fs-lg);
    font-style: italic;
    line-height: var(--lh-snug);
    color: var(--text);
    max-width: var(--measure-narrow);
    margin: 0 auto var(--space-xs);
  }
  /* Fuente de la cita: metadato versalita en Josefin Sans (rediseño). */
  .cita-fuente {
    font-family: var(--font-meta);
    font-size: var(--fs-xs);
    font-weight: 500;
    letter-spacing: var(--ls-widest);
    text-transform: uppercase;
    color: var(--oro-texto);
    margin: 0 auto var(--space-2xl);
  }
  .meta {
    font-family: var(--font-body);
    font-size: var(--fs-sm);
    color: var(--text-soft);
    margin: var(--space-xs) auto;
    max-width: var(--measure);
  }
  .meta a {
    color: var(--link);
  }

  @media (max-width: 540px) {
    .footer-nav {
      gap: var(--space-xl);
    }
  }
</style>