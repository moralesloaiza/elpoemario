---
import { SITE_TITLE } from '../consts';
import Logo from './Logo.astro';

const today = new Date();
const startYear = 2026;
const yearLabel =
  today.getFullYear() === startYear
    ? `${startYear}`
    : `${startYear}-${today.getFullYear()}`;

const grupos = [
  {
    rotulo: 'Explorar',
    enlaces: [
      { href: '/poemas/', texto: 'Poemas' },
      { href: '/autores/', texto: 'Autores' },
      { href: '/entradas/', texto: 'Bitácora' },
    ],
  },
  {
    rotulo: 'Descubrir',
    enlaces: [
      { href: '/tipos/', texto: 'Por forma' },
      { href: '/temas/', texto: 'Por tema' },
      { href: '/siglos/', texto: 'Por siglo' },
      { href: '/nacionalidades/', texto: 'Por país' },
    ],
  },
  {
    rotulo: 'La obra',
    enlaces: [
      { href: '/sobre/', texto: 'Acerca de' },
      { href: '/colaborar/', texto: 'Colaborar' },
      { href: '/correspondencia/', texto: 'Contacto' },
      { href: '/buscar/', texto: 'Buscar' },
    ],
  },
];
---

<footer>
  <div class="page footer-inner">
    <div class="footer-top">
      <a href="/" class="footer-brand" aria-label={`${SITE_TITLE} · inicio`}>
        <Logo tamano={30} />
        <span class="footer-wordmark">{SITE_TITLE}</span>
      </a>

      <nav class="footer-nav" aria-label="Mapa del sitio">
        {grupos.map((grupo, i) => (
          <div class="footer-grupo">
            <p class="footer-rotulo" id={`footer-grupo-${i}`}>{grupo.rotulo}</p>
            <ul class="footer-lista" aria-labelledby={`footer-grupo-${i}`}>
              {grupo.enlaces.map((enlace) => (
                <li><a href={enlace.href}>{enlace.texto}</a></li>
              ))}
            </ul>
          </div>
        ))}
      </nav>
    </div>

    <div class="divisor" aria-hidden="true"><span></span><span></span><span></span></div>

    <p class="cita" lang="la">
      Omne tulit punctum qui miscuit utile dulci
    </p>
    <p class="cita-fuente">
      Horacio · Ars Poetica, 343 · © {yearLabel} El Poemario
    </p>
  </div>
</footer>

<style>
  footer {
    margin-top: var(--space-2xl);
    padding-block: var(--space-2xl);
    background: var(--bg-soft);
    border-top: var(--rule-hairline) solid var(--oro);
    position: relative;
  }
  .footer-inner {
    text-align: center;
  }

  /* ---------- Fila superior: marca | mapa del sitio ---------- */
  .footer-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-2xl);
    margin-bottom: var(--space-2xl);
    text-align: left;
  }
  .footer-brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    text-decoration: none;
    color: var(--text);
    border-bottom: none;
    line-height: 0;
    flex-shrink: 0;
  }
  .footer-brand:hover,
  .footer-brand:focus-visible {
    border-bottom: none;
  }
  .footer-brand :global(.logo-mark) {
    display: block;
    width: 30px;
    height: 30px;
  }
  .footer-wordmark {
    font-family: var(--font-body);
    font-weight: 500;
    font-size: var(--fs-lg);
    letter-spacing: var(--ls-wide);
    line-height: 1;
    color: var(--text);
    white-space: nowrap;
  }

  /* ---------- Mapa del sitio ---------- */
  .footer-nav {
    display: flex;
    flex-wrap: wrap;
    text-align: left;
    gap: var(--space-2xl);
  }
  .footer-grupo {
    min-width: 120px;
  }
  /* Rótulos de grupo: antetítulo versalita en Cinzel. */
  .footer-rotulo {
    font-family: var(--font-meta);
    font-size: var(--fs-3xs);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-widest);
    text-transform: uppercase;
    color: var(--oro-texto);
    text-align: left;
    margin: 0 0 var(--space-sm);
  }
  .footer-lista {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    align-items: flex-start;
  }
  /* Enlaces en Cormorant caja mixta (como la maqueta). */
  .footer-lista a {
    font-family: var(--font-body);
    font-size: var(--fs-md);
    color: var(--text-soft);
    border-bottom: none;
  }
  .footer-lista a:hover,
  .footer-lista a:focus-visible {
    color: var(--oro-texto);
    border-bottom: none;
  }


  /* ---------- Cita y créditos ---------- */
  /* Itálica caja mixta, discreta: no debe pesar más que la nav. */
  .cita {
    font-family: var(--font-body);
    font-size: var(--fs-lg);
    font-style: italic;
    line-height: var(--lh-snug);
    color: var(--text);
    max-width: var(--measure-narrow);
    margin: 0 auto var(--space-xs);
  }
  /* Fuente de la cita + créditos, en una línea (handoff): metadato versalita
     Cinzel discreto en tinta tenue (no oro), para no competir con la cita. */
  .cita-fuente {
    font-family: var(--font-meta);
    font-size: var(--fs-3xs);
    font-weight: 500;
    letter-spacing: var(--ls-wider);
    text-transform: uppercase;
    color: var(--text-faint);
    margin: 0;
  }

  @media (max-width: 700px) {
    /* Móvil: marca sobre columnas, todo centrado en una columna. */
    .footer-top {
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: var(--space-xl);
    }
    .footer-nav {
      justify-content: center;
      gap: var(--space-xl);
    }
  }
</style>