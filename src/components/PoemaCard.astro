---
import type { CollectionEntry } from 'astro:content';
import { TIPOS_DISPLAY, MOVIMIENTOS_DISPLAY } from '../utils/taxonomia';

interface Props {
  poema: CollectionEntry<'poemas'>;
  autorNombre: string;
  mostrarAutor?: boolean;
}

const { poema, autorNombre, mostrarAutor = true } = Astro.props;
const { titulo, tipo, movimiento } = poema.data;

// Foot line: metric form, optionally followed by the historical-aesthetic
// movement. "Soneto · Modernismo", or just "Soneto" when no movement is set
// (110 of 121 poems carry one; the rest fall back to form alone).
const tipoLabel = TIPOS_DISPLAY[tipo];
const movimientoLabel = movimiento ? MOVIMIENTOS_DISPLAY[movimiento] : null;
const piePoema = movimientoLabel ? `${tipoLabel} · ${movimientoLabel}` : tipoLabel;
---

<article class="card">
  <h3 class="card-titulo">
    <a href={`/poemas/${poema.id}/`}>{titulo}</a>
  </h3>
  {mostrarAutor && <p class="card-autor">{autorNombre}</p>}
  <p class="card-pie">{piePoema}</p>
</article>

<style>
  /* Text cell in the grid (no image, no rules). The card is also the
     positioning context for the block-link ::before overlay. */
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    height: auto;
    min-height: 148px;
    padding: var(--space-lg) var(--space-md);
    transition: background-color var(--dur-fast) var(--ease-standard);
  }
  .card:has(.card-titulo a:hover),
  .card:has(.card-titulo a:focus-visible) {
    background-color: rgba(200, 168, 106, 0.05);
  }

  /* Title: clamped to 2 lines with reserved height, so a one-line title does
     not shrink its cell. The full title lives on the poem page. */
  .card-titulo {
    font-family: var(--font-display);
    font-size: var(--fs-lg);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-wide);
    line-height: var(--lh-snug);
    color: var(--text);
    text-transform: none;
    text-wrap: balance;
    margin: 0;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
    min-height: 2.6em;
  }

  /* Block-link: the <a> wraps only the title; its ::before overlay extends the
     clickable area across the whole cell. */
  .card-titulo a {
    text-decoration: none;
    color: inherit;
    border-bottom: none;
  }
  .card-titulo a::before {
    content: "";
    position: absolute;
    inset: 0;
  }
  .card:has(.card-titulo a:hover) .card-titulo,
  .card:has(.card-titulo a:focus-visible) .card-titulo {
    color: var(--oro-texto);
  }

  /* Author and foot rubric are anchored to the bottom of the cell: margin-top
     auto on the first of them pushes the pair down to a common baseline across
     columns, leaving the title at the top. */
  .card-autor {
    font-family: var(--font-body);
    font-style: italic;
    font-size: var(--fs-md);
    color: var(--oro-texto);
    margin: var(--space-md) 0 0;
    margin-top: auto;
  }
  .card-pie {
    font-family: var(--font-display);
    font-size: var(--fs-3xs);
    letter-spacing: var(--ls-wider);
    text-transform: uppercase;
    color: var(--text-muted);
    line-height: var(--lh-snug);
    margin: var(--space-sm) 0 0;
    /* Reserve two lines so a foot that wraps does not push the bottom-anchored
       author line up relative to single-line feet in the same row; meta then
       stays aligned across columns. Same 2-line reservation the title uses
       (2 x --lh-snug). Bottom-aligned to keep a common last-line baseline. */
    min-height: 2.6em;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
  }
  /* When the author line is suppressed (mostrarAutor=false, on the author
     page), the foot rubric becomes the bottom-anchored element instead. */
  .card-autor + .card-pie {
    margin-top: var(--space-sm);
  }
  .card > .card-pie:nth-child(2) {
    margin-top: auto;
  }
</style>
