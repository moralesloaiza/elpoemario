---
import type { CollectionEntry } from 'astro:content';
import FormattedDate from './FormattedDate.astro';
import OrnamentoTarjeta from './ornaments/OrnamentoTarjeta.astro';
import { TIPOS_DISPLAY } from '../utils/taxonomia';

interface Props {
  poema: CollectionEntry<'poemas'>;
  autorNombre: string;
  mostrarAutor?: boolean;
}

const { poema, autorNombre, mostrarAutor = true } = Astro.props;
const { titulo, ilustracion, fecha, tipo } = poema.data;

// Display label for the metric/strophic form. Used as a small uppercase
// rubric above the title — primary literary disambiguator in an anthology
// of mixed forms (soneto vs verso libre vs romance, etc.).
const tipoLabel = TIPOS_DISPLAY[tipo];
---

<article class="card">
  <figure class:list={['card-img', { 'con-ornamento': !ilustracion }]}>
    {ilustracion ? (
      <img
        src={ilustracion}
        alt=""
        loading="lazy"
        decoding="async"
        width="900"
        height="600"
      />
    ) : (
      <OrnamentoTarjeta />
    )}
  </figure>
  <div class="card-meta">
    <p class="card-tipo">{tipoLabel}</p>
    <h3 class="card-titulo">
      <a href={`/poemas/${poema.id}/`}>{titulo}</a>
    </h3>
    {mostrarAutor && <p class="card-autor">por {autorNombre}</p>}
    <p class="card-fecha">
      <FormattedDate date={fecha} />
    </p>
  </div>
</article>

<style>
  /* The card is the positioning context for the block-link pseudo-element. */
  .card {
    display: flex;
    flex-direction: column;
    position: relative;
  }

  /* Frame: aspect ratio shared by both image and ornament-only variants. */
  .card-img {
    aspect-ratio: 3 / 2;
    overflow: hidden;
    margin: 0 0 var(--space-md);
  }

  /* Ornament-only variant: double gold border, mirrors the .frame primitive. */
  .card-img.con-ornamento {
    position: relative;
    background: var(--bg-elevated);
    border: 1.5px solid var(--oro);
  }
  .card-img.con-ornamento::before {
    content: "";
    position: absolute;
    inset: 6px;
    border: var(--rule-hairline) solid var(--oro);
    pointer-events: none;
  }

  .card-img :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--dur-fast) var(--ease-standard);
  }
  .card-img :global(svg.ornamento) {
    display: block;
    width: 100%;
    height: 100%;
  }
  .card:has(.card-titulo a:hover) .card-img :global(img),
  .card:has(.card-titulo a:focus-visible) .card-img :global(img) {
    transform: scale(1.02);
  }

  /* Form rubric: small uppercase label above the title. Reads as the
     literary category (soneto, romance, verso libre). */
  .card-tipo {
    font-family: var(--font-display);
    font-size: var(--fs-3xs);
    letter-spacing: var(--ls-widest);
    text-transform: uppercase;
    color: var(--oro-texto);
    line-height: var(--lh-snug);
    margin: 0 0 var(--space-2xs);
  }

  .card-titulo {
    font-family: var(--font-display);
    font-size: var(--fs-lg);
    font-weight: var(--fw-bold);
    letter-spacing: var(--ls-wide);
    line-height: var(--lh-snug);
    margin: 0 0 var(--space-2xs);
    color: var(--text);
    text-transform: none;
  }

  /* Block-link: the <a> wraps only the title, but its ::before overlay
     extends the clickable area across the whole .card. */
  .card-titulo a {
    text-decoration: none;
    color: inherit;
    border-bottom: none;
  }
  .card-titulo a::before {
    content: "";
    position: absolute;
    inset: 0;
  }
  .card:has(.card-titulo a:hover) .card-titulo,
  .card:has(.card-titulo a:focus-visible) .card-titulo {
    color: var(--oro-texto);
  }

  .card-autor {
    font-family: var(--font-body);
    font-style: italic;
    font-size: var(--fs-sm);
    color: var(--text-soft);
    margin: 0;
  }
  .card-fecha {
    font-family: var(--font-display);
    font-size: var(--fs-3xs);
    letter-spacing: var(--ls-widest);
    color: var(--oro-texto);
    margin: var(--space-2xs) 0 0;
  }
</style>