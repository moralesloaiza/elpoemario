---
import type { CollectionEntry } from 'astro:content';

interface Props {
  autor: CollectionEntry<'autores'>;
  conteo: number;
}

const { autor, conteo } = Astro.props;
const { nombre, nacionalidad, nacimiento, muerte } = autor.data;

// Secondary line under the name: country and life dates joined by a middot.
//   both years  → "Chile · 1839–1900"
//   birth only  → "Chile · n. 1985"   (living author)
//   no dates    → "Chile"
//   no country  → dates alone, or suppressed entirely (e.g. Anónimo)
const anios =
  nacimiento && muerte
    ? `${nacimiento}–${muerte}`
    : nacimiento
      ? `n. ${nacimiento}`
      : null;
const subLinea = [nacionalidad, anios].filter(Boolean).join(' · ') || null;

// Published-poem count. "—" for zero (author exists but has no poems yet),
// singular/plural otherwise.
const conteoLabel =
  conteo === 0 ? '—' : conteo === 1 ? '1 poema' : `${conteo} poemas`;
---

<article class="card">
  <h3 class="card-nombre">
    <a href={`/autores/${autor.id}/`}>{nombre}</a>
  </h3>
  {subLinea && <p class="card-sub">{subLinea}</p>}
  <p class="card-conteo">{conteoLabel}</p>
</article>

<style>
  /* Mirrors PoemaCard: text cell in the grid, no image, no rules. Block-link
     ::before overlay makes the whole cell clickable. */
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    height: auto;
    min-height: 148px;
    padding: var(--space-lg) var(--space-md);
    transition: background-color var(--dur-fast) var(--ease-standard);
  }
  .card:has(.card-nombre a:hover),
  .card:has(.card-nombre a:focus-visible) {
    background-color: rgba(200, 168, 106, 0.05);
  }

  .card-nombre {
    font-family: var(--font-display);
    font-size: var(--fs-lg);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-wide);
    line-height: var(--lh-snug);
    color: var(--text);
    text-transform: none;
    text-wrap: balance;
    margin: 0;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
    min-height: 2.6em;
  }

  .card-nombre a {
    text-decoration: none;
    color: inherit;
    border-bottom: none;
  }
  .card-nombre a::before {
    content: "";
    position: absolute;
    inset: 0;
  }
  .card:has(.card-nombre a:hover) .card-nombre,
  .card:has(.card-nombre a:focus-visible) .card-nombre {
    color: var(--oro-texto);
  }

  /* Sub-line (country · years) and count anchored to the bottom of the cell. */
  .card-sub {
    font-family: var(--font-body);
    font-style: italic;
    font-size: var(--fs-md);
    color: var(--text-soft);
    margin: var(--space-md) 0 0;
    margin-top: auto;
  }
  .card-conteo {
    font-family: var(--font-display);
    font-size: var(--fs-3xs);
    letter-spacing: var(--ls-wider);
    text-transform: uppercase;
    color: var(--text-muted);
    line-height: var(--lh-snug);
    margin: var(--space-sm) 0 0;
    /* Reserve two lines of height so the count line keeps a stable box height
       and the bottom-anchored sub-line stays aligned across columns of the same
       row. Mirrors PoemaCard; same 2-line strategy the name uses. Bottom-aligned
       to keep a common baseline. */
    min-height: 2.6em;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
  }
  .card-sub + .card-conteo {
    margin-top: var(--space-sm);
  }
  .card > .card-conteo:nth-child(2) {
    margin-top: auto;
  }
</style>
