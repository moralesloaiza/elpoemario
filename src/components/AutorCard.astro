---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';

interface Props {
  autor: CollectionEntry<'autores'>;
  conteo: number;
}

const { autor, conteo } = Astro.props;
const { nombre, nacionalidad, nacimiento, muerte, imagen } = autor.data;

// Secondary line under the name: life dates and country joined by a middot.
//   both years  → "1839–1900 · Chile"
//   birth only  → "n. 1985 · Chile"   (living author)
//   no dates    → "Chile"
//   no country  → dates alone, or suppressed entirely (e.g. Anónimo)
const anios =
  nacimiento && muerte
    ? `${nacimiento}–${muerte}`
    : nacimiento
      ? `n. ${nacimiento}`
      : null;
const subLinea = [anios, nacionalidad].filter(Boolean).join(' · ') || null;

// Published-poem count. "—" for zero (author exists but has no poems yet),
// singular/plural otherwise.
const conteoLabel =
  conteo === 0 ? '—' : conteo === 1 ? '1 poema' : `${conteo} poemas`;

// Initial fallback for the portrait when an author has no image. Every author
// currently carries `imagen`, so this is a robustness guard, not a common path.
const inicial = nombre.trim().charAt(0).toUpperCase();
---

<article class="tile">
  <div class="tile-img" aria-hidden="true">
    {imagen ? (
      <Image
        src={imagen}
        alt=""
        widths={[212, 320, 480]}
        sizes="(max-width: 640px) 50vw, 280px"
        loading="lazy"
        decoding="async"
      />
    ) : (
      <span class="tile-inicial">{inicial}</span>
    )}
    <span class="tile-veil"></span>
  </div>

  <div class="tile-info">
    <h3 class="tile-nombre">
      <a href={`/autores/${autor.id}/`}>{nombre}</a>
    </h3>
    {subLinea && <p class="tile-sub">{subLinea}</p>}
    <p class="tile-conteo">{conteoLabel}</p>
  </div>
</article>

<style>
  /* Tile de autor a sangre (handoff «diseño nocturno», §1): retrato 3:4 con velo
     inferior y nombre/fechas/conteo sobrepuestos. El texto vive en el tramo bajo
     donde --card-veil es casi opaco (≈text-sobre-panel, no sobre-foto), así que
     su contraste está controlado sin rebarrido por imagen. Bloque-enlace: el <a>
     del nombre estira su ::before sobre TODO el tile, así que toda la tarjeta —
     retrato incluido — es cliqueable. Para que ese ::before se ancle al .tile y
     no al bloque de texto, .tile-info fluye (flex, sin position); el retrato pasa
     a z-index:-1 dentro del contexto aislado del tile para quedar bajo el texto. */
  .tile {
    position: relative;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    border: 1px solid var(--line);
    background: var(--mat);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    isolation: isolate;
  }

  .tile-img {
    position: absolute;
    inset: 0;
    z-index: -1;
  }
  .tile-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 18%;
    filter: var(--hero-img-filtro);
    transition: transform var(--dur-slow) var(--ease-standard);
  }
  .tile:has(.tile-nombre a:hover) .tile-img img,
  .tile:has(.tile-nombre a:focus-visible) .tile-img img {
    transform: scale(1.045);
  }
  /* Inicial de respaldo (autor sin retrato): mayúscula grande y tenue. */
  .tile-inicial {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display);
    font-size: clamp(5rem, 11vw, 8rem);
    color: var(--oro-texto);
    opacity: 0.42;
    line-height: 1;
  }
  .tile-veil {
    position: absolute;
    inset: 0;
    background: var(--card-veil);
    pointer-events: none;
  }

  /* Bloque de texto anclado abajo, sobre el velo. Colores vía --hero-* (siguen
     al tema): tinta clara sobre velo oscuro de noche, tinta sobre velo de papel
     de día. */
  .tile-info {
    padding: var(--space-md) var(--space-md) var(--space-md);
  }
  .tile-nombre {
    font-family: var(--font-display);
    font-weight: var(--fw-semibold);
    font-size: clamp(1.05rem, 0.9rem + 0.7vw, 1.28rem);
    line-height: var(--lh-snug);
    text-transform: uppercase;
    letter-spacing: var(--ls-wide);
    color: var(--hero-title);
    text-shadow: 0 1px 12px rgba(0, 0, 0, 0.35);
    margin: 0 0 var(--space-3xs);
    text-wrap: balance;
  }
  .tile-nombre a {
    text-decoration: none;
    color: inherit;
    border-bottom: none;
  }
  .tile-nombre a::before {
    content: '';
    position: absolute;
    inset: 0;
  }
  .tile:has(.tile-nombre a:hover) .tile-nombre,
  .tile:has(.tile-nombre a:focus-visible) .tile-nombre {
    color: var(--hero-accent);
  }

  .tile-sub {
    font-family: var(--font-body);
    font-style: italic;
    font-size: var(--fs-sm);
    color: var(--hero-ink-soft);
    margin: 0 0 var(--space-3xs);
  }
  .tile-conteo {
    font-family: var(--font-display);
    font-size: var(--fs-3xs);
    letter-spacing: var(--ls-wider);
    text-transform: uppercase;
    color: var(--hero-accent);
    line-height: var(--lh-snug);
    margin: 0;
  }
</style>
