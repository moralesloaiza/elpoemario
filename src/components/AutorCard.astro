---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';

interface Props {
  autor: CollectionEntry<'autores'>;
  conteo: number;
}

const { autor, conteo } = Astro.props;
const { nombre, nacionalidad, nacimiento, muerte, imagen } = autor.data;

// Secondary line under the name: life dates and country joined by a middot.
//   both years  → "1839–1900 · Chile"
//   birth only  → "n. 1985 · Chile"   (living author)
//   no dates    → "Chile"
//   no country  → dates alone, or suppressed entirely (e.g. Anónimo)
const anios =
  nacimiento && muerte
    ? `${nacimiento}–${muerte}`
    : nacimiento
      ? `n. ${nacimiento}`
      : null;
const subLinea = [anios, nacionalidad].filter(Boolean).join(' · ') || null;

// Published-poem count. "—" for zero (author exists but has no poems yet),
// singular/plural otherwise.
const conteoLabel =
  conteo === 0 ? '—' : conteo === 1 ? '1 poema' : `${conteo} poemas`;

// Initial fallback for the miniature when an author has no portrait. Every
// author currently carries `imagen`, so this is a robustness guard, not a
// common path.
const inicial = nombre.trim().charAt(0).toUpperCase();
---

<article class="card">
  <div class="card-mini" aria-hidden="true">
    {imagen ? (
      <Image
        src={imagen}
        alt=""
        width={148}
        loading="lazy"
        decoding="async"
      />
    ) : (
      <span class="card-inicial">{inicial}</span>
    )}
  </div>
  <div class="card-texto">
    <h3 class="card-nombre">
      <a href={`/autores/${autor.id}/`}>{nombre}</a>
    </h3>
    {subLinea && <p class="card-sub">{subLinea}</p>}
    <p class="card-conteo">{conteoLabel}</p>
  </div>
</article>

<style>
  /* Author row (handoff): square miniature + name / dates·country / count.
     Block-link ::before overlay makes the whole row clickable. The bottom
     rule separates rows within each grid column. */
  .card {
    position: relative;
    display: flex;
    gap: var(--space-md);
    align-items: center;
    padding: var(--space-lg) var(--space-2xs);
    border-bottom: 1px solid var(--rule-soft);
    transition: background-color var(--dur-fast) var(--ease-standard);
  }
  .card:has(.card-nombre a:hover),
  .card:has(.card-nombre a:focus-visible) {
    background-color: var(--hover-tint);
  }

  /* Passe-partout miniature: --mat backing + --rule border, no radius. */
  .card-mini {
    flex: none;
    width: 74px;
    height: 74px;
    border: 1px solid var(--rule);
    background: var(--mat);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .card-mini img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
  }
  .card-inicial {
    font-family: var(--font-display);
    font-size: var(--fs-xl);
    color: var(--oro-texto);
    line-height: 1;
  }

  .card-texto {
    flex: 1;
    min-width: 0;
  }
  .card-nombre {
    font-family: var(--font-display);
    font-size: var(--fs-lg);
    font-weight: 500;
    line-height: var(--lh-snug);
    color: var(--text);
    text-transform: none;
    letter-spacing: 0;
    margin: 0 0 var(--space-3xs);
    text-wrap: balance;
  }
  .card-nombre a {
    text-decoration: none;
    color: inherit;
    border-bottom: none;
  }
  .card-nombre a::before {
    content: "";
    position: absolute;
    inset: 0;
  }
  .card:has(.card-nombre a:hover) .card-nombre,
  .card:has(.card-nombre a:focus-visible) .card-nombre {
    color: var(--oro-texto);
  }

  .card-sub {
    font-family: var(--font-body);
    font-style: italic;
    font-size: var(--fs-sm);
    color: var(--text-soft);
    margin: 0 0 var(--space-2xs);
  }
  .card-conteo {
    font-family: var(--font-display);
    font-size: var(--fs-3xs);
    letter-spacing: var(--ls-wider);
    text-transform: uppercase;
    color: var(--oro-texto);
    line-height: var(--lh-snug);
    margin: 0;
  }
</style>
